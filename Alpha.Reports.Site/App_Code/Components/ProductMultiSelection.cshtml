@using Resources;
@using Alpha.Reports.Site.ViewModels.Components;

@helper Render(ProductMultiSelectionViewModel model)
{
    <div class="form-group">
        <select id="dropdown-product"
                name="UserSelectedProductIds"
                data-has-any-product="@model.Products.Any()"
                data-labelselectproducts="@Resources.SelectProducts"
                data-labelselected="@Resources.Selected"
                data-labelallproducts="@Resources.AllProducts"
                data-labelthereisnoproduct="@Resources.ThereIsNoProduct"
                data-language="@model.Language"
                multiple="multiple" class="select-multiple">
            @foreach (var product in model.Products)
            {
                <option value="@product.Value"
                        @(product.Selected ? " selected=\"selected\"" : string.Empty)>
                    @product.Text
                </option>
            }
        </select>
    </div>
}