@using Alpha.Reports.Extensions;
@using Alpha.Reports.Site.AppResources;
@using Alpha.Reports.Site.ViewModels.Components;

@helper Render(DateRangePickerViewModel model)
{
    <div class="form-group nexDatePicker">
        <div class="currentreport-item">
            <div id="daterange-picker"
                 data-labelto="@SiteResources.To"
                 data-labeltoday="@SiteResources.Today"
                 data-labelyesterday="@SiteResources.Yesterday"
                 data-labelthisweek="@SiteResources.ThisWeek"
                 data-labellastweek="@SiteResources.LastWeek"
                 data-labelthismonth="@SiteResources.ThisMonth"
                 data-labellastmonth="@SiteResources.LastMonth"
                 data-labelsincelastmonth="@SiteResources.SinceLastMonth"
                 data-labelspecificdate="@SiteResources.SpecificDate"
                 data-mindate="@model.MinDate.ToShortDateWithSlash()"
                 data-maxdate="@model.MaxDate.ToShortDateWithSlash()"
                 data-currentdate="@DateTime.Now"
                 data-fromdate="@model.FromDate.ToShortDateWithSlash()"
                 data-todate="@model.ToDate.ToShortDateWithSlash()"
                 data-selecteddaterange="@model.UserSelectedDateRangeOption"></div>
        </div>
    </div>
}