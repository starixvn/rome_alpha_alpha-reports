@using Alpha.Reports.Extensions;
@using Alpha.Reports.Site.ViewModels.Components;
@using Alpha.Reports.AppResources;

@helper Render(DateRangePickerViewModel model)
{
    <div id="daterange-picker"
         class="form-group daterange-picker"
         data-currentdate="@DateTime.Now"
         data-mindate="@model.MinDate.ToShortDateWithSlash()"
         data-maxdate="@model.MaxDate.ToShortDateWithSlash()">
        <div class="ui_nexdatepicker_edit_field daterange-container">
            <select id="dropdown-daterange"
                    name="UserSelectedDateRangeOption"
                    class="dropdown-daterange">
                @foreach (var rangeOption in model.RangeOptions)
                {
                    <option value="@rangeOption.Value" @(rangeOption.Selected ? " selected=\"selected\"" : string.Empty)>@rangeOption.Text</option>
                }
            </select>
        </div>

        <div id="from-date-container"
             class="input-group date ui_nexdatepicker_edit_field css fromdate">
            <input type="text"
                   id="from-date"
                   name="FromDate"
                   readonly="readonly"
                   class="ui_nexdatepicker_datetextbox ui_nexdatepicker_fromdate form-control"
                   value="@model.FromDate.ToShortDateWithSlash()" />
            <span class="input-group-addon">
                <span class="icon-calendar"></span>
            </span>
        </div>
        <div class="ui_nexdatepicker_lbl_field separator">-</div>
        <div id="to-date-container"
             class="input-group date ui_nexdatepicker_edit_field  todate">
            <input type="text"
                   id="to-date"
                   name="ToDate"
                   readonly="readonly"
                   class="ui_nexdatepicker_datetextbox ui_nexdatepicker_todate form-control"
                   value="@model.ToDate.ToShortDateWithSlash()" />
            <span class="input-group-addon">
                <span class="icon-calendar"></span>
            </span>
        </div>
    </div>
}