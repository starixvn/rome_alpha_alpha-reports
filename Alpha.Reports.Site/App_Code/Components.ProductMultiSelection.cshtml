@using Alpha.Reports.AppResources;
@using Alpha.Reports.Models;

@helper Render(
    IEnumerable<Product> userProducts,
    string jsonUserProducts,
    List<int> userSelectedProductIds,
    string language)
{
    <div class="form-group">
        <label class="txt">@Resources.Product</label>
        <select id="dropdown-product"
                data-products="@jsonUserProducts"
                data-labelselectproducts="@Resources.SelectProducts"
                data-labelselected="@Resources.Selected"
                data-labelallproducts="@Resources.AllProducts"
                data-labelthereisnoproduct="@Resources.ThereIsNoProduct"
                data-language="@language"
                multiple="multiple" class="select-multiple">
            @foreach (var product in userProducts)
            {
                <option id="product_@product.Id" value="@product.Id"
                        @(userSelectedProductIds.IndexOf(product.Id) != -1 ? " selected=\"selected\"" : string.Empty)>
                    @product.DisplayName
                </option>
            }
        </select>
    </div>
}