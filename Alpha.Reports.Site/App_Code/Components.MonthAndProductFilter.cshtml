@using Alpha.Reports.AppResources;
@using System.Web.Mvc;
@using Alpha.Reports.Models;

@functions {
    public static WebViewPage page = (PageContext.Page as WebViewPage);
    public static HtmlHelper<object> html = page.Html;
}

@helper Render(
    bool hideFilter,
    DateTime minDate,
    DateTime fromDate,
    DateTime toDate,
    IEnumerable<Product> userProducts,
    string jsonUserProducts,
    List<int> userSelectedProductIds,
    string language)
{
    <form class="form-inline filter" role="form" id="filter" data-ishide="@(hideFilter ? "1" : "0")">
        @Components_MonthPicker.Render(minDate, fromDate, toDate)
        @Components_ProductMultiSelection.Render(userProducts, jsonUserProducts, userSelectedProductIds, language)
        <div class="form-group">
            <input type="button" value="@Resources.Submit" class="btn-submit" />
        </div>
        <div class="form-group">
            <span class="icon-excel" title="@Resources.ExportToExcel"></span>
        </div>

        <div class="note">
            <span class="star">*</span>@html.Raw(string.Format(Resources.Warning_CanOnlyViewDataAfterTime_BackToCurrentReport, minDate))
        </div>
    </form>
}
