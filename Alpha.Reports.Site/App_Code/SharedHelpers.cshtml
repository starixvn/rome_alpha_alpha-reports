@helper FormatNumber(decimal value)
{
    @value.ToString($"#,##0.##")
}

@helper FormatNumber(int value)
{
    @value.ToString($"#,##0")
}

@helper RenderStackColumn(IEnumerable<decimal> columns, string css, int colspan)
{
    <td class="@css" colspan="@colspan">
        <ul>
            @foreach (var column in columns)
            {
                <li>@FormatNumber(column)</li>
            }
        </ul>
    </td>
}