@using ModuleSettings = Sunplus.Agent.Model.BL.Definitions;

@if (ModuleSettings.AppSettings.PiwikEnable)
{
    <script type="text/javascript">
        var _paq = [];
        _paq.push(['trackPageView']);
        _paq.push(['enableLinkTracking']);
        _paq.push(['setTrackerUrl', '@ModuleSettings.AppSettings.PiwikUrl']);
        _paq.push(['setSiteId', '@ModuleSettings.AppSettings.PiwikSiteId']);

        setTimeout(function () {
            var d = document, g = d.createElement('script');
            g.type = 'text/javascript'; g.async = true; g.defer = true; g.src = "@ModuleSettings.AppSettings.PiwikScript"; d.body.appendChild(g);
        }, 500);
    </script>
    <noscript>
        <p>
            <img src="@ModuleSettings.AppSettings.PiwikUrl?idsite=@ModuleSettings.AppSettings.PiwikSiteId" alt="" class="piwik-noscript" />
        </p>
    </noscript>
}
