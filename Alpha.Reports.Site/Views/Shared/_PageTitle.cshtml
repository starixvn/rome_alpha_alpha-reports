@model PageHeaderViewModel

<div class="page-title
     @(Model.IsStackMode ? "stack-mode" : string.Empty)
     @(Model.HideFilter ? "hide-filter" : string.Empty)">
    <span class="pull-left">@Model.Title</span>
    <div class="breadcrumb-container">
        <ul class="breadcrumb">
            <li><a href="#">Dam</a></li>
            <li><a href="#">Dam11</a></li>
            <li>Dam1122</li>
        </ul>
    </div>
    
    <div class="list-icon">
        <ul>
            @if (Model.HasHideFilterIcon)
            {
                <li class="showfilter-element"><span class="icon-arrow-up-drop-circle icon-filter" title="@Resources.HideFilter"></span></li>
                <li class="hidefilter-element"><span class="icon-arrow-down-drop-circle icon-filter" title="@Resources.ShowFilter"></span></li>
            }

            @if (Model.HasStackIcon)
            {
                <li class="normalview-element"><span id="icon-stack-column" class="icon-stack-column icon-switchmode" title="@Resources.Tip_ShowReportInStackColumnView"></span></li>
                <li class="stackcolumnview-element"><span id="icon-normal-column" class="icon-normal-column icon-switchmode" title="@Resources.Tip_ShowReportInNormalView"></span></li>
            }
        </ul>
    </div>
</div>
