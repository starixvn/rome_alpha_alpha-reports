@model PageHeaderViewModel

<div class="page-title
     @(Model.IsStackMode ? "stack-mode" : string.Empty)
     @(Model.HideFilter ? "hide-filter" : string.Empty)">
    <span class="pull-left">@Model.Title</span>
    <div class="list-icon">
        <ul>
            @if (Model.HasHideFilterIcon)
            {
                <li class="showfilter-element"><span class="icon-arrow-up-drop-circle icon-filter" title="@SiteResources.HideFilter"></span></li>
                <li class="hidefilter-element"><span class="icon-arrow-down-drop-circle icon-filter" title="@SiteResources.ShowFilter"></span></li>
            }

            @if (Model.HasStackIcon)
            {
                <li class="normalview-element"><span class="icon-stack-column icon-switchmode" title="@SiteResources.Tip_ShowReportInStackColumnView"></span></li>
                <li class="stackcolumnview-element"><span class="icon-normal-column icon-switchmode" title="@SiteResources.Tip_ShowReportInNormalView"></span></li>
            }
        </ul>
    </div>
</div>
