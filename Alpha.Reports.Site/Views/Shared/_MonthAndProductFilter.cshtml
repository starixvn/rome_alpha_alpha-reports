@model MonthAndProductFilterViewModel

<form class="form-inline filter" role="form" id="filter" data-ishide="@(Model.HideFilter ? "1" : "0")">
    @Html.Partial("MonthPicker", Model.MonthPicker)
    @Html.Partial("ProductMultiSelection", Model.ProductMultiSelection)
    <div class="form-group">
        <input type="button" value="@Resources.Submit" class="btn-submit" />
    </div>
    <div class="form-group">
        <span class="icon-excel" title="@Resources.ExportToExcel"></span>
    </div>

    <div class="note">
        <span class="star">*</span>@Html.Raw(string.Format(Resources.Warning_CanOnlyViewDataAfterTime_BackToCurrentReport, Model.MinDate))
    </div>
</form>

