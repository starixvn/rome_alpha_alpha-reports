@model ProductMultiSelectionViewModel

<div class="form-group">
    <label class="txt">@SiteResources.Product</label>
    <select id="dropdown-product"
            data-total-product="@Model.Products.Count()"
            data-labelselectproducts="@SiteResources.SelectProducts"
            data-labelselected="@SiteResources.Selected"
            data-labelallproducts="@SiteResources.AllProducts"
            data-labelthereisnoproduct="@SiteResources.ThereIsNoProduct"
            data-language="@Model.Language"
            multiple="multiple" class="select-multiple">
        @foreach (var product in Model.Products)
            {
            <option id="product_@product.Value"
                    value="@product.Value"
                    @(product.Selected ? " selected=\"selected\"" : string.Empty)>
                @product.Text
            </option>
        }
    </select>
</div>