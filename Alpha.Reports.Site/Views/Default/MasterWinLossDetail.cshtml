    <script>
        $(function () {

            $('#fromDateContainer').datetimepicker({
                allowInputToggle: true,
                format: 'MM/DD/YYYY'
            });

            $('#toDateContainer').datetimepicker({
                allowInputToggle: true,
                format: 'MM/DD/YYYY'
            });

            var iconFilter = $('#icon-filter'),
                filter = $('#filter');
            iconFilter.on('click', function () {
                if (filter.is(":hidden")) {
                    iconFilter.attr('title', 'Hide filter').removeClass('icon-arrow-down-drop-circle').addClass('icon-arrow-up-drop-circle');
                    filter.slideDown('fast');
                }
                else {
                    iconFilter.attr('title', 'Show filter').removeClass('icon-arrow-up-drop-circle').addClass('icon-arrow-down-drop-circle');
                    filter.slideUp('fast');
                }
            });

            var iconChangeFilter = $('#icon-changeview'),
                tblReport = $('#tbl-report');

            var isFirstClick = true;

            iconChangeFilter.on('click', function () {
                if (tblReport.hasClass('stack-mode')) {
                    tblReport.removeClass('stack-mode');
                    iconChangeFilter.attr('title', 'Show report in stack column view').removeClass('icon-normal_column').addClass('icon-Stack_column');
                } else {
                    tblReport.addClass('stack-mode');
                    if (isFirstClick) {
                        var colTurnover = $('td.col-turnover'),
                            colWinLoss = $('td.col-winloss');

                        colTurnover.each(function (index) {
                            var $this = $(this);

                            var html = '<td class="text-right visible-stack-mode">\
                                            <ul>\
                                                <li>' + $this.html() + '</li>\
                                                <li>' + $this.next().html() + '</li>\
                                                <li>' + $this.next().next().html() + '</li>\
                                            </ul>\
                                        </td>';

                            $this.next().next().after(html);
                        });

                        colWinLoss.each(function (index) {
                            var $this = $(this),
                                highlightColumn = '';
                            if ($this.hasClass('altercol')) {
                                highlightColumn = 'altercol';
                            }

                            var html = '<td colspan="3" class="text-right ' + highlightColumn + ' visible-stack-mode">\
                                            <ul>\
                                                <li>' + $this.html() + '</li>\
                                                <li>' + $this.next().html() + '</li>\
                                                <li class="bold">' + $this.next().next().html() + '</li>\
                                            </ul>\
                                        </td>';

                            $this.next().next().after(html);
                        });

                        isFirstClick = false;
                    }

                    iconChangeFilter.attr('title', 'Show report in normal view').removeClass('icon-Stack_column').addClass('icon-normal_column');
                }
            });

            var currentWindowWidth = window.screen.width;

            if (currentWindowWidth < 768) {
                var btn = $('.btn');
                btn.on('click', function () {
                    iconFilter.attr('title', 'Show filter');
                    filter.slideUp('fast');
                });
            }
        })
    </script>
