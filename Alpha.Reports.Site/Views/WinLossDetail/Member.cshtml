@using Alpha.Reports.Site.Helpers;
@using Alpha.Reports.Models.WinlossDetail;
@using Alpha.Reports.Site.ViewModels.WinLossDetail;
@using Alpha.Reports.Site.Configurations;
@using Components

@model  WinLossDetailViewModel<MemberWinLossDetail>
@{
    ViewBag.BetListPath = $"../../{AppPathHelper.GetAppPath(SiteSettings.OldMainAppPath, "~")}/_BetList/BetListForSiteReport.aspx";
}

@Html.Partial("_NetTurnoverTooltips", Model.NetTurnoverTooltips)
@Html.Partial("_PageTitle", new PageHeaderViewModel(Resources.MemberWinLossDetail, true, true, Model.IsStackMode, Model.IsFilterVisible))
@Html.Partial("Filter", Model.FilterViewModel,
    new ViewDataDictionary
    {
        { "IsStackMode", Model.IsStackMode },
        { "IsDescendingSort", Model.IsDescendingSort },
        { "SortPropertyName", Model.SortPropertyName },
        { "CurrentPageIndex", Model.ReportData.CurrentPageIndex },
        { "PageSize", Model.ReportData.PageSize }
    })

<table class="tblRpt tblRpt-bordered tblRpt-striped tblRpt-hover width-100per
       @(Model.IsStackMode ? "stack-mode" : string.Empty)" id="tbl-report"
       data-totalrecords="@Model.ReportData.TotalRecords"
       data-custid="@Model.CustId"
       data-sortedcolumn="@Model.SortPropertyName"
       data-descendingsort="@Model.IsDescendingSort">
    <thead>
        <tr>
            <th rowspan="2" data-sortedname="CustName">@Resources.Username</th>
            <th rowspan="2" data-sortedname="NumberOfTickets">@Resources.NoOfTickets</th>
            <th rowspan="2" class="hidden-stack-mode" data-sortedname="Turnover">@Resources.Turnover</th>
            <th rowspan="2" class="hidden-stack-mode col-netturnover-header" data-sortedname="NetTurnover">@Resources.NetTurnover</th>
            <th rowspan="2" class="hidden-stack-mode" data-sortedname="GrossComm">@Resources.GrossComm</th>
            <th rowspan="2" class="visible-stack-mode col-combine" data-sortedname="Turnover">@Html.Raw(Resources.TO_NetTO_GrossComm)</th>
            <th colspan="3" class="col-level">@Resources.Member</th>
            <th colspan="3" class="col-level">@Resources.Agent</th>
            <th rowspan="2" data-sortedname="Company">@Resources.Company</th>
        </tr>
        <tr class="thead-row2">
            <th class="hidden-stack-mode col-winloss" data-sortedname="MemberWinLoss">@Resources.WinLoss</th>
            <th class="hidden-stack-mode" data-sortedname="MemberComm">@Resources.Comm</th>
            <th class="hidden-stack-mode" data-sortedname="MemberTotal">@Resources.Total</th>
            <th colspan="3" class="visible-stack-mode col-combine" data-sortedname="MemberWinLoss">@Html.Raw(Resources.WL_Comm_Total)</th>
            <th class="hidden-stack-mode col-winloss" data-sortedname="AgentWinLoss">@Resources.WinLoss</th>
            <th class="hidden-stack-mode" data-sortedname="AgentComm">@Resources.Comm</th>
            <th class="hidden-stack-mode" data-sortedname="AgentTotal">@Resources.Total</th>
            <th colspan="3" class="visible-stack-mode col-combine" data-sortedname="AgentWinLoss">@Html.Raw(Resources.WL_Comm_Total)</th>
        </tr>
    </thead>
    @if (Model.ReportData.Any())
    {
        <tbody>
            @foreach (var data in Model.ReportData.DataSource.OrderBy(Model.SortPropertyName, Model.IsDescendingSort))
            {
                @RenderRow(data, false)
            }
        </tbody>
        <tfoot>
            @RenderRow(Model.ReportData.TotalData, true)
        </tfoot>
    }
    else
    {
        @NoInformation.Render(colspan: 12)
    }
</table>

@Pager.Render(Model.PagerViewModel)

@section Scripts {
    @ReportsScripts.Render("~/assets/bundles/winlossdetail/winlossdetail")
}

@helper RenderRow(MemberWinLossDetail data, bool isTotalRow)
{
    <tr class="@(isTotalRow ? "tbl-footer" : string.Empty)">
        <td>
            @if (isTotalRow)
            {
                @Resources.Total
            }
            else
            {
                @Html.ActionLink(
                    linkText: data.CustName,
                    actionName: (string)ViewBag.BetListPath,
                    controllerName: string.Empty,
                    routeValues: new
                    {
                        Custid = data.CustId,
                        CustName = data.CustName,
                        FromDate = Model.FromDate,
                        ToDate = Model.ToDate,
                        SelectedProducts = string.Join(",", Model.Products.Where(product => product.Selected).Select(product => product.Value)),
                    },
                    htmlAttributes: null)
            }
        </td>
        <td class="text-right">@HtmlHelpers.FormatNumber(data.NumberOfTickets)</td>
        @if (Model.IsStackMode)
        {
            @HtmlHelpers.RenderStackCell("col-turnover-combined", 1, data.Turnover, data.NetTurnover, data.GrossComm);
            @HtmlHelpers.RenderStackCell("col-memberwinloss-combined", 3, data.MemberWinLoss, data.MemberComm, data.MemberTotal);
            @HtmlHelpers.RenderStackCell("col-agentwinloss-combined altercol ", 3, data.AgentWinLoss, data.AgentComm, data.AgentTotal);
        }
        else
        {
            @HtmlHelpers.RenderNumberCell(data.Turnover, "col-turnover")
            @HtmlHelpers.RenderNumberCell(data.NetTurnover)
            @HtmlHelpers.RenderNumberCell(data.GrossComm)

            @HtmlHelpers.RenderNumberCell(data.MemberWinLoss, "col-memberwinloss")
            @HtmlHelpers.RenderNumberCell(data.MemberComm)
            @HtmlHelpers.RenderNumberCell(data.MemberTotal, "bold")

            @HtmlHelpers.RenderNumberCell(data.AgentWinLoss, "col-agentwinloss altercol")
            @HtmlHelpers.RenderNumberCell(data.AgentComm, "altercol")
            @HtmlHelpers.RenderNumberCell(data.AgentTotal, "bold altercol")
        }
        <td class="text-right">@HtmlHelpers.FormatNumber(data.Company)</td>
    </tr>
}
