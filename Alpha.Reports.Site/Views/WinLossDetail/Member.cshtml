@using Alpha.Reports.Site.ViewModels.WinLossDetail;
@using Alpha.Reports.Site.Helpers;
@model MemberWinLossDetailViewModel
@{
    ViewBag.Title = Resources.MemberWinLossDetail;
    var total = Model.ReportData.Total;
}

@section Styles {
    @AssetStyles.Render("/bundles/site-reports/default")
    @ReportsStyles.Render("~/assets/bundles/default")
}

@Html.Partial("NetTurnoverTooltips", Model.NetTurnoverTooltips)
@Html.Partial("PageTitle", Model)
@Html.Partial("Filter", Model)
@Html.Partial("TableReport", new
{
    Model.ReportData,
    Model.IsStackMode,
    Model.CustId,
    Model.FromDate,
    Model.ToDate,
    Model.SortedColumn,
    Model.SortDirection,
    Model.OldMainAppPath,
    HasData = Model.ReportData.DataSource.Any()
})
@Html.Partial("Pager", Model.ReportData.DataSource.Any())

@Html.Partial("~/Views/Shared/MonthNames.cshtml")
@Html.Hidden("ishistoricreport", Model.IsHistoricReport)
@Html.Hidden("currentpath", AppPathHelper.GetAppPath(HttpContext.Current.Request.ApplicationPath, "~/WinLossDetail/Member"))

@section Scripts {
    @AssetScripts.Render("/bundles/site-reports/default")
    @ReportsScripts.Render("~/assets/bundles/winlossdetail/winlossdetail")
}
