@model  dynamic
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var productMultiSelection = new ProductMultiSelectionViewModel(Model.Products, Model.Language);
}

@Html.Partial("_NetTurnoverTooltips", (IEnumerable<string>)Model.NetTurnoverTooltips)
@Html.Partial("_PageTitle", new PageTitleViewModel(ViewBag.Title, true, true, Model.IsStackMode, Model.HideFilter))

@if (Model.IsHistoricReport)
{
    var monthPicker = new MonthPickerViewModel(Model.MinDate, Model.FromDate, Model.ToDate);
    @Html.Partial(
        "_MonthAndProductFilter",
        new MonthAndProductFilterViewModel(Model.HideFilter, Model.MinDate, monthPicker, productMultiSelection))
}
else
{
    var dateRangePicker = new DateRangePickerViewModel(
          Model.MinDate,
          Model.MaxDate,
          Model.FromDate,
          Model.ToDate,
          Model.UserSelectedDateRangeOption);

    @Html.Partial(
        "_DateRangeAndProductFilter",
        new DateRangeAndProductFilterViewModel(Model.HideFilter, Model.MinDate, dateRangePicker, productMultiSelection))
}

<table class="tblRpt tblRpt-bordered tblRpt-striped tblRpt-hover width-100per
       @(Model.IsStackMode?"stack-mode":string.Empty)" id="tbl-report"
       data-pageindex="@Model.ReportData.CurrentPageIndex"
       data-pagesize="@Model.ReportData.PageSize"
       data-totalrecords="@Model.ReportData.TotalRecords"
       data-custid="@Model.CustId"
       data-fromdate="@Model.FromDate"
       data-todate="@Model.ToDate"
       data-sortedcolumn="@Model.SortPropertyName"
       data-descendingsort="@Model.IsDescendingSort">
    @RenderSection("ReportData", required: true)
</table>

@if (ViewBag.HasData)
{
    @Html.Partial("_Pager")
}

@Html.Partial("_MonthNames")
@Html.Hidden("ishistoricreport", (Model.IsHistoricReport ? 1 : 0))
@Html.Hidden("currentpath", (string)ViewBag.CurrentPath)

@Html.Hidden("hidefilter", (Model.HideFilter ? 1 : 0))
@Html.Hidden("isstackmode", (Model.IsStackMode ? 1 : 0))

@section Scripts {
    @ReportsScripts.Render("~/assets/bundles/winlossdetail/winlossdetail")
}
