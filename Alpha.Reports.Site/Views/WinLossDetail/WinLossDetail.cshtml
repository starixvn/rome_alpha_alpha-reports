@using Components
@model  dynamic
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@Html.Partial("_NetTurnoverTooltips", (IEnumerable<string>)Model.NetTurnoverTooltips)
@Html.Partial("_PageTitle", new PageHeaderViewModel(ViewBag.Title, true, true, Model.IsStackMode, Model.HideFilter))

<form class="form-inline filter" role="form" id="report-form">
    @RenderHiddenFields()

    @(Model.IsHistoricReport
        ? MonthPicker.Render(Model.MonthPicker)
        : DateRangePicker.Render(Model.DateRangePicker))

    @ProductMultiSelection.Render(Model.ProductMultiSelection)

    <div class="form-group">
        <input type="submit" value="@SiteResources.Submit" class="btn-submit" />
    </div>

    <div class="form-group">
        <span class="icon-excel" title="@SiteResources.ExportToExcel"></span>
    </div>

    <div class="note">
        <span class="star">*</span>
        @Html.Raw(
            string.Format(Model.IsHistoricReport
               ? SiteResources.Warning_CanOnlyViewDataAfterTime_BackToCurrentReport
               : SiteResources.Warning_CanOnlyViewDataAfterTime_ClickToViewHistoricReport,
            Model.MinDate))
    </div>

</form>

<table class="tblRpt tblRpt-bordered tblRpt-striped tblRpt-hover width-100per
       @(Model.IsStackMode ? "stack-mode" : string.Empty)" id="tbl-report"
       data-pageindex="@Model.ReportData.CurrentPageIndex"
       data-pagesize="@Model.ReportData.PageSize"
       data-totalrecords="@Model.ReportData.TotalRecords"
       data-custid="@Model.CustId"
       data-fromdate="@Model.FromDate"
       data-todate="@Model.ToDate"
       data-sortedcolumn="@Model.SortPropertyName"
       data-descendingsort="@Model.IsDescendingSort">
    @RenderSection("ReportData", required: true)
</table>

@Pager.Render(Model.Pager)

@section Scripts {
    @ReportsScripts.Render("~/assets/bundles/winlossdetail/winlossdetail")
}

@helper RenderHiddenFields()
{
    @Html.Hidden("HideFilter", Model.HideFilter as bool?)
    @Html.Hidden("IsHistoricReport", Model.IsHistoricReport as bool?)
    @Html.Hidden("IsStackMode", Model.IsStackMode as bool?)
    @Html.Hidden("IsDescendingSort", Model.IsDescendingSort as bool?)
    @Html.Hidden("SortPropertyName", Model.SortPropertyName as string)
    @Html.Hidden("PageIndex", Model.ReportData.CurrentPageIndex as int?)
    @Html.Hidden("PageSize", Model.ReportData.PageSize as int?)
    @Html.Hidden("FromDate", (Model.FromDate as DateTime?).ToString())
    @Html.Hidden("ToDate", (Model.ToDate as DateTime?).ToString())
    @Html.Hidden("UserSelectedProductIds", Model.UserSelectedProductIds as string)
    @Html.Hidden("UserSelectedDateRangeOption", Model.UserSelectedDateRangeOption as int?)
    if (!Model.IsDirectReportViewAction)
    {
            @Html.Hidden("CustId", Model.CustId as int?)
    }
}
