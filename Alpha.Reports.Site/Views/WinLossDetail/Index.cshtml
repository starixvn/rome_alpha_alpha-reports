﻿@using Alpha.Reports.Site.Helpers
@using Alpha.Reports.Site.Configurations

@model WinLossDetailViewModel

@{
    string betListPath = $"../../{AppPathHelper.GetAppPath(SiteSettings.OldMainAppPath, "~/")}_BetList/BetList.aspx";
}

@Html.Partial("_NetTurnoverTooltips", Model.NetTurnoverTooltips)
@Html.Partial("_PageTitle", new PageHeaderViewModel(Model.Title, true, true, Model.IsStackMode, Model.IsFilterVisible))
@Html.Partial("Filter", Model.FilterViewModel,
    new ViewDataDictionary
    {
        { "IsStackMode", Model.IsStackMode },
        { "IsDescendingSort", Model.IsDescendingSort },
        { "SortPropertyName", Model.SortPropertyName },
        { "CurrentPageIndex", Model.ReportData.CurrentPageIndex },
        { "PageSize", Model.ReportData.PageSize }
    })

<table class="tblRpt tblRpt-bordered tblRpt-striped tblRpt-hover width-100per
       @(Model.IsStackMode ? "stack-mode" : string.Empty)" id="tbl-report"
       data-totalrecords="@Model.ReportData.TotalRecords"
       data-custid="@Model.CustId"
       data-sortedcolumn="@Model.SortPropertyName"
       data-descendingsort="@Model.IsDescendingSort">
    <thead>
        <tr>
            <th rowspan="2" data-sortedname="CustName">@Resources.Username</th>
            <th rowspan="2" data-sortedname="NumberOfTickets">@Resources.NoOfTickets</th>
            <th rowspan="2" class="hidden-stack-mode" data-sortedname="Turnover">@Resources.Turnover</th>
            <th rowspan="2" class="hidden-stack-mode col-netturnover-header" data-sortedname="NetTurnover">@Resources.NetTurnover</th>
            <th rowspan="2" class="hidden-stack-mode" data-sortedname="GrossComm">@Resources.GrossComm</th>
            <th rowspan="2" class="visible-stack-mode col-combine" data-sortedname="Turnover">
                <span class="prior-sortedcolumn">@Resources.TurnoverAbbr</span>@Resources.NetTurnoverAndGrossComm
            </th>

            <th colspan="3" class="col-level">@Resources.Member</th>

            <th colspan="3" class="col-level">@Resources.Agent</th>

            @if (Model.ReportLevel.IsMasterLevel()
                || Model.ReportLevel.IsSuperLevel())
            {
                <th colspan="3" class="col-level">@Resources.Master</th>
            }

            @if (Model.ReportLevel.IsSuperLevel())
            {
                <th colspan="3" class="col-level">@Resources.Super</th>
            }

            <th rowspan="2" data-sortedname="Company">@Resources.Company</th>
        </tr>
        <tr class="thead-row2">

            <th class="hidden-stack-mode col-winloss" data-sortedname="Member.WinLoss">@Resources.WinLoss</th>
            <th class="hidden-stack-mode" data-sortedname="Member.Comm">@Resources.Comm</th>
            <th class="hidden-stack-mode" data-sortedname="Member.Total">@Resources.Total</th>
            <th colspan="3" class="visible-stack-mode col-combine" data-sortedname="Member.WinLoss">
                <span class="prior-sortedcolumn">@Resources.WinLossAbbr</span>@Resources.CommAndTotal
            </th>

            <th class="hidden-stack-mode col-winloss" data-sortedname="Agent.WinLoss">@Resources.WinLoss</th>
            <th class="hidden-stack-mode" data-sortedname="Agent.Comm">@Resources.Comm</th>
            <th class="hidden-stack-mode" data-sortedname="Agent.Total">@Resources.Total</th>
            <th colspan="3" class="visible-stack-mode col-combine" data-sortedname="Agent.WinLoss">
                <span class="prior-sortedcolumn">@Resources.WinLossAbbr</span>@Resources.CommAndTotal
            </th>
            @if (Model.ReportLevel.IsMasterLevel()
                || Model.ReportLevel.IsSuperLevel())
            {
                <th class="hidden-stack-mode col-winloss" data-sortedname="Master.WinLoss">@Resources.WinLoss</th>
                <th class="hidden-stack-mode" data-sortedname="Master.Comm">@Resources.Comm</th>
                <th class="hidden-stack-mode" data-sortedname="Master.Total">@Resources.Total</th>
                <th colspan="3" class="visible-stack-mode col-combine" data-sortedname="Master.WinLoss">
                    <span class="prior-sortedcolumn">@Resources.WinLossAbbr</span>@Resources.CommAndTotal
                </th>
            }

            @if (Model.ReportLevel.IsSuperLevel())
            {
                <th class="hidden-stack-mode col-winloss" data-sortedname="Super.WinLoss">@Resources.WinLoss</th>
                <th class="hidden-stack-mode" data-sortedname="Super.Comm">@Resources.Comm</th>
                <th class="hidden-stack-mode" data-sortedname="Super.Total">@Resources.Total</th>
                <th colspan="3" class="visible-stack-mode col-combine" data-sortedname="Super.WinLoss">
                    <span class="prior-sortedcolumn">@Resources.WinLossAbbr</span>@Resources.CommAndTotal
                </th>
            }
        </tr>
    </thead>
    @if (Model.ReportData.Any())
    {
        <tbody>
            @foreach (var data in Model.ReportData.DataSource.OrderBy(Model.SortPropertyName, Model.IsDescendingSort))
            {
                @RenderRow(data, false, betListPath)
            }
        </tbody>
        <tfoot>
            @RenderRow(Model.ReportData.TotalData, true, betListPath)
        </tfoot>
    }
    else
    {
        @NoInformation.Render(colspan:
        Model.ReportLevel.IsSuperLevel()
        ? (Model.ReportLevel.IsMasterLevel() ? 15 : 12)
        : 18)
    }
</table>

@Pager.Render(Model.PagerViewModel)

@section Scripts {
    @ReportsScripts.Render("~/assets/bundles/winlossdetail/winlossdetail")
}

@helper RenderRow(WinLossDetail data, bool isTotalRow, string betListPath)
{
    <tr class="@(isTotalRow ? "tbl-footer" : string.Empty)">
        <td>
            @if (isTotalRow)
            {
                @Resources.Total
            }
            else
            {
                if (Model.ReportLevel.IsAgentLevel())
                {
                    @Html.ActionLink(
                    linkText: data.CustName,
                    actionName: betListPath,
                    controllerName: string.Empty,
                    routeValues: new
                    {
                        Custid = data.CustId,
                        Username = data.CustName,
                        FDate = Model.FromDate,
                        TDate = Model.ToDate,
                        ProductIds = Model.UserSelectedProductIds,
                        Type = "WLByDate"
                    },
                    htmlAttributes: null)
                }
                else
                {
                    @Html.ActionLink(
                              linkText: data.CustName,
                              actionName: "Index",
                              controllerName: "WinLossDetail",
                              routeValues: Model.LinkActionViewModel(data.CustId),
                              htmlAttributes: new
                              {
                                  @class = "downline-link"
                              })
                }
            }
        </td>

        <td class="text-right">@HtmlHelpers.FormatNumber(data.NumberOfTickets)</td>
        @if (Model.IsStackMode)
        {
            @HtmlHelpers.RenderStackCell("col-turnover-combined", 1, data.Turnover, data.NetTurnover, data.GrossComm);

            @RenderStackCustWinLoss(level: "member", custWinLoss: data.Member, isAlterCell: false);
            @RenderStackCustWinLoss(level: "agent", custWinLoss: data.Agent, isAlterCell: true);
            @RenderStackCustWinLoss(level: "master", custWinLoss: data.Master, isAlterCell: false);
            @RenderStackCustWinLoss(level: "super", custWinLoss: data.Super, isAlterCell: true);
        }
        else
        {
            @HtmlHelpers.RenderNumberCell(data.Turnover, "col-turnover")
            @HtmlHelpers.RenderNumberCell(data.NetTurnover)
            @HtmlHelpers.RenderNumberCell(data.GrossComm)

            @RenderCustWinLoss(level: "member", custWinLoss: data.Member, isAlterCell: false)
            @RenderCustWinLoss(level: "agent", custWinLoss: data.Agent, isAlterCell: true)
            @RenderCustWinLoss(level: "master", custWinLoss: data.Master, isAlterCell: false)
            @RenderCustWinLoss(level: "super", custWinLoss: data.Super, isAlterCell: true)
        }
        <td class="text-right">@HtmlHelpers.FormatNumber(data.Company)</td>
    </tr>
}

@helper RenderStackCustWinLoss(string level, CustWinLoss custWinLoss, bool isAlterCell)
{
if (custWinLoss == null)
{
    return;
}

var alterCellClass = isAlterCell ? "altercol" : string.Empty;
    @HtmlHelpers.RenderStackCell(
        $"col-{level}winloss-combined {alterCellClass}",
        3,
        custWinLoss.WinLoss,
        custWinLoss.Comm,
        custWinLoss.Total);
}

@helper RenderCustWinLoss(string level, CustWinLoss custWinLoss, bool isAlterCell)
{
if (custWinLoss == null)
{
    return;
}

var alterCellClass = isAlterCell ? "altercol" : string.Empty;

    @HtmlHelpers.RenderNumberCell(custWinLoss.WinLoss, $"col-{level}{nameof(custWinLoss.WinLoss).ToLower()} {alterCellClass}")
    @HtmlHelpers.RenderNumberCell(custWinLoss.Comm, alterCellClass)
    @HtmlHelpers.RenderNumberCell(custWinLoss.Total, $"bold {alterCellClass}")
}