@using Alpha.Reports.Site.Helpers
@using Alpha.Reports.Site.Configurations

@model WinLossDetailViewModel

@{
    ViewBag.BetListPath = $"../../{AppPathHelper.GetAppPath(SiteSettings.OldMainAppPath, "~/")}_BetList/BetList.aspx";
}

@Html.Partial("_NetTurnoverTooltips", Model.NetTurnoverTooltips)
@Html.Partial("_PageTitle", new PageHeaderViewModel(Model.Title, true, true, Model.IsStackMode, Model.IsFilterVisible, Model.BreadcrumbLevels))
@Html.Partial("Filter", Model.FilterViewModel,
    new ViewDataDictionary
    {
        { "IsStackMode", Model.IsStackMode },
        { "IsDescendingSort", Model.IsDescendingSort },
        { "SortPropertyName", Model.SortPropertyName }
    })
<table class="tblRpt tblRpt-bordered tblRpt-striped width-100per tablesorter
       @(Model.IsStackMode ? "stack-mode" : string.Empty)" id="tbl-report"
       data-totalrecords="@Model.ReportData.TotalRecords"
       data-custid="@Model.CustId"
       data-sortedcolumn="@Model.SortPropertyName"
       data-descendingsort="@Model.IsDescendingSort">
    <thead>
        <tr>
            <th class="sorting" rowspan="2" data-sortedname="CustName" data-colindex="0">@Resources.Username</th>
            <th class="sorting" rowspan="2" data-sortedname="NumberOfTickets" data-colindex="1">@Resources.NoOfTickets</th>
            <th rowspan="2" class="hidden-stack-mode sorting" data-sortedname="Turnover" data-colindex="2">@Resources.Turnover</th>
            <th rowspan="2" class="hidden-stack-mode col-netturnover-header sorting" data-sortedname="NetTurnover" data-colindex="3">@Resources.NetTurnover</th>
            <th rowspan="2" class="hidden-stack-mode sorting" data-sortedname="GrossComm" data-colindex="4">@Resources.GrossComm</th>
            <th rowspan="2" class="visible-stack-mode col-netturnover-header col-combine sorting" data-sortedname="Turnover" data-colindex="2">
                <span class="prior-sortedcolumn">@Resources.TurnoverAbbr</span>@Resources.NetTurnoverAndGrossComm
            </th>

            <th colspan="3" class="col-level hidden-stack-mode" data-disabledsort="true">@Resources.Member</th>
            <th class="visible-stack-mode col-combine sorting" data-sortedname="MemberNetWinLoss.WinLoss" rowspan="2" data-colindex="3">
                @Resources.Member
                <br />
                (<span class="prior-sortedcolumn">@Resources.WinLossAbbr</span>@Resources.CommAndTotal)
            </th>

            <th colspan="3" class="col-level hidden-stack-mode" data-disabledsort="true">@Resources.Agent</th>
            <th class="visible-stack-mode col-combine sorting" data-sortedname="AgentNetWinLoss.WinLoss" rowspan="2" data-colindex="4">
                @Resources.Agent
                <br />
                (<span class="prior-sortedcolumn">@Resources.WinLossAbbr</span>@Resources.CommAndTotal)
            </th>

            @if (Model.UserLevel.IsMasterOrSuperLevel())
            {
                <th colspan="3" class="col-level hidden-stack-mode" data-disabledsort="true">@Resources.Master</th>
                <th class="visible-stack-mode col-combine sorting" data-sortedname="MasterNetWinLoss.WinLoss" rowspan="2" data-colindex="5">
                    @Resources.Master
                    <br />
                    (<span class="prior-sortedcolumn">@Resources.WinLossAbbr</span>@Resources.CommAndTotal)
                </th>
            }

            @if (Model.UserLevel.IsSuperLevel())
            {
                <th colspan="3" class="col-level hidden-stack-mode" data-disabledsort="true">@Resources.Super</th>
                <th class="visible-stack-mode col-combine sorting" data-sortedname="SuperNetWinLoss.WinLoss" rowspan="2" data-colindex="6">
                    @Resources.Super
                    <br />
                    (<span class="prior-sortedcolumn">@Resources.WinLossAbbr</span>@Resources.CommAndTotal)
                </th>
            }

            <th class="sorting" rowspan="2" data-sortedname="Company" data-colindex="17">@Resources.Company</th>
        </tr>
        <tr class="thead-row2">
            <th class="hidden-stack-mode col-winloss sorting" data-sortedname="MemberNetWinLoss.WinLoss" data-colindex="5">@Resources.WinLoss</th>
            <th class="hidden-stack-mode sorting" data-sortedname="MemberNetWinLoss.Comm" data-colindex="6">@Resources.Comm</th>
            <th class="hidden-stack-mode sorting" data-sortedname="MemberNetWinLoss.Total" data-colindex="7">@Resources.Total</th>

            <th class="hidden-stack-mode col-winloss sorting" data-sortedname="AgentNetWinLoss.WinLoss" data-colindex="8">@Resources.WinLoss</th>
            <th class="hidden-stack-mode sorting" data-sortedname="AgentNetWinLoss.Comm" data-colindex="9">@Resources.Comm</th>
            <th class="hidden-stack-mode sorting" data-sortedname="AgentNetWinLoss.Total" data-colindex="10">@Resources.Total</th>
            @if (Model.UserLevel.IsMasterOrSuperLevel())
            {
                <th class="hidden-stack-mode col-winloss sorting" data-sortedname="MasterNetWinLoss.WinLoss" data-colindex="11">@Resources.WinLoss</th>
                <th class="hidden-stack-mode sorting" data-sortedname="MasterNetWinLoss.Comm" data-colindex="12">@Resources.Comm</th>
                <th class="hidden-stack-mode sorting" data-sortedname="MasterNetWinLoss.Total" data-colindex="13">@Resources.Total</th>
            }

            @if (Model.UserLevel.IsSuperLevel())
            {
                <th class="hidden-stack-mode col-winloss sorting" data-sortedname="SuperNetWinLoss.WinLoss" data-colindex="14">@Resources.WinLoss</th>
                <th class="hidden-stack-mode sorting" data-sortedname="SuperNetWinLoss.Comm" data-colindex="15">@Resources.Comm</th>
                <th class="hidden-stack-mode sorting" data-sortedname="SuperNetWinLoss.Total" data-colindex="16">@Resources.Total</th>
            }
        </tr>
    </thead>
    @if (Model.ReportData.Any())
    {
        <tbody>
            @foreach (var data in Model
                    .ReportData
                    .DataSource
                    .OrderBy(Model.SortPropertyName, Model.IsDescendingSort))
            {
                @RenderRow(data, false, ViewBag.BetListPath)
            }
        </tbody>
        <tfoot>
            @RenderRow(Model.ReportData.TotalData, true, ViewBag.BetListPath)
        </tfoot>
    }
    else
    {
        @NoInformation.Render(colspan:
            Model.UserLevel.IsSuperLevel()
            ? 18
            : (Model.UserLevel.IsMasterLevel() ? 15 : 12))
    }
</table>

<form class="form-inline hide" role="form" id="export-excel-form" action="WinLossDetail/Excel">
    <input type="hidden" name="CustId" value="@Model.CustId" />
    <input type="hidden" name="FromDate" value="@Model.FromDate" />
    <input type="hidden" name="ToDate" value="@Model.ToDate" />
    <input type="hidden" name="UserSelectedProductIds" value="@Model.UserSelectedProductIds" />
    <input type="hidden" name="UserLevelId" value="@Model.UserLevel.Value" />
</form>
@Html.Hidden("HasSubmittedParams", Model.HasSubmittedParams)
@Pager.Render(Model.PagerViewModel)

@section Scripts {
    @ReportsScripts.Render("~/assets/bundles/winlossdetail/winlossdetail")
}

@helper RenderRow(WinLossDetail data, bool isTotalRow, string betListPath)
{
    <tr @(isTotalRow ? "class=tbl-footer" : string.Empty)>
        <td data-islink="true" class="text-left">
            @if (isTotalRow)
            {
                @Resources.Total
            }
            else
            {
                if (Model.UserLevel.IsAgentLevel())
                {
                    @Html.ActionLink(
                    linkText: data.CustName,
                    actionName: betListPath,
                    controllerName: string.Empty,
                    routeValues: new
                    {
                        Custid = data.CustId,
                        Username = data.CustName,
                        FDate = Model.FromDate,
                        TDate = Model.ToDate,
                        ProductIds = Model.UserSelectedProductIds,
                        FilterPostback = 1,
                        Type = "WLByDate"
                    },
                    htmlAttributes: null)
                }
                else
                {
                    @Html.ActionLink(
                        linkText: data.CustName,
                        actionName: "Index",
                        controllerName: "WinLossDetail",
                        routeValues: Model.LinkActionViewModel(data),
                        htmlAttributes: new
                        {
                            @class = "downline-link"
                        })
                }
            }
        </td>

        <td>@HtmlHelpers.FormatNumber(data.NumberOfTickets)</td>
        @if (Model.IsStackMode)
        {
            @HtmlHelpers.RenderStackCell("col-turnover-combined", 1, data.Turnover, data.NetTurnover, data.GrossComm);

            @RenderStackNetWinLoss(UserLevel.Member, data.MemberNetWinLoss);
            @RenderStackNetWinLoss(UserLevel.Agent, data.AgentNetWinLoss, isHighlight: true);
            @RenderStackNetWinLoss(UserLevel.Master, data.MasterNetWinLoss);
            @RenderStackNetWinLoss(UserLevel.Super, data.SuperNetWinLoss, isHighlight: true);
        }
        else
        {
            @HtmlHelpers.RenderNumberCell(data.Turnover, "col-turnover")
            @HtmlHelpers.RenderNumberCell(data.NetTurnover)
            @HtmlHelpers.RenderNumberCell(data.GrossComm)

            @RenderNetWinLoss(UserLevel.Member, data.MemberNetWinLoss)
            @RenderNetWinLoss(UserLevel.Agent, data.AgentNetWinLoss, isHighlight: true)
            @RenderNetWinLoss(UserLevel.Master, data.MasterNetWinLoss)
            @RenderNetWinLoss(UserLevel.Super, data.SuperNetWinLoss, isHighlight: true)
        }
        <td>@HtmlHelpers.FormatNumber(data.Company)</td>
    </tr>
}

@helper RenderStackNetWinLoss(UserLevel level, NetWinLoss netWinLoss, bool isHighlight = false)
{
if (netWinLoss == null)
{
    return;
}

var highlightCellClass = isHighlight ? "altercol" : string.Empty;

    @HtmlHelpers.RenderStackCell(
        $"col-{level.DisplayName.ToLower()}-winloss-combined {highlightCellClass}",
        1,
        netWinLoss.WinLoss,
        netWinLoss.Comm,
        netWinLoss.Total);
}

@helper RenderNetWinLoss(UserLevel level, NetWinLoss netWinLoss, bool isHighlight = false)
{
if (netWinLoss == null)
{
    return;
}

var highlightCellClass = isHighlight ? "altercol" : string.Empty;

    @HtmlHelpers.RenderNumberCell(netWinLoss.WinLoss, $"col-{level.DisplayName.ToLower()}-winloss {highlightCellClass}")
    @HtmlHelpers.RenderNumberCell(netWinLoss.Comm, highlightCellClass)
    @HtmlHelpers.RenderNumberCell(netWinLoss.Total, $"bold {highlightCellClass}")
}
