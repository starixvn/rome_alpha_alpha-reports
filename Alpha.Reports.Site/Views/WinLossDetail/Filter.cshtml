@using Components
@model WinLossDetailFilterViewModel

<form class="form-inline filter" role="form" id="report-form">
    @RenderHiddenFields()

    @(Model.IsHistoricReport
        ? MonthPicker.Render(Model.MonthPickerViewModel)
        : DateRangePicker.Render(Model.DateRangePickerViewModel))

    @ProductMultiSelection.Render(Model.ProductMultiSelectionViewModel)

    <div class="form-group">
        <input type="submit" value="@Resources.Submit" class="btn-submit" />
    </div>

    <div class="form-group">
        <span class="icon-excel" title="@Resources.ExportToExcel"></span>
    </div>

    <div class="note">
        <span class="star">*</span> @Html.Raw(Model.ViewDataInstructionMessage)
    </div>
</form>



@helper RenderHiddenFields()
{
    @Html.Hidden("IsFilterVisible", Model.Visible as bool?)
    @Html.Hidden("IsHistoricReport", Model.IsHistoricReport as bool?)
    @Html.Hidden("IsStackMode", ViewData["IsStackMode"] as bool?)
    @Html.Hidden("IsDescendingSort", ViewData["IsDescendingSort"] as bool?)
    @Html.Hidden("SortPropertyName", ViewData["SortPropertyName"] as string)
    @Html.Hidden("PageIndex", ViewData["CurrentPageIndex"] as int?)
    @Html.Hidden("PageSize", ViewData["PageSize"] as int?)

if (!Model.IsDirectReportViewAction)
{
        @Html.Hidden("CustId", Model.CustId as int?)
}
}
