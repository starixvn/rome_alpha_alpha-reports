@using Alpha.Reports.Extensions;
@model dynamic
@{
    var total = Model.ReportData.Total;
}

@functions{
    string FormatNumber(dynamic number)
    {
        return ((decimal)number).ToNumericString();
    }
}

<table class="tblRpt tblRpt-bordered tblRpt-striped tblRpt-hover width-100per
        @(Model.IsStackMode?"stack-mode":string.Empty)" id="tbl-report"
       data-pageindex="@Model.ReportData.CurrentPageIndex"
       data-pagesize="@Model.ReportData.PageSize"
       data-totalrecords="@Model.ReportData.TotalRecords"
       data-custid="@Model.CustId"
       data-fromdate="@Model.FromDate"
       data-todate="@Model.ToDate"
       data-sortedcolumn="@Model.SortedColumn"
       data-sortdirection="@Model.SortDirection">
    <thead>
        <tr>
            <th rowspan="2">@Resources.Username <span class="icon-menu-up ascSorting"></span></th>
            <th rowspan="2">@Resources.NoOfTickets</th>
            <th rowspan="2" class="hidden-stack-mode">@Resources.Turnover</th>
            <th rowspan="2" class="hidden-stack-mode col-netturnover-header">@Resources.NetTurnover</th>
            <th rowspan="2" class="hidden-stack-mode">@Resources.GrossComm</th>
            <th rowspan="2" class="visible-stack-mode">@Resources.TO_NetTO_GrossComm</th>
            <th colspan="3" class="col-level">@Resources.Member</th>
            <th colspan="3" class="col-level">@Resources.Agent</th>
            <th rowspan="2">@Resources.Company</th>
        </tr>
        <tr class="RptHeader02">
            @for (var i = 0; i < 2; i++)
            {
                <th class="hidden-stack-mode col-winloss">@Resources.WinLoss</th>
                <th class="hidden-stack-mode">@Resources.Comm</th>
                <th class="hidden-stack-mode">@Resources.Total</th>
                <th colspan="3" class="visible-stack-mode col-combine">@Resources.WL_Comm_Total</th>
            }
        </tr>
    </thead>
    @if (Model.HasData)
    {
        <tbody>
            @foreach (var data in Model.ReportData.DataSource)
            {
                <tr>
                    <td><a href="@Model.OldMainAppPath/_BetList/BetList.aspx?" class="downline-link">@data.CustName</a></td>
                    <td class="text-right">@data.NumberOfTickets</td>
                    @if (Model.IsStackMode)
                    {
                        <td class="text-right visible-stack-mode combinedcolumn col-turnover-combined">
                            <ul>
                                <li>@FormatNumber(data.Turnover)</li>
                                <li>@FormatNumber(data.NetTurnover)</li>
                                <li>@FormatNumber(data.GrossComm)</li>
                            </ul>
                        </td>
                        <td class="text-right visible-stack-mode combinedcolumn column-winloss-combined" colspan="3">
                            <ul>
                                <li>@FormatNumber(data.MemberWinLoss)</li>
                                <li>@FormatNumber(data.MemberComm)</li>
                                <li>@FormatNumber(data.MemberTotal)</li>
                            </ul>
                        </td>
                        <td class="text-right visible-stack-mode combinedcolumn column-winloss-combined" colspan="3">
                            <ul>
                                <li>@FormatNumber(data.AgentWinLoss)</li>
                                <li>@FormatNumber(data.AgentComm)</li>
                                <li>@FormatNumber(data.AgentTotal)</li>
                            </ul>
                        </td>
                    }
                    else
                    {
                        <td class="text-right hidden-stack-mode col-turnover">@FormatNumber(data.Turnover)</td>
                        <td class="text-right hidden-stack-mode col-netturnover">@FormatNumber(data.NetTurnover)</td>
                        <td class="text-right hidden-stack-mode col-grosscomm">@FormatNumber(data.GrossComm)</td>
                        <td class="text-right hidden-stack-mode col-winloss">@FormatNumber(data.MemberWinLoss)</td>
                        <td class="text-right hidden-stack-mode col-comm">@FormatNumber(data.MemberComm)</td>
                        <td class="text-right bold hidden-stack-mode col-total">@FormatNumber(data.MemberTotal)</td>
                        <td class="altercol text-right hidden-stack-mode col-winloss">@FormatNumber(data.AgentWinLoss)</td>
                        <td class="altercol text-right hidden-stack-mode col-comm">@FormatNumber(data.AgentComm)</td>
                        <td class="altercol bold text-right hidden-stack-mode col-total">@FormatNumber(data.AgentTotal)</td>
                    }
                    <td class="text-right">@FormatNumber(data.Company)</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="RptFooter">
                <td>@Resources.Total</td>
                <td class="text-right">@total.NumberOfTickets</td>
                @if (Model.IsStackMode)
                {
                    <td class="text-right visible-stack-mode combinedcolumn col-turnover-combined">
                        <ul>
                            <li>@FormatNumber(total.Turnover)</li>
                            <li>@FormatNumber(total.NetTurnover)</li>
                            <li>@FormatNumber(total.GrossComm)</li>
                        </ul>
                    </td>
                    <td class="text-right visible-stack-mode combinedcolumn column-winloss-combined" colspan="3">
                        <ul>
                            <li>@FormatNumber(total.MemberWinLoss)</li>
                            <li>@FormatNumber(total.MemberComm)</li>
                            <li>@FormatNumber(total.MemberTotal)</li>
                        </ul>
                    </td>
                    <td class="text-right visible-stack-mode combinedcolumn column-winloss-combined" colspan="3">
                        <ul>
                            <li>@FormatNumber(total.AgentWinLoss)</li>
                            <li>@FormatNumber(total.AgentComm)</li>
                            <li>@FormatNumber(total.AgentTotal)</li>
                        </ul>
                    </td>
                }
                else
                {
                    <td class="text-right hidden-stack-mode col-turnover">@FormatNumber(total.Turnover)</td>
                    <td class="text-right hidden-stack-mode col-netturnover">@FormatNumber(total.NetTurnover)</td>
                    <td class="text-right hidden-stack-mode col-grosscomm">@FormatNumber(total.GrossComm)</td>
                    <td class="text-right hidden-stack-mode col-winloss">@FormatNumber(total.MemberWinLoss)</td>
                    <td class="text-right hidden-stack-mode col-comm">@FormatNumber(total.MemberComm)</td>
                    <td class="text-right bold hidden-stack-mode col-total">@FormatNumber(total.MemberTotal)</td>
                    <td class="altercol text-right hidden-stack-mode col-winloss">@FormatNumber(total.AgentWinLoss)</td>
                    <td class="altercol text-right hidden-stack-mode col-comm">@FormatNumber(total.AgentComm)</td>
                    <td class="altercol bold text-right hidden-stack-mode col-total">@FormatNumber(total.AgentTotal)</td>
                }
                <td class="text-right">@FormatNumber(total.Company)</td>
            </tr>
        </tfoot>
    }
    else
    {
        <tbody>
            <tr>
                <td colspan="12">@Resources.NoInformationIsAvailable</td>
            </tr>
        </tbody>
    }
</table>