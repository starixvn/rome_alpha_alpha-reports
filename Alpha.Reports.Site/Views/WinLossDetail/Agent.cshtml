@using Alpha.Reports.Site.Helpers;
@using Alpha.Reports.Models.WinlossDetail;
@using Alpha.Reports.Site.ViewModels.WinLossDetail;

@model WinLossDetailViewModel<AgentWinLossDetail>
@{
    Layout = "~/Views/WinLossDetail/WinLossDetail.cshtml";
    ViewBag.Title = SiteResources.AgentWinLossDetail;
    ViewBag.CurrentPath = AppPathHelper.GetAppPath(HttpContext.Current.Request.ApplicationPath, "~/WinLossDetail/Agent");
    ViewBag.HasData = ((List<AgentWinLossDetail>)Model.ReportData.DataSource).Any();
}

@section ReportData {
    <thead>
        <tr>
            <th rowspan="2" data-sortedname="CustName">@SiteResources.Username</th>
            <th rowspan="2" data-sortedname="NumberOfTickets">@SiteResources.NoOfTickets</th>
            <th rowspan="2" class="hidden-stack-mode" data-sortedname="Turnover">@SiteResources.Turnover</th>
            <th rowspan="2" class="hidden-stack-mode col-netturnover-header" data-sortedname="NetTurnover">@SiteResources.NetTurnover</th>
            <th rowspan="2" class="hidden-stack-mode" data-sortedname="GrossComm">@SiteResources.GrossComm</th>
            <th rowspan="2" class="visible-stack-mode col-combine" data-sortedname="Turnover">@Html.Raw(SiteResources.TO_NetTO_GrossComm)</th>
            <th colspan="3" class="col-level">@SiteResources.Member</th>
            <th colspan="3" class="col-level">@SiteResources.Agent</th>
            <th colspan="3" class="col-level">@SiteResources.Master</th>
            <th rowspan="2" data-sortedname="Company">@SiteResources.Company</th>
        </tr>
        <tr class="thead-row2">
            <th class="hidden-stack-mode col-winloss" data-sortedname="MemberWinLoss">@SiteResources.WinLoss</th>
            <th class="hidden-stack-mode" data-sortedname="MemberComm">@SiteResources.Comm</th>
            <th class="hidden-stack-mode" data-sortedname="MemberTotal">@SiteResources.Total</th>
            <th colspan="3" class="visible-stack-mode col-combine" data-sortedname="MemberWinLoss">@Html.Raw(SiteResources.WL_Comm_Total)</th>
            <th class="hidden-stack-mode col-winloss" data-sortedname="AgentWinLoss">@SiteResources.WinLoss</th>
            <th class="hidden-stack-mode" data-sortedname="AgentComm">@SiteResources.Comm</th>
            <th class="hidden-stack-mode" data-sortedname="AgentTotal">@SiteResources.Total</th>
            <th colspan="3" class="visible-stack-mode col-combine" data-sortedname="AgentWinLoss">@Html.Raw(SiteResources.WL_Comm_Total)</th>
            <th class="hidden-stack-mode col-winloss" data-sortedname="MasterWinLoss">@SiteResources.WinLoss</th>
            <th class="hidden-stack-mode" data-sortedname="MasterComm">@SiteResources.Comm</th>
            <th class="hidden-stack-mode" data-sortedname="MasterTotal">@SiteResources.Total</th>
            <th colspan="3" class="visible-stack-mode col-combine" data-sortedname="MasterWinLoss">@Html.Raw(SiteResources.WL_Comm_Total)</th>
        </tr>
    </thead>
    <tbody>
        @if (ViewBag.HasData)
        {
            foreach (var data in Model.ReportData.DataSource.OrderBy(Model.SortPropertyName, Model.IsDescendingSort))
            {
                @RenderRow(data, false)
            }
        }
        else
        {
            @Html.Partial("_NoInfo", 15)
        }
    </tbody>

    @if (ViewBag.HasData)
    {
        <tfoot>
            @RenderRow(Model.ReportData.Total, true)
        </tfoot>
    }
}

@helper RenderRow(AgentWinLossDetail data, bool isTotalRow)
{
    <tr class="@(isTotalRow ? "tbl-footer" : string.Empty)">
        <td>
            @if (isTotalRow)
            {
                @SiteResources.Total
            }
            else
            {
                @Html.ActionLink(
                    linkText: data.CustName,
                    actionName: "Member",
                    controllerName: "WinLossDetail",
                    routeValues: new
                    {
                        Custid = data.CustId,
                        PageIndex = Model.ReportData.CurrentPageIndex,
                        PageSize = Model.ReportData.PageSize,
                        FromDate = Model.FromDate,
                        ToDate = Model.ToDate,
                        UserSelectedProductIds = string.Join(",", Model.Products.Where(product => product.Selected).Select(product => product.Value)),
                        SortPropertyName = Model.SortPropertyName,
                        IsDescendingSort = Model.IsDescendingSort,

                        IsHistoricReport = Model.IsHistoricReport,
                        UserSelectedDateRangeOption = Model.UserSelectedDateRangeOption,

                        HideFilter = Model.HideFilter,
                        IsStackMode = Model.IsStackMode,
                        TimeStamp = DateTime.Now
                    },
                    htmlAttributes: new
                    {
                        @class = "downline-link"
                    })
            }
        </td>
        <td class="text-right">@SharedHelpers.FormatNumber(data.NumberOfTickets)</td>
        @if (Model.IsStackMode)
        {
            @SharedHelpers.RenderStackColumn(
                new List<decimal>() { data.Turnover, data.NetTurnover, data.GrossComm },
                "text-right visible-stack-mode combinedcolumn col-turnover-combined",
                1);
            @SharedHelpers.RenderStackColumn(
                new List<decimal>() { data.MemberWinLoss, data.MemberComm, data.MemberTotal },
                "text-right visible-stack-mode combinedcolumn col-memberwinloss-combined",
                3);
            @SharedHelpers.RenderStackColumn(
               new List<decimal>() { data.AgentWinLoss, data.AgentComm, data.AgentTotal },
               "text-right visible-stack-mode combinedcolumn col-agentwinloss-combined altercol",
               3);
            @SharedHelpers.RenderStackColumn(
               new List<decimal>() { data.MasterWinLoss, data.MasterComm, data.MasterTotal },
               "text-right visible-stack-mode combinedcolumn col-masterwinloss-combined",
               3);
        }
        else
        {
            @RenderColumn(data.Turnover, "col-turnover")
            @RenderColumn(data.NetTurnover, "col-netturnover")
            @RenderColumn(data.GrossComm, "col-grosscomm")

            @RenderColumn(data.MemberWinLoss, "col-memberwinloss")
            @RenderColumn(data.MemberComm, "col-membercomm")
            @RenderColumn(data.MemberTotal, "col-membertotal")

            @RenderColumn(data.AgentWinLoss, "col-agentwinloss", isAlterCol: true)
            @RenderColumn(data.AgentComm, "col-agentcomm", isAlterCol: true)
            @RenderColumn(data.AgentTotal, "col-agenttotal", isAlterCol: true)

            @RenderColumn(data.MasterWinLoss, "col-masterwinloss")
            @RenderColumn(data.MasterComm, "col-mastercomm")
            @RenderColumn(data.MasterTotal, "col-mastertotal")
        }
        <td class="text-right">@SharedHelpers.FormatNumber(data.Company)</td>
    </tr>
}

@helper RenderColumn(decimal columnValue, string columnName, bool isAlterCol = false)
{
    <td class="bold text-right hidden-stack-mode @columnName @(isAlterCol ? "altercol" : string.Empty)">
        @SharedHelpers.FormatNumber(columnValue)
    </td>
}
