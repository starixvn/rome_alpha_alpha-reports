@using Alpha.Reports.Site.Helpers;
@using Alpha.Reports.Models.WinlossDetail;
@using Alpha.Reports.Site.ViewModels.WinLossDetail;
@model WinLossDetailViewModel<MasterWinLossDetail>
@{
    Layout = "~/Views/WinLossDetail/WinLossDetail.cshtml";
    ViewBag.Title = Resources.MasterWinLossDetail;
    ViewBag.CurrentPath = AppPathHelper.GetAppPath(HttpContext.Current.Request.ApplicationPath, "~/WinLossDetail/Master");
    ViewBag.HasData = ((List<MasterWinLossDetail>)Model.ReportData.DataSource).Any();
}

@section ReportData {
    <thead>
        <tr>
            <th rowspan="2" data-sortedname="CustName">@Resources.Username</th>
            <th rowspan="2" data-sortedname="NumberOfTickets">@Resources.NoOfTickets</th>
            <th rowspan="2" class="hidden-stack-mode" data-sortedname="Turnover">@Resources.Turnover</th>
            <th rowspan="2" class="hidden-stack-mode col-netturnover-header" data-sortedname="NetTurnover">@Resources.NetTurnover</th>
            <th rowspan="2" class="hidden-stack-mode" data-sortedname="GrossComm">@Resources.GrossComm</th>
            <th rowspan="2" class="visible-stack-mode col-combine" data-sortedname="Turnover">@Html.Raw(Resources.TO_NetTO_GrossComm)</th>
            <th colspan="3" class="col-level">@Resources.Member</th>
            <th colspan="3" class="col-level">@Resources.Agent</th>
            <th colspan="3" class="col-level">@Resources.Master</th>
            <th colspan="3" class="col-level">@Resources.Super</th>
            <th rowspan="2" data-sortedname="Company">@Resources.Company</th>
        </tr>
        <tr class="thead-row2">
            <th class="hidden-stack-mode col-winloss" data-sortedname="MemberWinLoss">@Resources.WinLoss</th>
            <th class="hidden-stack-mode" data-sortedname="MemberComm">@Resources.Comm</th>
            <th class="hidden-stack-mode" data-sortedname="MemberTotal">@Resources.Total</th>
            <th colspan="3" class="visible-stack-mode col-combine" data-sortedname="MemberWinLoss">@Html.Raw(Resources.WL_Comm_Total)</th>
            <th class="hidden-stack-mode col-winloss" data-sortedname="AgentWinLoss">@Resources.WinLoss</th>
            <th class="hidden-stack-mode" data-sortedname="AgentComm">@Resources.Comm</th>
            <th class="hidden-stack-mode" data-sortedname="AgentTotal">@Resources.Total</th>
            <th colspan="3" class="visible-stack-mode col-combine" data-sortedname="AgentWinLoss">@Html.Raw(Resources.WL_Comm_Total)</th>
            <th class="hidden-stack-mode col-winloss" data-sortedname="MasterWinLoss">@Resources.WinLoss</th>
            <th class="hidden-stack-mode" data-sortedname="MasterComm">@Resources.Comm</th>
            <th class="hidden-stack-mode" data-sortedname="MasterTotal">@Resources.Total</th>
            <th colspan="3" class="visible-stack-mode col-combine" data-sortedname="MasterWinLoss">@Html.Raw(Resources.WL_Comm_Total)</th>
            <th class="hidden-stack-mode col-winloss" data-sortedname="SuperWinLoss">@Resources.WinLoss</th>
            <th class="hidden-stack-mode" data-sortedname="SuperComm">@Resources.Comm</th>
            <th class="hidden-stack-mode" data-sortedname="SuperTotal">@Resources.Total</th>
            <th colspan="3" class="visible-stack-mode col-combine" data-sortedname="SuperWinLoss">@Html.Raw(Resources.WL_Comm_Total)</th>
        </tr>
    </thead>
    <tbody>
        @if (ViewBag.HasData)
        {
            foreach (var data in Model.ReportData.DataSource.OrderBy(Model.SortPropertyName, Model.IsDescendingSort))
            {
                @RenderRow(data, false)
            }
        }
        else
        {
            <tr>
                <td colspan="18" align="center">@Resources.NoInformationIsAvailable</td>
            </tr>
        }
    </tbody>

    @if (ViewBag.HasData)
    {
        <tfoot>
            @RenderRow(Model.ReportData.Total, true)
        </tfoot>
    }
}

@helper RenderRow(MasterWinLossDetail data, bool isTotalRow)
{
    <tr class="@(isTotalRow ? "tbl-footer" : string.Empty)">
        <td>
            @if (isTotalRow)
            {
                @data.CustName
            }
            else
            {
                @Html.ActionLink(
                    linkText: data.CustName,
                    actionName: "Agent",
                    controllerName: "WinLossDetail",
                    routeValues: new
                    {
                        Custid = data.CustId,
                        PageIndex = Model.ReportData.CurrentPageIndex,
                        PageSize = Model.ReportData.PageSize,
                        FromDate = Model.FromDate,
                        ToDate = Model.ToDate,
                        UserSelectedProductIds = Model.UserSelectedProductIds,
                        SortPropertyName = Model.SortPropertyName,
                        IsDescendingSort = Model.IsDescendingSort,

                        IsHistoricReport = Model.IsHistoricReport,
                        UserSelectedDateRangeOption = Model.UserSelectedDateRangeOption,
                        TimeStamp = DateTime.Now
                    },
                    htmlAttributes: new
                    {
                        @class = "downline-link"
                    })
            }
        </td>
        <td class="text-right">@SharedHelpers.FormatNumber(data.NumberOfTickets)</td>
        @if (Model.IsStackMode)
        {
            @SharedHelpers.RenderCombinedColumn(
                new List<decimal>() { data.Turnover, data.NetTurnover, data.GrossComm },
                "text-right visible-stack-mode combinedcolumn col-turnover-combined",
                1);
            @SharedHelpers.RenderCombinedColumn(
                new List<decimal>() { data.MemberWinLoss, data.MemberComm, data.MemberTotal },
                "text-right visible-stack-mode combinedcolumn col-memberwinloss-combined",
                3);
            @SharedHelpers.RenderCombinedColumn(
               new List<decimal>() { data.AgentWinLoss, data.AgentComm, data.AgentTotal },
               "text-right visible-stack-mode combinedcolumn col-agentwinloss-combined altercol ",
               3);
            @SharedHelpers.RenderCombinedColumn(
               new List<decimal>() { data.MasterWinLoss, data.MasterComm, data.MasterTotal },
               "text-right visible-stack-mode combinedcolumn col-masterwinloss-combined",
               3);
            @SharedHelpers.RenderCombinedColumn(
               new List<decimal>() { data.SuperWinLoss, data.SuperComm, data.SuperTotal },
               "text-right visible-stack-mode combinedcolumn col-superwinloss-combined altercol",
               3);
        }
        else
        {

            @RenderColumn(data.Turnover, "col-turnover")
            @RenderColumn(data.NetTurnover, "col-netturnover")
            @RenderColumn(data.GrossComm, "col-grosscomm")

            @RenderColumn(data.MemberWinLoss, "col-memberwinloss")
            @RenderColumn(data.MemberComm, "col-membercomm")
            @RenderColumn(data.MemberTotal, "col-membertotal")

            @RenderColumn(data.AgentWinLoss, "col-agentwinloss", isAlterCol: true)
            @RenderColumn(data.AgentComm, "col-agentcomm", isAlterCol: true)
            @RenderColumn(data.AgentTotal, "col-agenttotal", isAlterCol: true)

            @RenderColumn(data.MasterWinLoss, "col-masterwinloss")
            @RenderColumn(data.MasterComm, "col-mastercomm")
            @RenderColumn(data.MasterTotal, "col-mastertotal")

            @RenderColumn(data.SuperWinLoss, "col-superwinloss", isAlterCol: true)
            @RenderColumn(data.SuperComm, "col-supercomm", isAlterCol: true)
            @RenderColumn(data.SuperTotal, "col-supertotal", isAlterCol: true)
        }
        <td class="text-right">@SharedHelpers.FormatNumber(data.Company)</td>
    </tr>
}

@helper RenderColumn(decimal columnValue, string columnName, bool isAlterCol = false)
{
    <td class="bold text-right hidden-stack-mode @columnName @(isAlterCol ? "altercol" : string.Empty)">
        @SharedHelpers.FormatNumber(columnValue)
    </td>
}
