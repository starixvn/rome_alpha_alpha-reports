@using Alpha.Reports.Site.Helpers;
@using Alpha.Reports.Models.WinlossDetail;
@using Alpha.Reports.Site.ViewModels.WinLossDetail;
@using Alpha.Reports.Extensions;
@model WinLossDetailViewModel<MasterWinLossDetail>
@{
    ViewBag.Title = Resources.MasterWinLossDetail;
}

@helper GetRow(MasterWinLossDetail data, string custName, string rowCss = "")
{
    <tr class="@rowCss">
        <td>@Html.Raw(custName)</td>
        <td class="text-right">@data.NumberOfTickets</td>
        @if (Model.IsStackMode)
        {
            @SharedHelpers.GetCombinedColumn(
                new List<decimal>() { data.Turnover, data.NetTurnover, data.GrossComm },
                "text-right visible-stack-mode combinedcolumn col-turnover-combined",
                1);
            @SharedHelpers.GetCombinedColumn(
                new List<decimal>() { data.MemberWinLoss, data.MemberComm, data.MemberTotal },
                "text-right visible-stack-mode combinedcolumn col-memberwinloss-combined",
                3);
            @SharedHelpers.GetCombinedColumn(
               new List<decimal>() { data.AgentWinLoss, data.AgentComm, data.AgentTotal },
               "text-right visible-stack-mode combinedcolumn col-agentwinloss-combined altercol ",
               3);
            @SharedHelpers.GetCombinedColumn(
               new List<decimal>() { data.MasterWinLoss, data.MasterComm, data.MasterTotal },
               "text-right visible-stack-mode combinedcolumn col-masterwinloss-combined",
               3);
            @SharedHelpers.GetCombinedColumn(
               new List<decimal>() { data.SuperWinLoss, data.SuperComm, data.SuperTotal },
               "text-right visible-stack-mode combinedcolumn col-superwinloss-combined altercol",
               3);
        }
        else
        {
            <td class="text-right hidden-stack-mode col-turnover">@data.Turnover.ToNumericString()</td>
            <td class="text-right hidden-stack-mode col-netturnover">@data.NetTurnover.ToNumericString()</td>
            <td class="text-right hidden-stack-mode col-grosscomm">@data.GrossComm.ToNumericString()</td>
            <td class="text-right hidden-stack-mode col-memberwinloss">@data.MemberWinLoss.ToNumericString()</td>
            <td class="text-right hidden-stack-mode col-membercomm">@data.MemberComm.ToNumericString()</td>
                <td class="text-right bold hidden-stack-mode col-membertotal">@data.MemberTotal.ToNumericString()</td>
                <td class="altercol text-right hidden-stack-mode col-agentwinloss">@data.AgentWinLoss.ToNumericString()</td>
                <td class="altercol text-right hidden-stack-mode col-agentcomm">@data.AgentComm.ToNumericString()</td>
                <td class="altercol bold text-right hidden-stack-mode col-agenttotal">@data.AgentTotal.ToNumericString()</td>
                <td class="text-right hidden-stack-mode col-masterwinloss">@data.MasterWinLoss.ToNumericString()</td>
                <td class="text-right hidden-stack-mode col-mastercomm">@data.MasterComm.ToNumericString()</td>
                <td class="bold text-right hidden-stack-mode col-mastertotal">@data.MasterTotal.ToNumericString()</td>
                <td class="altercol text-right hidden-stack-mode col-superwinloss">@data.SuperWinLoss.ToNumericString()</td>
                <td class="altercol text-right hidden-stack-mode col-supercomm">@data.SuperComm.ToNumericString()</td>
                <td class="altercol bold text-right hidden-stack-mode col-supertotal">@data.SuperTotal.ToNumericString()</td>
        }
        <td class="text-right">@data.Company.ToNumericString()</td>
    </tr>
}

@section Styles {
    @AssetStyles.Render("/bundles/common/common")
    @AssetStyles.Render("/bundles/site-reports/default")
    @ReportsStyles.Render("~/assets/bundles/default")
}

@Components_NetTurnoverTooltips.Render(Model.NetTurnoverTooltips)
@Components_PageTitle.Render(ViewBag.Title, true, true, Model.IsStackMode, Model.HideFilter)
@if (Model.IsHistoricReport)
{
    @Components_MonthAndProductFilter.Render(
        Model.HideFilter,
        Model.MinDate,
        Model.FromDate,
        Model.ToDate,
        Model.JsonProducts,
        Model.UserSelectedProductIds,
        Model.Language);
}
else
{
    @Components_DateRangeAndProductFilter.Render(
        Model.HideFilter,
        Model.MinDate,
        Model.MaxDate,
        Model.FromDate,
        Model.ToDate,
        Model.UserSelectedDateRangeOption,
        Model.JsonProducts,
        Model.UserSelectedProductIds,
        Model.Language);
}

<table class="tblRpt tblRpt-bordered tblRpt-striped tblRpt-hover width-100per
        @(Model.IsStackMode?"stack-mode":string.Empty)" id="tbl-report"
       data-pageindex="@Model.ReportData.CurrentPageIndex"
       data-pagesize="@Model.ReportData.PageSize"
       data-totalrecords="@Model.ReportData.TotalRecords"
       data-custid="@Model.CustId"
       data-fromdate="@Model.FromDate"
       data-todate="@Model.ToDate"
       data-sortedcolumn="@Model.SortPropertyName"
       data-descendingsort="@(Model.IsDescendingSort?1:0)">
    <thead>
        <tr>
            <th rowspan="2" data-sortedname="CustName">@Resources.Username</th>
            <th rowspan="2" data-sortedname="NumberOfTickets">@Resources.NoOfTickets</th>
            <th rowspan="2" class="hidden-stack-mode" data-sortedname="Turnover">@Resources.Turnover</th>
            <th rowspan="2" class="hidden-stack-mode col-netturnover-header" data-sortedname="NetTurnover">@Resources.NetTurnover</th>
            <th rowspan="2" class="hidden-stack-mode" data-sortedname="GrossComm">@Resources.GrossComm</th>
            <th rowspan="2" class="visible-stack-mode col-combine" data-sortedname="Turnover">@Html.Raw(Resources.TO_NetTO_GrossComm)</th>
            <th colspan="3" class="col-level">@Resources.Member</th>
            <th colspan="3" class="col-level">@Resources.Agent</th>
            <th colspan="3" class="col-level">@Resources.Master</th>
            <th colspan="3" class="col-level">@Resources.Super</th>
            <th rowspan="2" data-sortedname="Company">@Resources.Company</th>
        </tr>
        <tr class="RptHeader02">
            <th class="hidden-stack-mode col-winloss" data-sortedname="MemberWinLoss">@Resources.WinLoss</th>
            <th class="hidden-stack-mode" data-sortedname="MemberComm">@Resources.Comm</th>
            <th class="hidden-stack-mode" data-sortedname="MemberTotal">@Resources.Total</th>
            <th colspan="3" class="visible-stack-mode col-combine" data-sortedname="MemberWinLoss">@Html.Raw(Resources.WL_Comm_Total)</th>
            <th class="hidden-stack-mode col-winloss" data-sortedname="AgentWinLoss">@Resources.WinLoss</th>
            <th class="hidden-stack-mode" data-sortedname="AgentComm">@Resources.Comm</th>
            <th class="hidden-stack-mode" data-sortedname="AgentTotal">@Resources.Total</th>
            <th colspan="3" class="visible-stack-mode col-combine" data-sortedname="AgentWinLoss">@Html.Raw(Resources.WL_Comm_Total)</th>
            <th class="hidden-stack-mode col-winloss" data-sortedname="MasterWinLoss">@Resources.WinLoss</th>
            <th class="hidden-stack-mode" data-sortedname="MasterComm">@Resources.Comm</th>
            <th class="hidden-stack-mode" data-sortedname="MasterTotal">@Resources.Total</th>
            <th colspan="3" class="visible-stack-mode col-combine" data-sortedname="MasterWinLoss">@Html.Raw(Resources.WL_Comm_Total)</th>
            <th class="hidden-stack-mode col-winloss" data-sortedname="SuperWinLoss">@Resources.WinLoss</th>
            <th class="hidden-stack-mode" data-sortedname="SuperComm">@Resources.Comm</th>
            <th class="hidden-stack-mode" data-sortedname="SuperTotal">@Resources.Total</th>
            <th colspan="3" class="visible-stack-mode col-combine" data-sortedname="SuperWinLoss">@Html.Raw(Resources.WL_Comm_Total)</th>
        </tr>
    </thead>
    @if (Model.ReportData.DataSource.Any())
    {
        <tbody>
            @foreach (var data in Model.ReportData.DataSource.OrderBy(Model.SortPropertyName, Model.IsDescendingSort))
                { @GetRow(data, $"<a href='#{data.CustName}' class='downline-link' data-custid='{data.CustId}'>{data.CustName}</a>")
            }
        </tbody>
        <tfoot>
            @GetRow(Model.ReportData.Total, Model.ReportData.Total.CustName, "RptFooter")
        </tfoot>
    }
    else
    {
        <tbody>
            <tr>
                <td colspan="18" align="center">@Resources.NoInformationIsAvailable</td>
            </tr>
        </tbody>
    }
</table>
@if (Model.ReportData.DataSource.Any())
{
    @Components_Pager.Render()
}

@Html.Partial("~/Views/Shared/MonthNames.cshtml")
@Html.Hidden("ishistoricreport", Model.IsHistoricReport)
@Html.Hidden("currentpath", AppPathHelper.GetAppPath(HttpContext.Current.Request.ApplicationPath, "~/WinLossDetail/Master"))
@Html.Hidden("drilldownPath", AppPathHelper.GetAppPath(HttpContext.Current.Request.ApplicationPath, "~/WinLossDetail/Agent"))
@section Scripts {
    @AssetScripts.Render("/bundles/site-reports/default")
    @ReportsScripts.Render("~/assets/bundles/winlossdetail/winlossdetail")
}
