@using Alpha.Reports.Site.Helpers;
@using Alpha.Reports.Models.WinlossDetail;
@using Alpha.Reports.Site.ViewModels.WinLossDetail;
@using Alpha.Reports.Extensions;
@model WinLossDetailViewModel<MasterWinLossDetail>
@{
    ViewBag.Title = Resources.MasterWinLossDetail;
    var hasData = Model.ReportData.DataSource.Any();
}

@functions{
    static string FormatNumber(dynamic number)
    {
        return ((decimal)number).ToNumericString();
    }
}

@helper GetCombinedColumn(IEnumerable<decimal> columns, string css, int colspan)
{
    <td class="@css" colspan="@colspan">
        <ul>
            @foreach (var column in columns)
            {
                <li>@FormatNumber(column)</li>
            }
        </ul>
    </td>
}

@helper GetRow(MasterWinLossDetail data, string custName, string rowCss)
{
    <tr class="@rowCss">
        <td>@Html.Raw(custName)</td>
        <td class="text-right">@data.NumberOfTickets</td>
        @if (Model.IsStackMode)
        {
            @GetCombinedColumn(
                new List<decimal>() { data.Turnover, data.NetTurnover, data.GrossComm },
                "text-right visible-stack-mode combinedcolumn col-turnover-combined",
                1);
            @GetCombinedColumn(
                new List<decimal>() { data.MemberWinLoss, data.MemberComm, data.MemberTotal },
                "text-right visible-stack-mode combinedcolumn col-memberwinloss-combined",
                3);
            @GetCombinedColumn(
               new List<decimal>() { data.AgentWinLoss, data.AgentComm, data.AgentTotal },
               "text-right visible-stack-mode combinedcolumn col-agentwinloss-combined altercol ",
               3);
            @GetCombinedColumn(
               new List<decimal>() { data.MasterWinLoss, data.MasterComm, data.MasterTotal },
               "text-right visible-stack-mode combinedcolumn col-masterwinloss-combined",
               3);
            @GetCombinedColumn(
               new List<decimal>() { data.SuperWinLoss, data.SuperComm, data.SuperTotal },
               "text-right visible-stack-mode combinedcolumn col-superwinloss-combined altercol",
               3);
        }
        else
        {
            <td class="text-right hidden-stack-mode col-turnover">@FormatNumber(data.Turnover)</td>
            <td class="text-right hidden-stack-mode col-netturnover">@FormatNumber(data.NetTurnover)</td>
            <td class="text-right hidden-stack-mode col-grosscomm">@FormatNumber(data.GrossComm)</td>
            <td class="text-right hidden-stack-mode col-memberwinloss">@FormatNumber(data.MemberWinLoss)</td>
            <td class="text-right hidden-stack-mode col-membercomm">@FormatNumber(data.MemberComm)</td>
            <td class="text-right bold hidden-stack-mode col-membertotal">@FormatNumber(data.MemberTotal)</td>
            <td class="altercol text-right hidden-stack-mode col-agentwinloss">@FormatNumber(data.AgentWinLoss)</td>
            <td class="altercol text-right hidden-stack-mode col-agentcomm">@FormatNumber(data.AgentComm)</td>
            <td class="altercol bold text-right hidden-stack-mode col-agenttotal">@FormatNumber(data.AgentTotal)</td>
            <td class="text-right hidden-stack-mode col-masterwinloss">@FormatNumber(data.MasterWinLoss)</td>
            <td class="text-right hidden-stack-mode col-mastercomm">@FormatNumber(data.MasterComm)</td>
            <td class="bold text-right hidden-stack-mode col-mastertotal">@FormatNumber(data.MasterTotal)</td>
            <td class="altercol text-right hidden-stack-mode col-superwinloss">@FormatNumber(data.SuperWinLoss)</td>
            <td class="altercol text-right hidden-stack-mode col-supercomm">@FormatNumber(data.SuperComm)</td>
            <td class="altercol bold text-right hidden-stack-mode col-supertotal">@FormatNumber(data.SuperTotal)</td>
        }
        <td class="text-right">@FormatNumber(data.Company)</td>
    </tr>
}

@section Styles {
    @AssetStyles.Render("/bundles/site-reports/default")
    @ReportsStyles.Render("~/assets/bundles/default")
}

@Html.Partial("NetTurnoverTooltips", Model.NetTurnoverTooltips)
@Html.Partial("PageTitle", Model)
@Html.Partial("Filter", Model)

<table class="tblRpt tblRpt-bordered tblRpt-striped tblRpt-hover width-100per
        @(Model.IsStackMode?"stack-mode":string.Empty)" id="tbl-report"
       data-pageindex="@Model.ReportData.CurrentPageIndex"
       data-pagesize="@Model.ReportData.PageSize"
       data-totalrecords="@Model.ReportData.TotalRecords"
       data-custid="@Model.CustId"
       data-fromdate="@Model.FromDate"
       data-todate="@Model.ToDate"
       data-sortedcolumn="@Model.SortedColumn"
       data-sortdirection="@Model.SortDirection">
    <thead>
        <tr>
            <th rowspan="2">@Resources.Username <span class="icon-menu-up ascSorting"></span></th>
            <th rowspan="2">@Resources.NoOfTickets</th>
            <th rowspan="2" class="hidden-stack-mode">@Resources.Turnover</th>
            <th rowspan="2" class="hidden-stack-mode col-netturnover-header">@Resources.NetTurnover</th>
            <th rowspan="2" class="hidden-stack-mode">@Resources.GrossComm</th>
            <th rowspan="2" class="visible-stack-mode">@Resources.TO_NetTO_GrossComm</th>
            <th colspan="3" class="col-level">@Resources.Member</th>
            <th colspan="3" class="col-level">@Resources.Agent</th>
            <th colspan="3" class="col-level">@Resources.Master</th>
            <th colspan="3" class="col-level">@Resources.Super</th>
            <th rowspan="2">@Resources.Company</th>
        </tr>
        <tr class="RptHeader02">
            @for (var i = 0; i < 4; i++)
            {
                <th class="hidden-stack-mode col-winloss">@Resources.WinLoss</th>
                <th class="hidden-stack-mode">@Resources.Comm</th>
                <th class="hidden-stack-mode">@Resources.Total</th>
                <th colspan="3" class="visible-stack-mode col-combine">@Resources.WL_Comm_Total</th>
            }
        </tr>
    </thead>
    @if (Model.ReportData.DataSource.Any())
    {
        <tbody>
            @foreach (var data in Model.ReportData.DataSource)
                {
                @GetRow(
                    data,
                    $"<a href=\"#\" class=\"downline-link\" data-custid=\"{data.CustId}\">{data.CustName}</a>",
                    string.Empty)
            }
        </tbody>
        <tfoot>
            @GetRow(Model.ReportData.Total, Model.ReportData.Total.CustName, "RptFooter")
        </tfoot>
    }
    else
    {
        <tbody>
            <tr>
                <td colspan="18" align="center">@Resources.NoInformationIsAvailable</td>
            </tr>
        </tbody>
    }
</table>
@Html.Partial("Pager", Model.ReportData.DataSource.Any())

@Html.Partial("~/Views/Shared/MonthNames.cshtml")
@Html.Hidden("ishistoricreport", Model.IsHistoricReport)
@Html.Hidden("currentpath", AppPathHelper.GetAppPath(HttpContext.Current.Request.ApplicationPath, "~/WinLossDetail/Master"))
@Html.Hidden("drilldownPath", AppPathHelper.GetAppPath(HttpContext.Current.Request.ApplicationPath, "~/WinLossDetail/Agent"))
@section Scripts {
    @AssetScripts.Render("/bundles/site-reports/default")
    @ReportsScripts.Render("~/assets/bundles/winlossdetail/winlossdetail")
}
