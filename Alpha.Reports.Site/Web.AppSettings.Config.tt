<#@ template debug="true" hostspecific="true" language="C#" #>
<#@ output extension=".txt" #>
<#@ include file="$(SolutionDir)\Packages\T4.TemplateFileManager.2.2.1\tools\ttinc\TemplateFilemanager.CS.ttinclude" #>
<#@ include file="Web.AppSettings.Config.ttinclude" #>
<#
    var manager = TemplateFileManager.Create(this);

    foreach(var site in sites)
    {
        var fileTransform =  site.Environment == SiteEnvironment.none ? "" :"." + site.Environment;
        var fileName = string.Format("Web.AppSettings{0}.config", fileTransform);
        manager.StartNewFile(fileName);
#>
<appSettings>
  <add key="vs:EnableBrowserLink" value="false" />
  <add key="ClientValidationEnabled" value="true" />
  <add key="UnobtrusiveJavaScriptEnabled" value="true" />

  <add key="VirtualDirectory" value="site-reports" />
  <add key="ContentApp:StaticResourcesVersion" value="444"/>

  <add key="StoreProcedurePath" value="<#=site.StoreProcedurePath#>"/>
  <add key="Reports:Products" value="~/App_Data/products.json"/>
</appSettings><#
    }

    manager.Process();
#>