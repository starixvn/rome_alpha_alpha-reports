<#@ import namespace="System" #>
<#
    var sites = new SiteInfo[]{
         new SiteInfo
        {
            Environment = SiteEnvironment.none
        },
        new SiteInfo
        {
            Environment = SiteEnvironment.local
        },
        new SiteInfo
        {
            Environment = SiteEnvironment.napexternal
        },
        new SiteInfo
        {
            Environment = SiteEnvironment.napexternal2
        },
        new SiteInfo
        {
            Environment = SiteEnvironment.napinternal
        },
        new SiteInfo
        {
            Environment = SiteEnvironment.napinternal2
        },
        new SiteInfo
        {
            Environment = SiteEnvironment.pro
        },
        new SiteInfo
        {
            Environment = SiteEnvironment.pro2
        },
        new SiteInfo
        {
            Environment = SiteEnvironment.sit
        },
        new SiteInfo
        {
            Environment = SiteEnvironment.sit2
