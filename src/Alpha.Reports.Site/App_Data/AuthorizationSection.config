<?xml version="1.0"?>
<AuthorizationSection
  fullpermission="[A],[B],[C],[D],[E],[G],[H],[L]"
  custIdQueryStringParamNameMapping="custid,CustId,custId"
  custIdJsonParamNameMapping="txtCustomerObject,newCustomer"
  ignoreUrls=""
  cachedExpireTime="30"
  kickOutUrl="~/default/kickout">
  <!-- [E]: Reports -->
  <GroupPageAccess roleid="2" name="Agent">
    <PageAccesses>
      <add id="1.01.01" permission="[E]" mainfuncname="Report" subfuncname="Winloss Detail" url="WinLossDetail" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.01.02" permission="[E]" mainfuncname="Report" subfuncname="EnteredResult" url="EnteredResult" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.01.03" permission="[E]" mainfuncname="Report" subfuncname="Winloss" url="WinLoss" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.01.04" permission="[E]" mainfuncname="Report" subfuncname="Outstanding" url="Outstanding" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.01.05" permission="[E]" mainfuncname="Report" subfuncname="PlayForFun" url="PlayForFun" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.01.06" permission="[E]" mainfuncname="Statement" subfuncname="Statement" url="Statement" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.01.07" permission="[E]" mainfuncname="Report" subfuncname="Winloss By Product" url="WinLossByProduct" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.01.08" permission="[E]" mainfuncname="CommissionByBettype" subfuncname="CommissionByBettype" url="CommissionByBettype" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.01.09" permission="[E]" mainfuncname="RacingCommission" subfuncname="RacingCommission" url="RacingCommission" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.01.10" permission="[E]" mainfuncname="Report" subfuncname="Consolidation Detail" url="ConsolidationDetail" ischeckbelonging="false" isallowtodobythemselves="true" isviewedbygroupheadline="true" />

      <add id="1.01.11" permission="[E]" mainfuncname="Report" subfuncname="Consolidation" url="Consolidation/ConsolidationByUsername" ischeckbelonging="false" isallowtodobythemselves="true" />
      <add id="1.01.12" permission="[E]" mainfuncname="Report" subfuncname="Consolidation" url="Consolidation/ConsolidationByDate" ischeckbelonging="false" isallowtodobythemselves="true" />
      <add id="1.01.13" permission="[E]" mainfuncname="Report" subfuncname="Consolidation" url="Consolidation/ConsolidationByProduct" ischeckbelonging="false" isallowtodobythemselves="true" />
    </PageAccesses>
  </GroupPageAccess>

  <GroupPageAccess roleid="3" name="Master">
    <PageAccesses>
    </PageAccesses>
  </GroupPageAccess>

  <GroupPageAccess roleid="4" name="Super">
    <PageAccesses>
    </PageAccesses>
  </GroupPageAccess>
</AuthorizationSection>