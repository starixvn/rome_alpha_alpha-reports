      <Mapping DataField="TransferAmt" ObjectProperty="TransferAmount" />
      <Mapping DataField="WinLost" ObjectProperty="WinLoss" />
      <Mapping DataField="Comm" ObjectProperty="Commission" />
      <Mapping DataField="VoidAmt" ObjectProperty="VoidAmount" />
    </Setting>
    <Setting Key="Statement_Report_TransferDetails" SpName="Acc_StatementSelTransfer" DbName="DBACC.bodb02.BODBDownlineNetView" Plain="0">
      <Mapping DataField="ExRate" ObjectProperty="ExchangeRate" />
    </Setting>
  </Function>
  <Function Name="Bonus Detail">
    <Setting Key="Age_Rpt_BonusDetail_Super" SpName="Age_Rpt_BonusDetail_Super" DbName="DBACC.bodb02.BODBDownlineNetView" Plain="0" />
    <Setting Key="Age_Rpt_BonusDetail_Master" SpName="Age_Rpt_BonusDetail_Master" DbName="DBACC.bodb02.BODBDownlineNetView" Plain="0" />
    <Setting Key="Age_Rpt_BonusDetail_Agent" SpName="Age_Rpt_BonusDetail_Agent" DbName="DBACC.bodb02.BODBDownlineNetView" Plain="0" />
  </Function>

  <Function Name="Super Win Loss Detail By PT">
    <Setting Key="EAS_GetPTProductBySuper" SpName="EAS_GetPTProductBySuper" DbName="DBACC.bodb02.BODBDownlineNetView" />
