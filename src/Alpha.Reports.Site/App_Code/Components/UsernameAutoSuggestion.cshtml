@using Alpha.Reports.Site.App_GlobalResources;

@helper Render(string username)
{
    <div class="form-group">
        <label class="label-form-control">@Resources.Username</label>
        <div>
            <input type="text" id="txt-username" placeholder="@Resources.UsernameOrFirstLastName" autocomplete="off" value="@username" maxlength="50" />
        </div>
    </div>
}