@using Alpha.Reports.Site.App_GlobalResources;
@using Alpha.Reports.Site.ViewModels.Components;

@helper Render()
{
    <div class="form-group" id="product-multiselect-container">
        <label class="label-form-control">@Resources.Product</label>
        <div id="dropdown-product"
             data-label-selectall="@Resources.SelectAll"
             data-label-selected="@Resources.Selected"
             data-label-noneselected="@Resources.NoneSelected"
             data-label-all="@Resources.All"
             data-label-noitemfound="@Resources.NoProductFound"
             data-label-filterplaceholder="@Resources.SearchProduct"></div>
    </div>
}