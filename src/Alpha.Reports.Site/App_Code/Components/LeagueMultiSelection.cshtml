@using Alpha.Reports.Site.App_GlobalResources;
@using Alpha.Reports.Site.ViewModels.Components;

@helper Render(LeagueMultiSelectionViewModel model)
{
var isShowDropdown = !string.IsNullOrWhiteSpace(model.UserSelectedLeagueIds) || model.IsUserSelectsAllLeagues;
    <div id="dropdown-league-container" class="form-group product-multiselect-container product-multiselect-long">
        <div class="btn-group btn-loadleague-container">
            <button id="btn-loadleague" type="button" class="multiselect dropdown-toggle btn btn-default @(isShowDropdown ? "hide":string.Empty)" data-toggle="dropdown">
                <span class="multiselect-selected-text">@Resources.AllLeagues</span>
                <b class="caret"></b>
            </button>
        </div>
        <select id="dropdown-league"
                data-has-any-league="@model.Leagues.Any()"
                data-label-select-leagues="@Resources.SelectLeague"
                data-label-selected="@Resources.Selected"
                data-label-all-leagues="@Resources.AllLeagues"
                data-label-there-is-no-league="@Resources.ThereIsNoLeague"
                data-language="@model.Language"
                multiple="multiple" class="select-multiple @(isShowDropdown?string.Empty:"hide")">
            @foreach (var league in model.Leagues)
            {
            <option value="@league.Value" @(league.Selected ? " selected=\"selected\"" : string.Empty)>@league.Text</option>
            }
        </select>
        <input type="hidden" name="UserSelectedLeagueIds" id="league-ids" value="@model.UserSelectedLeagueIds" />
        <input type="hidden" name="IsUserSelectsAllLeagues" id="IsUserSelectsAllLeagues" value="@model.IsUserSelectsAllLeagues.ToString()" />
    </div>
}
