@using Alpha.Reports.Site.App_GlobalResources;
@using Alpha.Reports.Site.Features.Shared.ViewModels.Components;

@helper Render(IEnumerable<ProductViewModel> products, IEnumerable<ProductDetailNewViewModel> productDetails)
{
    <div class="form-group">
        <label class="label-form-control">@Resources.Product</label>
        <select class="select-multiple"
                id="dropdown-product-old"
                multiple
                data-label-select-products="@Resources.SelectProducts"
                data-label-selected="@Resources.Selected"
                data-label-all-products="@Resources.AllProducts"
                data-label-select-all="@Resources.SelectAll">
            @foreach (var group in products)
            {
                if (group.Products != null)
                {
                    <optgroup label="@group.Name">
                        @foreach (var product in group.Products)
                        {
                            <option value="@product.Id" selected data-isnested="1">@product.Name</option>
                        }
                    </optgroup>
                }
                else
                {
                    <option value="@group.Id" selected>@group.Name</option>
                }
            }
        </select>
    </div>
    <div class="form-group">
        <label class="label-form-control">@Resources.ProductDetail</label>
        <select class="select-multiple"
                id="dropdown-product-detail-old"
                multiple
                data-label-select-product-detail="@Resources.SelectNone"
                data-label-selected="@Resources.Selected"
                data-label-all-product-detail="@Resources.SelectAll">
            @foreach (var product in productDetails)
            {
                <option value="@product.Id" data-productid="@product.ProductId" selected>@product.Name </option>
            }
        </select>
    </div>
}