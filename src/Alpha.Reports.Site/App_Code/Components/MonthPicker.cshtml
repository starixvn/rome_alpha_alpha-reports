@using Alpha.Reports.Extensions;
@using Alpha.Reports.Site.ViewModels.Components;
@using Alpha.Reports.Utils;

@helper Render(MonthPickerViewModel model)
{
    <div class="form-group monthpicker-container">
        <div id="monthPickerID">
            <div id="dropdown-month"
                 data-longmonths-inyear="@model.MonthNames.JoinWithComma()"
                 data-mindate="@model.MinDate.ToShortDateWithSlash()"
                 data-maxdate="@SystemTime.Today.ToShortDateWithSlash()"
                 data-dateinmonth="@model.FromDate.ToShortDateWithSlash()"
                 data-fromdate="@model.FromDate.Day"
                 data-todate="@model.ToDate.Day"
                 data-currentdate="@SystemTime.Today.ToShortDateWithSlash()"></div>
        </div>
    </div>
    <input type="hidden" id="from-date" name="FromDate" value="@model.FromDate" />
    <input type="hidden" id="to-date" name="ToDate" value="@model.ToDate" />
}