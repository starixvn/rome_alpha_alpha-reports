@using Alpha.Reports.Site.ViewModels.Components

@helper Render(BreadcrumbLevelViewModel viewModel, string currentRequestUrl, IEnumerable<string> breadcrumbParamByLevel)
{
    var linkLength = viewModel.BreadcrumbLevel != null ? viewModel.BreadcrumbLevel.Count() : 0;
    var linkIndex = 0;
    var lastLinkIndex = linkLength - 1;

    if (linkLength > 0)
    {
        <div class="breadcrumb-container">
            <ul class="breadcrumb">
                @foreach (var custinfo in viewModel.BreadcrumbLevel)
                {
                    // TODO: Last customer just need to render by text, not link, will refactor soon
                    if (linkIndex == lastLinkIndex)
                    {
                        <li>
                            @(custinfo.CustName)
                        </li>
                    }
                    else
                    {
                        <li>
                            <a class="breadcrumb-link"
                               href="@(viewModel.BuildBreadcrumbLink(custinfo, currentRequestUrl, breadcrumbParamByLevel, linkIndex))">
                                @(custinfo.CustName)
                            </a>
                        </li>
                    }

                    linkIndex++;
                }
            </ul>
        </div>
        <script type="text/javascript">
            (function ($) {
                $.each($('.breadcrumb li'), function (index, element) {
                    $(element).text($(element).text().trim());
                });
            })(window.jQuery || window.parent.jQuery || window.top.jQuery);
        </script>
    }
}