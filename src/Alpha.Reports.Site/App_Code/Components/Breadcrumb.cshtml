@using Alpha.Reports.Models

@helper Render(IEnumerable<CustInfo> custInfoList, string currentRequestUrl)
{
var linkLength = custInfoList.Count();
var linkIndex = 0;

if (linkLength > 0)
{
        <div class="breadcrumb-container">
            <ul class="breadcrumb">
                @foreach (var custinfo in custInfoList)
                {
                    // TODO: Last customer just need to render by text, not link, will refactor soon
                    if (linkIndex == linkLength - 1)
                    {
                        <li>@(custinfo.CustName)</li>
                    }
                    else
                    {
                        <li>
                            <a data-cust-id="@(custinfo.CustId)"
                               data-cust-name="@(custinfo.CustName)"
                               data-cust-level-id="@(custinfo.CustLevelId)"
                               class="breadcrumb-link"
                               href="@(currentRequestUrl)">@(custinfo.CustName)</a>
                        </li>
                    }

                    linkIndex++;
                }
            </ul>
        </div>
}
}