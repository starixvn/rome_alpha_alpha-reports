@using Alpha.Reports.Site.ViewModels.Components

@helper Render(BreadcrumbLevelsViewModel viewModel, string currentRequestUrl)
{
var linkLength = viewModel.BreadcrumbLevels.Count();
var linkIndex = 0;

if (linkLength > 0)
{
        <div class="breadcrumb-container">
            <ul class="breadcrumb">
                @foreach (var custinfo in viewModel.BreadcrumbLevels)
                {
                    // TODO: Last customer just need to render by text, not link, will refactor soon
                    if (linkIndex == linkLength - 1)
                    {
                        <li>@(custinfo.CustName)</li>
                    }
                    else
                    {
                        <li>
                            <a class="breadcrumb-link"
                               href="@(viewModel.BuildBreadcrumbLink(custinfo, currentRequestUrl))">
                                @(custinfo.CustName)
                            </a>
                        </li>
                    }

                    linkIndex++;
                }
            </ul>
        </div>
}
}