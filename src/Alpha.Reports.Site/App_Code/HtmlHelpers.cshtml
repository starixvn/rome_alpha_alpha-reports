@using Alpha.Reports.Models
@using Alpha.Reports.Site.App_GlobalResources;

@helper FormatNumber(decimal value)
{
    @value.ToString("#,##0.00")
}

@helper FormatNumber(int value)
{
    @value.ToString("#,##0")
}

@helper FormatNullableNumber(decimal? value)
{
    if (value.HasValue)
    {
        @FormatNumber(value.Value)
    }
}

@helper RenderStackCell(string css, int colspan, params decimal[] cellValues)
{
    <td class="visible-stack-mode combinedcell @css" @(colspan > 1 ? "colspan=" + colspan : string.Empty)>
        <ul>
            @foreach (var cellValue in cellValues)
            {
                <li>@FormatNumber(cellValue)</li>
            }
        </ul>
    </td>
}

@helper RenderNumberCell(decimal cellValue, string cellClass = "")
{
    <td class="hidden-stack-mode @cellClass">
        @FormatNumber(cellValue)
    </td>
}

@helper DisplayUserLevelText(UserLevel userLevel)
{
if (userLevel.IsMemberLevel())
{
        @Resources.Member;
}

if (userLevel.IsAgentLevel())
{
        @Resources.Agent;
}

if (userLevel.IsMasterLevel())
{
        @Resources.Master;
}

if (userLevel.IsSuperLevel())
{
        @Resources.Super;
}
}