@model ProgressiveContributionViewModel
@{
    ViewBag.Title = "Progressive Games Contribution";
}
@ReportTitle.Render(new PageHeaderViewModel(Model.Title, true, true, Model.IsStackMode, Model.IsFilterVisible, null, null), Request.Url.Query)
<form class="form-inline filter  @(Model.IsFilterVisible ? string.Empty : "hide")" role="form" id="report-form">
    @Html.Hidden("IsFilterVisible", Model.IsFilterVisible ? "true" : "false")
    @Html.Hidden("CustId", Model.CustId)
    @Html.Hidden("CustLevelId", Model.CustLevel.Value)
    @Html.Hidden("IsStackMode", Model.IsStackMode)
    @ProductMultiSelection.Render(Model.ProductMultiSelectionViewModel)
    @DateRangePicker.Render(Model.DateRangePickerViewModel)
    <div id="icon-information-container" class="form-group hide">
        <span id="icon-information" class="icon-information-outline"></span>
    </div>
    <div class="form-group">
        <span id="icon-excel" class="icon-excel" title="@Resources.ExportToExcel"></span>
    </div>
    <div class="note">
        <span class="star">*</span>@Model.ViewDataInstructionMessage
    </div>
</form>
<table id="tbl-report" class="tblRpt tblRpt-bordered alternative-row-table width-100per tablesorter tblRpt-hover tbl-win-loss-by-product
       @(Model.IsStackMode ? "stack-mode" : string.Empty)">
    <thead>
        <tr>
            <th rowspan="2">@Resources.Product/@Resources.BetType</th>
            <th rowspan="2">@Resources.Turnover</th>
            <th rowspan="2">@Resources.ContributionAmount</th>
            <th colspan="@Model.ContributionShareColumnsCount">@Resources.ContributionShare</th>
            <th rowspan="2">@Resources.Company</th>
        </tr>
        <tr class="thead-row2">
            <th class="hidden-stack-mode">@Resources.Agent</th>
            @if (Model.CustLevel.IsMasterOrSuperLevel())
            {
                <th class="hidden-stack-mode">@Resources.Master</th>
            }
            @if (Model.CustLevel.IsSuperLevel())
            {
                <th class="hidden-stack-mode">@Resources.Super</th>
            }
        </tr>
    </thead>
    @if (Model.ProgressiveContributions.Any())
    {
        var progressiveContributions = Model.ProgressiveContributions.ToList();
        <tbody>
            @foreach (var data in progressiveContributions)
            {
                <tr class="product-row bold" data-product-id="@data.ProductId">
                    <td class="text-left col-username">@data.ProductName</td>
                    @RenderProgressiveContribution(data.Total)
                </tr>
                if (data.ProgressiveContributions.Any())
                {
                    foreach (var item in data.ProgressiveContributions)
                    {
                        <tr class="bet-type-row">
                            <td class="text-left col-username">@item.BetTypeName</td>
                            @RenderProgressiveContribution(item)
                        </tr>
                    }
                }
            }
        </tbody>
        <tfoot>
            <tr class="tbl-footer">
                <td class="text-left col-username">@Resources.Total</td>
                @RenderProgressiveContribution(Model.GrandTotal)
            </tr>
        </tfoot>
    }
    else
    {
        @NoInformation.Render(colspan: Model.ReportColumnsCount)
    }
</table>
<form class="form-inline hide" role="form" id="export-excel-form"
      action="@Url.Action("Excel", "ProgressiveContribution")">
    @Html.Hidden("CustId", Model.CustId)
    @Html.Hidden("FromDate", Model.FromDate)
    @Html.Hidden("ToDate", Model.ToDate)
    @Html.Hidden("UserSelectedProductIds", Model.UserSelectedProductIds)
    @Html.Hidden("CustLevelId", Model.CustLevel.Value)
</form>
@Html.Hidden("IsSetDefaultStackMode", Model.IsSetDefaultStackMode)
@Html.Hidden("LoadLegendURL", Url.Action("ReportLegend", "WinLossDetail"))
@section Scripts {
    @StaticResources.RenderScripts("~/assets/bundles/progressivecontribution/progressivecontribution")
}
@helper RenderProgressiveContribution(ProgressiveContributionByBetTypeModel data)
{
    @HtmlHelpers.RenderNumberCell(data.Turnover, "col-turnover")
    @RenderContributionNumberCell(data.ContributionAmount, "col-turnover")
    @RenderContributionNumberCell(data.AgentContribution, "col-turnover")
if (Model.CustLevel.IsMasterOrSuperLevel())
{
        @RenderContributionNumberCell(data.MasterContribution, "col-turnover")
}
if (Model.CustLevel.IsSuperLevel())
{
        @RenderContributionNumberCell(data.SuperContribution, "col-turnover")
}
    @RenderContributionNumberCell(data.CompanyContribution, "col-turnover")
}
@helper RenderContributionNumberCell(decimal value, string cellClass = "")
{
    <td class="hidden-stack-mode @cellClass">
        @value.ToString("#,##0.0000")
    </td>
}
