@model WinLossAnalysisViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Win Loss Analysis Report";
}
@section Styles {
    @StaticResources.AssetStyles.Render("/bundles-v2/site-reports/winlossdetailnew")
    @StaticResources.RenderStyles("~/assets/bundles-v2/winlossdetailnew")
}
@ReportTitle.Render(new PageHeaderViewModel(Model.Title, true, true, Model.IsStackMode, Model.IsFilterVisible, Enumerable.Empty<CustInfo>(), string.Empty), Request.Url.Query)

@Html.Partial("Filter", Model.FilterViewModel,
    new ViewDataDictionary
    {
        { "IsStackMode", Model.IsStackMode },
        { "IsDescendingSort", Model.IsDescendingSort },
        { "SortPropertyName", Model.SortPropertyName },
        { "ReportTypeId", Model.ReportTypeId },
        { "ReportTypeName", Model.ReportTypeName }
    })

<table class="tb tb-bordered w-full tablesorter tb-hover
       @(Model.IsStackMode ? "stack-mode" : string.Empty)" id="tbl-report"
       data-totalrecords="@Model.ReportData.Count()"
       data-custid="@Model.CustId"
       data-sortedcolumn="@Model.SortPropertyName"
       data-descendingsort="@Model.IsDescendingSort">
    <thead>
        <tr>
            <th class="sorting" rowspan="2" data-sortedname="@Model.SortPropertyNameDefault" data-colindex="0">@Model.ReportTypeName</th>
            <th class="sorting" rowspan="2" data-sortedname="BetCount" data-colindex="1">@Resources.BetCount</th>
            <th class="sorting" rowspan="2" data-sortedname="Turnover" data-colindex="2">@Resources.Turnover</th>

            <th colspan="3" class="col-level hidden-stack-mode">@Resources.Member</th>
            <th class="visible-stack-mode col-combine sorting" data-sortedname="MemberNetWinLoss.WinLoss" rowspan="2" data-colindex="3">
                @Resources.Member
                <br />
                (<span class="prior-sortedcolumn">@Resources.WinLossAbbr</span>@Resources.CommAndTotal)
            </th>

            <th colspan="3" class="col-level hidden-stack-mode">@Resources.Agent</th>
            <th class="visible-stack-mode col-combine sorting" data-sortedname="AgentNetWinLoss.WinLoss" rowspan="2" data-colindex="4">
                @Resources.Agent
                <br />
                (<span class="prior-sortedcolumn">@Resources.WinLossAbbr</span>@Resources.CommAndTotal)
            </th>

            @if (Model.CustLevel.IsMasterOrSuperLevel())
            {
                <th colspan="3" class="col-level hidden-stack-mode">@Resources.Master</th>
                <th class="visible-stack-mode col-combine sorting" data-sortedname="MasterNetWinLoss.WinLoss" rowspan="2" data-colindex="5">
                    @Resources.Master
                    <br />
                    (<span class="prior-sortedcolumn">@Resources.WinLossAbbr</span>@Resources.CommAndTotal)
                </th>
            }

            @if (Model.CustLevel.IsSuperLevel())
            {
                <th colspan="3" class="col-level hidden-stack-mode">@Resources.Super</th>
                <th class="visible-stack-mode col-combine sorting" data-sortedname="SuperNetWinLoss.WinLoss" rowspan="2" data-colindex="6">
                    @Resources.Super
                    <br />
                    (<span class="prior-sortedcolumn">@Resources.WinLossAbbr</span>@Resources.CommAndTotal)
                </th>
            }

            @if (Model.CustLevel.IsAgentLevel())
            {
                <th class="sorting hidden-stack-mode" rowspan="2" data-sortedname="Company" data-colindex="9">@Resources.Company</th>
                <th class="sorting visible-stack-mode" rowspan="2" data-sortedname="Company" data-colindex="5">@Resources.Company</th>
            }
            else if (Model.CustLevel.IsMasterLevel())
            {
                <th class="sorting hidden-stack-mode" rowspan="2" data-sortedname="Company" data-colindex="12">@Resources.Company</th>
                <th class="sorting visible-stack-mode" rowspan="2" data-sortedname="Company" data-colindex="6">@Resources.Company</th>
            }
            else
            {
                <th class="sorting hidden-stack-mode" rowspan="2" data-sortedname="Company" data-colindex="15">@Resources.Company</th>
                <th class="sorting visible-stack-mode" rowspan="2" data-sortedname="Company" data-colindex="7">@Resources.Company</th>
            }
        </tr>
        <tr class="thead-row2">
            <th class="hidden-stack-mode col-winloss sorting" data-sortedname="MemberNetWinLoss.WinLoss" data-colindex="3">@Resources.WinLoss</th>
            <th class="hidden-stack-mode sorting" data-sortedname="MemberNetWinLoss.Comm" data-colindex="4">@Resources.Comm</th>
            <th class="hidden-stack-mode sorting" data-sortedname="MemberNetWinLoss.Total" data-colindex="5">@Resources.Total</th>

            <th class="hidden-stack-mode col-winloss sorting" data-sortedname="AgentNetWinLoss.WinLoss" data-colindex="6">@Resources.WinLoss</th>
            <th class="hidden-stack-mode sorting" data-sortedname="AgentNetWinLoss.Comm" data-colindex="7">@Resources.Comm</th>
            <th class="hidden-stack-mode sorting" data-sortedname="AgentNetWinLoss.Total" data-colindex="8">@Resources.Total</th>
            @if (Model.CustLevel.IsMasterOrSuperLevel())
            {
                <th class="hidden-stack-mode col-winloss sorting" data-sortedname="MasterNetWinLoss.WinLoss" data-colindex="9">@Resources.WinLoss</th>
                <th class="hidden-stack-mode sorting" data-sortedname="MasterNetWinLoss.Comm" data-colindex="10">@Resources.Comm</th>
                <th class="hidden-stack-mode sorting" data-sortedname="MasterNetWinLoss.Total" data-colindex="11">@Resources.Total</th>
            }

            @if (Model.CustLevel.IsSuperLevel())
            {
                <th class="hidden-stack-mode col-winloss sorting" data-sortedname="SuperNetWinLoss.WinLoss" data-colindex="12">@Resources.WinLoss</th>
                <th class="hidden-stack-mode sorting" data-sortedname="SuperNetWinLoss.Comm" data-colindex="13">@Resources.Comm</th>
                <th class="hidden-stack-mode sorting" data-sortedname="SuperNetWinLoss.Total" data-colindex="14">@Resources.Total</th>
            }
        </tr>
    </thead>
    @if (Model.ReportData.Any())
    {
        <tbody>
            @foreach (var data in Model.ReportData)
            {
                @RenderRow(data, false)
            }
        </tbody>
        <tfoot>
            @RenderRow(Model.GrandTotal, true)
        </tfoot>
    }
    else
    {
        @NoInformation.Render(colspan:
            Model.CustLevel.IsSuperLevel()
            ? 16
            : (Model.CustLevel.IsMasterLevel() ? 13 : 10))
    }
</table>

<form class="form-inline hide" role="form" id="export-excel-form"
      action="@Url.Action("Excel", $"{Alpha.Reports.Configurations.SiteSettings.ReportRouting}WinLossAnalysis")">
    @Html.HiddenFor(model => model.CustId)
    @Html.HiddenFor(model => model.CustName)
    @Html.HiddenFor(model => model.ToDate)
    @Html.HiddenFor(model => model.FromDate)
    @Html.HiddenFor(model => model.UserSelectedProductIds)
    @Html.Hidden("CustLevelId", Model.CustLevel.Value)
    <input name="ReportTypeId" value="@Model.ReportTypeId" type="hidden">
    <input name="ReportTypeTitle" value="@Model.Title" type="hidden">
    <input name="ReportTypeName" value="@Model.ReportTypeName" type="hidden">
</form>

@Html.HiddenFor(model => model.IsSetDefaultStackMode)
@Html.Hidden("LoadLegendURL", Url.Action("Index", $"{Alpha.Reports.Configurations.SiteSettings.ReportRouting}ReportLegend", new { MinDate = Model.MinDate }))

@section Scripts {
    @StaticResources.RenderScripts($"~/{Alpha.Reports.Configurations.SiteSettings.ReportRouting}assets/bundles/winlossanalysis/winlossanalysis")
}

@helper RenderRow(WinLossAnalysisModel data, bool isTotalRow)
{
    <tr class="@(isTotalRow ? "tbl-footer" : string.Empty)">
        <td class="text-left col-username" data-isdatetime="true">
            @(isTotalRow ? Resources.Total : data.RollupKey)
        </td>
        <td>@data.BetCount.ToString($"#,##0")</td>
        <td>@data.Turnover.FormatNumber()</td>

        @if (Model.IsStackMode)
        {
            @RenderStackNetWinLoss(UserLevel.Member, data.MemberNetWinLoss);
            @RenderStackNetWinLoss(UserLevel.Agent, data.AgentNetWinLoss, isHighlight: true);
            @RenderStackNetWinLoss(UserLevel.Master, data.MasterNetWinLoss);
            @RenderStackNetWinLoss(UserLevel.Super, data.SuperNetWinLoss, isHighlight: true);
        }
        else
        {

            @RenderNetWinLoss(UserLevel.Member, data.MemberNetWinLoss)
            @RenderNetWinLoss(UserLevel.Agent, data.AgentNetWinLoss, isHighlight: true)
            @RenderNetWinLoss(UserLevel.Master, data.MasterNetWinLoss)
            @RenderNetWinLoss(UserLevel.Super, data.SuperNetWinLoss, isHighlight: true)
        }
        <td class="col-company">@HtmlHelpers.FormatNumber(data.Company)</td>
    </tr>
}

@helper RenderStackNetWinLoss(UserLevel level, NetWinLoss netWinLoss, bool isHighlight = false)
{
    if (netWinLoss == null)
    {
        return;
    }

    var highlightCellClass = isHighlight ? "altercol" : string.Empty;

    @HtmlHelpers.RenderStackCell(
            $"col-{level.DisplayName.ToLower()}-winloss-combined {highlightCellClass}",
            1,
            netWinLoss.WinLoss.Value,
            netWinLoss.Comm.Value,
            netWinLoss.Total);
}

@helper RenderNetWinLoss(UserLevel level, NetWinLoss netWinLoss, bool isHighlight = false)
{
    if (netWinLoss == null)
    {
        return;
    }

    var highlightCellClass = isHighlight ? "altercol" : string.Empty;

    @HtmlHelpers.RenderNumberCell(netWinLoss.WinLoss.Value, $"col-{level.DisplayName.ToLower()}-winloss {highlightCellClass}")
    @HtmlHelpers.RenderNumberCell(netWinLoss.Comm.Value, highlightCellClass)
    @HtmlHelpers.RenderNumberCell(netWinLoss.Total, $"bold {highlightCellClass}")
}
