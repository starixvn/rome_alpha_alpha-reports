@model WinLossByBettypeViewModel

@ReportTitle.Render(new PageHeaderViewModel(Model.Title, true, true, Model.IsStackMode, Model.IsFilterVisible, Enumerable.Empty<CustInfo>(), string.Empty), Request.Url.Query)

@Html.Partial("Filter", Model.FilterViewModel,
    new ViewDataDictionary
    {
        { "IsStackMode", Model.IsStackMode },
        { "IsDescendingSort", Model.IsDescendingSort },
        { "SortPropertyName", Model.SortPropertyName }
    })
<table class="tblRpt tblRpt-bordered tblRpt-striped width-100per tablesorter tblRpt-hover
       @(Model.IsStackMode ? "stack-mode" : string.Empty)" id="tbl-report"
       data-totalrecords="@Model.ReportData.Count()"
       data-custid="@Model.CustId"
       data-sortedcolumn="@Model.SortPropertyName"
       data-descendingsort="@Model.IsDescendingSort">
    <thead>
        <tr>
            <th class="sorting" rowspan="2" data-sortedname="CustName" data-colindex="0">Bet Type</th>
            <th class="sorting" rowspan="2" data-sortedname="CustName" data-colindex="1">Bet Count</th>
            <th rowspan="2" class="hidden-stack-mode sorting" data-sortedname="Turnover" data-colindex="2">@Resources.Turnover</th>
            <th rowspan="2" class="hidden-stack-mode sorting" data-sortedname="GrossComm" data-colindex="3">@Resources.GrossComm</th>
            <th rowspan="2" class="visible-stack-mode col-combine sorting" data-sortedname="Turnover" data-colindex="2">
                <span class="prior-sortedcolumn">@Resources.TurnoverAbbr</span>
                @(Model.CustLevel.IsAgentLevel() ? Resources.GrossComm :
                  (Model.CustLevel.IsSuperLevel() ? Resources.GrossComAndMasterTotal : Resources.GrossComAndAgentTotal))
            </th>

            @if (Model.CustLevel.IsSuperLevel())
            {
                <th rowspan="2" class="hidden-stack-mode sorting" data-sortedname="MasterNetWinLoss.WinLoss" data-colindex="3">@Resources.MasterTotal</th>
            }

            @if (Model.CustLevel.IsMasterLevel())
            {
                <th rowspan="2" class="hidden-stack-mode sorting" data-sortedname="AgentNetWinLoss.WinLoss" data-colindex="3">@Resources.AgentTotal</th>
            }

            @if (Model.CustLevel.IsAgentLevel())
            {
                <th colspan="3" class="col-level hidden-stack-mode">@Resources.Member</th>
                <th class="visible-stack-mode col-combine sorting" data-sortedname="MemberNetWinLoss.WinLoss" rowspan="2" data-colindex="3">
                    @Resources.Member
                    <br />
                    (<span class="prior-sortedcolumn">@Resources.WinLossAbbr</span>@Resources.CommAndTotal)
                </th>
                <th colspan="3" class="col-level hidden-stack-mode">Bet Type</th>
                <th class="visible-stack-mode col-combine sorting" data-sortedname="AgentNetWinLoss.WinLoss" rowspan="2" data-colindex="4">
                    Bet Type
                    <br />
                    (<span class="prior-sortedcolumn">@Resources.WinLossAbbr</span>@Resources.CommAndTotal)
                </th>
                <th class="sorting hidden-stack-mode" rowspan="2" data-sortedname="Company" data-colindex="10">@Resources.Company</th>
                <th class="sorting visible-stack-mode" rowspan="2" data-sortedname="Company" data-colindex="5">@Resources.Company</th>
            }
            else
            {
                <th colspan="3" class="col-level hidden-stack-mode">Bet Type</th>
                <th class="visible-stack-mode col-combine sorting" data-sortedname="" rowspan="2" data-colindex="3">
                    Bet Type
                    <br />
                    (<span class="prior-sortedcolumn">@Resources.WinLossAbbr</span>@Resources.CommAndTotal)
                </th>
                <th class="sorting hidden-stack-mode" rowspan="2" data-sortedname="Company" data-colindex="8">@Resources.Company</th>
                <th class="sorting visible-stack-mode" rowspan="2" data-sortedname="Company" data-colindex="4">@Resources.Company</th>
            }
        </tr>
        <tr class="thead-row2">
            @if (Model.CustLevel.IsAgentLevel())
            {
                <th class="hidden-stack-mode col-winloss sorting" data-sortedname="MemberNetWinLoss.WinLoss" data-colindex="4">@Resources.WinLoss</th>
                <th class="hidden-stack-mode sorting" data-sortedname="MemberNetWinLoss.Comm" data-colindex="5">@Resources.Comm</th>
                <th class="hidden-stack-mode sorting" data-sortedname="MemberNetWinLoss.Total" data-colindex="6">@Resources.Total</th>

                <th class="hidden-stack-mode col-winloss sorting" data-sortedname="" data-colindex="7">@Resources.WinLoss</th>
                <th class="hidden-stack-mode sorting" data-sortedname="" data-colindex="8">@Resources.Comm</th>
                <th class="hidden-stack-mode sorting" data-sortedname="" data-colindex="9">@Resources.Total</th>
            }
            else
            {
                <th class="hidden-stack-mode col-winloss sorting" data-sortedname="" data-colindex="5">@Resources.WinLoss</th>
                <th class="hidden-stack-mode sorting" data-sortedname="" data-colindex="6">@Resources.Comm</th>
                <th class="hidden-stack-mode sorting" data-sortedname="" data-colindex="7">@Resources.Total</th>
            }
        </tr>
    </thead>
    @if (Model.ReportData.Any())
    {
        <tbody>
            @foreach (var data in Model.ReportData)
            {
                @RenderRow(data, false, string.Empty)
            }
        </tbody>
        <tfoot>
            @RenderRow(Model.GrandTotal, true, ViewBag.BetListPath)
        </tfoot>
    }
    else
    {
        @NoInformation.Render(colspan: Model.CustLevel.IsAgentLevel() ? 11 : 9)
    }
</table>

<form class="form-inline hide" role="form" id="export-excel-form" action="~/WinLossByBettype/Excel">
    <input type="hidden" name="CustId" value="@Model.CustId" />
    <input type="hidden" name="FromDate" value="@Model.FromDate" />
    <input type="hidden" name="ToDate" value="@Model.ToDate" />
    <input type="hidden" name="CustLevelId" value="@Model.CustLevel.Value" />
</form>

@Html.Hidden("IsSetDefaultStackMode", Model.IsSetDefaultStackMode)

@section Scripts {
    @StaticResources.RenderScripts("~/assets/bundles/winlossbybettype/winlossbybettype")
}

@helper RenderRow(WinLossByBetTypeModel data, bool isTotalRow, string betListPath)
{
    <tr @(isTotalRow ? "class=tbl-footer" : string.Empty)>
        <td data-islink="true" class="text-left col-username">
            @if (isTotalRow)
            {
                @Resources.Total
            }
            else
            {
                <a href=""
                   class="@(Model.CustLevel.IsAgentLevel() ? string.Empty : "downline-link")"
                   data-custname="@data.BetTypeName">
                    @data.BetTypeName
                </a>
            }
        </td>

        <td>@data.BetCount</td>

        @if (Model.IsStackMode)
        {
            if (Model.CustLevel.IsAgentLevel())
            {
                @HtmlHelpers.RenderStackCell("col-turnover-combined", 1, data.Turnover, data.GrossComm);

            }
            else
            {
                @HtmlHelpers.RenderStackCell("col-turnover-combined", 1, data.Turnover, data.GrossComm,
                                            Model.CustLevel.IsSuperLevel() ? data.MasterNetWinLoss.Total : data.AgentNetWinLoss.Total);
            }

            @RenderStackNetWinLoss(UserLevel.Member, data.MemberNetWinLoss);
            @RenderStackNetWinLoss(UserLevel.Agent, data.AgentNetWinLoss, isHighlight: true);
            @RenderStackNetWinLoss(UserLevel.Master, data.MasterNetWinLoss);
            @RenderStackNetWinLoss(UserLevel.Super, data.SuperNetWinLoss, isHighlight: true);
        }
        else
        {
            @HtmlHelpers.RenderNumberCell(data.Turnover, "col-turnover")
            @HtmlHelpers.RenderNumberCell(data.GrossComm, "col-gross-com")

            @RenderNetWinLoss(UserLevel.Member, data.MemberNetWinLoss)
            @RenderNetWinLoss(UserLevel.Agent, data.AgentNetWinLoss, Model.CustLevel.IsAgentLevel())
            @RenderNetWinLoss(UserLevel.Master, data.MasterNetWinLoss, Model.CustLevel.IsMasterLevel())
            @RenderNetWinLoss(UserLevel.Super, data.SuperNetWinLoss, isHighlight: true)
        }
        <td class="text-right col-company">@HtmlHelpers.FormatNumber(data.Company)</td>
    </tr>
}

@helper RenderStackNetWinLoss(UserLevel level, NetWinLoss netWinLoss, bool isHighlight = false)
{
if (netWinLoss == null)
{
    return;
}

var highlightCellClass = isHighlight ? "altercol" : string.Empty;

if (netWinLoss.WinLoss != null)
{
        @HtmlHelpers.RenderStackCell(
        $"col-{level.DisplayName.ToLower()}-winloss-combined {highlightCellClass}",
        1,
        netWinLoss.WinLoss.Value,
        netWinLoss.Comm.Value,
        netWinLoss.Total);
}
}

@helper RenderNetWinLoss(UserLevel level, NetWinLoss netWinLoss, bool isHighlight = false)
{
if (netWinLoss == null)
{
    return;
}

var highlightCellClass = isHighlight ? "altercol" : string.Empty;
if (netWinLoss.WinLoss != null)
{
        @HtmlHelpers.RenderNumberCell(netWinLoss.WinLoss.Value, $"col-{level.DisplayName.ToLower()}-winloss {highlightCellClass}")
        @HtmlHelpers.RenderNumberCell(netWinLoss.Comm.Value, highlightCellClass)
}

    @HtmlHelpers.RenderNumberCell(netWinLoss.Total, $"bold {highlightCellClass} col-cust-total")
}