@using Alpha.Reports.Site.Helpers
@using Alpha.Reports.Site.Configurations

@model EnteredResultViewModel

@Html.Partial("_PageTitle", new PageHeaderViewModel(Model.Title, false, true, false, false, new List<ActionLinkViewModel>()))
@Html.Partial("_EnteredResultFilter", Model.FilterViewModel)
<table class="tblRpt tblRpt-bordered tblRpt-striped tblRpt-hover width-100per tablesorter" id="tbl-report"
       data-totalrecords="@Model.ReportData.Count()">
    <thead>
        <tr>
            <th>@Resources.Date</th>
            <th colspan="2">@DateTime.Now.AddDays(-1).ToShortDateWithSlash()</th>
            <th colspan="2">@DateTime.Now.ToShortDateWithSlash()</th>
        </tr>
        <tr class="thead-row2">
            <th class="sorting" data-colindex="0">@Resources.Results</th>
            <th class="sorting width-15per" data-colindex="1">@Resources.Entered</th>
            <th class="sorting width-15per" data-colindex="2">@Resources.NonEntered</th>
            <th class="sorting width-15per" data-colindex="3">@Resources.Entered</th>
            <th class="sorting width-15per" data-colindex="4">@Resources.NonEntered</th>
        </tr>
    </thead>
    @if (Model.ReportData.Any())
    {
        <tbody>
            @foreach (var enteredSportResult in Model.ReportData)
            {
                <tr>
                    <td class="text-left col-first">@enteredSportResult.SportName</td>
                    @RenderEnteredResult(enteredSportResult.EnteredSportYesterday)
                    @RenderEnteredResult(enteredSportResult.EnteredSportToday)
                </tr>
            }
        </tbody>
    }
    else
    {
        @NoInformation.Render(5)
    }
</table>

<form class="form-inline hide" role="form" id="export-excel-form" action="~/EnteredResult/Excel">
    <input type="hidden" name="FromDate" value="@Model.FromDate" />
    <input type="hidden" name="ToDate" value="@Model.ToDate" />
</form>


@section Scripts {
    @StaticResources.RenderScripts("~/assets/bundles/winloss/enteredresult")
}

@helper RenderEnteredResult(DailyEnteredSport enteredSportDaily)
{
if (enteredSportDaily == null)
{
        <td>0</td>
        <td>0</td>
    return;
}

<td>@enteredSportDaily.Entered</td>
<td>@enteredSportDaily.NonEntered</td>
}
