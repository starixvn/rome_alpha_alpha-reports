@model ConsolidationDetailViewModel
@{
    ViewBag.Title = "Consolidation Report";
    var filter = Model.FilterViewModel;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    @StaticResources.AssetStyles.Render("/bundles-v2/site-reports/consolidation")
    @StaticResources.RenderStyles("~/assets/bundles-v2/winlossdetailnew")
}
<div class="title-has-entered">
@ReportTitle.Render(
    new PageHeaderViewModel(Resources.Consolidation, true, true, Model.IsStackMode, filter.Visible, Model.BreadcrumbLevel, Model.BreadcrumbLevelJson),
    Request.Url.Query,
    Model.BreadcrumbActions,
    hasEnterOrNonEnterNote: true,
    enteredSportResult: Model.TotalEnteredSport)
</div>
<form class="form-inline filter  @(filter.Visible ? string.Empty : "hide")" role="form" id="report-form">
    @ProductMultiSelection.Render(filter.ProductMultiSelectionViewModel)
    @ProductDetailMultiSelection.Render(filter.ProductDetailMultiSelectionViewModel)
    @LevelTypeDropdown.Render(Model.CustLevel, Model.LevelType)
    @DateRangePicker.Render(filter.DateRangePickerViewModel)

    <div class="form-group form-group-short">
        <span id="icon-information" class="ic-information"></span>
    </div>
    <div class="form-group">
        <span id="icon-excel" class="ic-excel" title="@Resources.ExportToExcel"></span>
    </div>

    @Html.Hidden("IsFilterVisible", filter.Visible ? "true" : "false")
    @Html.Hidden("IsStackMode", ViewData["IsStackMode"] as bool?)
    @Html.Hidden("CustId", Model.WinLossDetailViewModel.CustId)
    @Html.Hidden("CustName", Model.WinLossDetailViewModel.CustName)
    @Html.Hidden("CustLevelId", Model.WinLossDetailViewModel.CustLevel.Value)
    @Html.Hidden("SortPropertyNa.me", Model.SortPropertyName)
    @Html.Hidden("IsDescendingSort", Model.IsDescendingSort)

    @Html.Hidden("DrilldownFromType", Model.DrilldownFromType)
    @Html.Hidden("UserSelectedCurrencyId", Model.UserSelectedCurrencyId)
    @Html.Hidden("BreadcrumbLevelJson", Model.BreadcrumbLevelJson)
    @Html.Hidden("ConsolidationFromDate", Model.ConsolidationFromDate)
    @Html.Hidden("ConsolidationToDate", Model.ConsolidationToDate)
    @Html.Hidden("ConsolidationUserSelectedDateRangeOption", Model.ConsolidationUserSelectedDateRangeOption)
    @Html.Hidden("ConsolidationProductIds", Model.ConsolidationProductIds)
    @Html.Hidden("ConsolidationResourceIds", Model.ConsolidationResourceIds)
    @Html.Hidden("IsPostBack", "true")
</form>

@Html.Partial(
    "~/Features/WinLossDetail/Views/ReportData.cshtml",
    Model.WinLossDetailViewModel,
    new ViewDataDictionary
    {
        ["ExportExcelController"] = "Consolidation",
        ["ExportExcelAction"] = "ConsolidationDetailExcel"
    })

@Html.Hidden("LoadLegendURL", Url.Action("ReportDetailLegend", $"{Alpha.Reports.Configurations.SiteSettings.ReportRouting}Consolidation", new { CustLevelId = Model.WinLossDetailViewModel.CustLevel.Value, IsSupportHistoricReport = true, IsHistoricReport = Model.IsHistoricReport, MinDate = Model.MinDate }))

@section Scripts {
    @StaticResources.RenderScripts($"~/{Alpha.Reports.Configurations.SiteSettings.ReportRouting}assets/bundles/consolidation/consolidation-detail")
}