@model ConsolidationReportByUsernameViewModel
@{
    ViewBag.Title = "Consolidation Report";
    Layout = "~/Views/Shared/_Layout2.cshtml";
}

@section Styles {
    @StaticResources.AssetStyles.Render("/bundles-v2/site-report/consolidation")
    @StaticResources.RenderStyles("~/assets/bundles-v2/winlossdetailnew")
    @**StaticResources.RenderStyles("~/assets/bundles-v2/consolidation")*@
}

@ReportTitle.Render(new PageHeaderViewModel(Resources.Consolidation, true, true, Model.IsStackMode, Model.IsFilterVisible, null, null), Request.Url.Query,
    hasEnterOrNonEnterNote: true,
    enteredSportResult: Model.TotalEnteredSport)

@Html.Partial("Filter", Model.FilterViewModel,
    new ViewDataDictionary
    {
        ["IsStackMode"] = Model.IsStackMode,
        ["ReportType"] = "Username"
    })

<table class="tb tb-bordered tb-hover w-full text-right @(Model.IsStackMode ? "stack-mode" : string.Empty)" id="tbl-report">
    <thead>
        <tr>
            <th rowspan="2" class="hidden-stack-mode">@Resources.Level</th>
            <th class="visible-stack-mode">@Resources.Level</th>
            <th rowspan="2" class="hidden-stack-mode">@Resources.UsernamePTProduct</th>
            <th class="visible-stack-mode">@Resources.Username</th>
            <th rowspan="2" class="hidden-stack-mode">@Resources.Currency</th>
            <th class="visible-stack-mode">@Resources.Currency</th>
            <th rowspan="2" class="hidden-stack-mode">@Resources.Turnover</th>
            <th class="visible-stack-mode">@Resources.Turnover</th>
            <th rowspan="2" class="hidden-stack-mode">@Resources.GrossComm</th>
            <th class="visible-stack-mode">@Resources.GrossComm</th>
            <th colspan="3" class="hidden-stack-mode">@Resources.Member</th>
            <th class="visible-stack-mode">
                @Resources.Member
                <br />
                (@Resources.WinLossAbbr/@Resources.Comm/@Resources.Total)
            </th>
            <th colspan="4" class="hidden-stack-mode">@Resources.Owner</th>
            <th class="visible-stack-mode">
                @Resources.Owner
                <br />
                (@Resources.TurnoverAbbr/@Resources.WinLossAbbr/@Resources.Comm/@Resources.Total)
            </th>
            <th rowspan="2">@Resources.Company</th>
            <th rowspan="2">@Resources.BetCount</th>
        </tr>
        <tr class="thead-row2">
            <th class="hidden-stack-mode">@Resources.WinLoss</th>
            <th class="hidden-stack-mode">@Resources.Comm</th>
            <th class="hidden-stack-mode">@Resources.Total</th>
            <th class="hidden-stack-mode">@Resources.Turnover</th>
            <th class="hidden-stack-mode">@Resources.WinLoss</th>
            <th class="hidden-stack-mode">@Resources.Comm</th>
            <th class="hidden-stack-mode">@Resources.Total</th>
        </tr>
    </thead>
    @if (Model.ReportData.Any())
    {
        <tbody>
            @foreach (var dataByUsername in Model.ReportData)
            {
                var isShowPT = dataByUsername.CustLevel != UserLevel.Member.Value;
                <tr class="username-row" data-custid="@dataByUsername.CustId">
                    <td class=" text-left bold ">
                        <div class="username-col">
                            <span class="ic-arrow-right" id="icon-@dataByUsername.CustId"></span>
                            @dataByUsername.CustLevelName
                        </div>
                    </td>
                    <td class="text-left bold">
                        <div>
                            <div class="text-icon">
                                <a href="@Model.BuildDrillDownLink(Url.Action("ConsolidationDetail", $"{Alpha.Reports.Configurations.SiteSettings.ReportRouting}Consolidation"), "username", null, null, dataByUsername)" class="downline-link">
                                    @dataByUsername.Username
                                </a>
                                @if (isShowPT)
                                {
                                    <span class="ic-percent view-product-pt-list"
                                          data-custid="@dataByUsername.CustId"
                                          data-username="@dataByUsername.Username"
                                          data-userlevel="@dataByUsername.CustLevelName"></span>
                                }
                            </div>
                        </div>
                    </td>
                    <td class="text-left">@dataByUsername.CurrencyName</td>
                    @RenderConsolidateRow(dataByUsername)
                </tr>
                foreach (var dataByPT in dataByUsername.Children)
                {
                    if (isShowPT)
                    {
                        <tr class="child-row-@dataByUsername.CustId consolidation-pt-row hide">
                            <td></td>
                            <td class="text-left bold group-pt">@dataByPT.PositionTakingText</td>
                            <td></td>
                            @RenderConsolidateRow(dataByPT)
                        </tr>
                    }

                    foreach (var item in dataByPT.Children)
                    {
                        <tr class="child-row-@dataByUsername.CustId hide">
                            <td></td>
                            <td class="text-left col-product">@item.ProductName</td>
                            <td></td>
                            @RenderConsolidateRow(item)
                        </tr>
                    }
                }
            }
        </tbody>
    }
    else
    {
        @NoInformation.Render(colspan: Model.IsStackMode ? 8 : 14)
    }
</table>
@Html.Hidden("IsSetDefaultStackMode", Model.IsSetDefaultStackMode)
@Html.Hidden("LoadLegendURL", Url.Action("ReportLegend", $"{Alpha.Reports.Configurations.SiteSettings.ReportRouting}Consolidation", new { IsSupportHistoricReport = true, IsHistoricReport = Model.IsHistoricReport, MinDate = Model.MinDate }))
@section Scripts {
    @StaticResources.RenderScripts($"~/{Alpha.Reports.Configurations.SiteSettings.ReportRouting}assets/bundles/consolidation/consolidation")
}
@Html.Partial(
    "ExportExcel",
    Model,
    new ViewDataDictionary
    {
        ["action"] = "ConsolidationByUsernameExcel",
        ["CustId"] = Model.CustId,
        ["CustName"] = Model.CustName,
        ["FromDate"] = Model.FromDate,
        ["ToDate"] = Model.ToDate,
        ["UserSelectedProductIds"] = Model.UserSelectedProductIds,
        ["UserSelectedResourceIds"] = Model.UserSelectedResourceIds,
        ["UserSelectedCurrencyId"] = Model.UserSelectedCurrencyId,
        ["CustLevel"] = Model.CustLevel.Value
    })
@helper RenderConsolidateRow(ConsolidationEntityViewModel consolidation)
{
    <td>@HtmlHelpers.FormatNumber(consolidation.Turnover)</td>
    <td>@HtmlHelpers.FormatNumber(consolidation.GrossComm)</td>
    if (Model.IsStackMode)
    {
        @HtmlHelpers.RenderStackCell("col-member-winloss-combined", 1, consolidation.MemberWinLoss, consolidation.MemberComm, consolidation.MemberTotal)
        @HtmlHelpers.RenderStackCell("col-owner-turnover-combined", 1, consolidation.OwnerTurnover, consolidation.OwnerWinLoss, consolidation.OwnerComm, consolidation.OwnerTotal)
    }
    else
    {
        @HtmlHelpers.RenderNumberCell(consolidation.MemberWinLoss, "col-member-winloss")
        @HtmlHelpers.RenderNumberCell(consolidation.MemberComm)
        @HtmlHelpers.RenderNumberCell(consolidation.MemberTotal, "bold")
        @HtmlHelpers.RenderNumberCell(consolidation.OwnerTurnover, "col-owner-turnover")
        @HtmlHelpers.RenderNumberCell(consolidation.OwnerWinLoss)
        @HtmlHelpers.RenderNumberCell(consolidation.OwnerComm)
        @HtmlHelpers.RenderNumberCell(consolidation.OwnerTotal, "bold")
    }
    <td>@HtmlHelpers.FormatNumber(consolidation.Company)</td>
    <td>@HtmlHelpers.FormatNumber(consolidation.BetCount)</td>
}
@{ Html.RenderPartial("~/Views/Consolidation/_ViewProductPTList.cshtml"); }