@using Alpha.Reports.Extensions;

@model WinLossAnalysisChartViewModel

@{
    ViewBag.Title = "Win Loss Analysis Chart Report";
}

@ReportTitle.Render(new PageHeaderViewModel(Model.Title, false, true, false, Model.IsFilterVisible, Enumerable.Empty<CustInfo>(), string.Empty), Request.Url.Query)

<form class="form-inline filter @(Model.FilterViewModel.Visible ? string.Empty : "hide")" role="form" id="report-form">

    <div id="msg-error" class="msg msg-error hide">
        @Resources.Least3MonthToChart
    </div>

    @ProductMultiSelection.Render(Model.FilterViewModel.ProductMultiSelectionViewModel)

    @MonthRangePicker.Render(Model.MonthPickerViewModel)

    <div class="form-group">
        <input type="submit" value="@Resources.Submit" class="btn-submit" />
    </div>

    <div id="icon-information-container" class="form-group hide">
        <span id="icon-information" class="icon-information-outline"></span>
    </div>

    <div class="note">
        <span class="star">*</span>@Model.FilterViewModel.ViewDataInstructionMessage
    </div>

    @RenderHiddenFields()
</form>
<div class="container-fluid">
    <div class="row report-content">
        <div class="col-xs-12 col-sm-12 col-md-8 col-lg-9 pull-right">
            <div class="chart-container">
                @DualAxisChart.Render(Model.DualAxisChartViewModel)
            </div>
        </div>
        <div class="col-xs-12 col-sm-12 col-md-4 col-lg-3 pull-left table-container">
            <table class="tblRpt tblRpt-bordered tblRpt-striped tblRpt-hover" id="tbl-report">
                <thead>
                    <tr>
                        <th>@Resources.Month</th>
                        <th>@Model.DualAxisChartViewModel.FirstDataLabel</th>
                        <th>@Model.DualAxisChartViewModel.SecondDataLabel</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ReportData.Any())
                    {
                        foreach (var data in Model.ReportData)
                        {
                            <tr>
                                <td>@data.WinLossDate.ToShortMonthNameAndYear()</td>
                                <td>@data.WinLoss.ToString($"#,##0.00")</td>
                                <td>@data.Turnover.ToString($"#,##0.00")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        @NoInformation.Render(3)
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@Html.Hidden("LoadLegendURL", Url.Action("Index", $"{Alpha.Reports.Configurations.SiteSettings.ReportRouting}ReportLegend"))
<input type="hidden" value="@(Model.IsDarkMode ? "1" : "0")" id="hidden-isDarkMode" />
@section Scripts {
    @StaticResources.AssetScripts.Render("/bundles/site-reports/winloss-analysis-chart")
    @StaticResources.RenderScripts($"~/{Alpha.Reports.Configurations.SiteSettings.ReportRouting}assets/bundles/winlossanalysischart/winlossanalysischart")
}
@helper RenderHiddenFields()
{
    @Html.Hidden("IsFilterVisible", Model.FilterViewModel.Visible)
    @Html.Hidden("CustId", Model.CustId)
    @Html.Hidden("CustName", Model.CustName)
    @Html.Hidden("CustLevelId", Model.CustLevel.Value)
}