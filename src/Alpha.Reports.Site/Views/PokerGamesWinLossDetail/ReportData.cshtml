@model PokerGamesWinLossDetailViewModel

<table class="tblRpt tblRpt-bordered alternative-row-table width-100per tablesorter tblRpt-hover
       @(Model.IsStackMode ? "stack-mode" : string.Empty)" id="tbl-report"
       data-totalrecords="@Model.ReportData.TotalRecords"
       data-custid="@Model.CustId"
       data-sortedcolumn="@Model.SortPropertyName"
       data-descendingsort="@Model.IsDescendingSort">
    <thead>
        <tr>
            <th class="sorting" rowspan="2" data-sortedname="CustName" data-colindex="0">@Resources.Username</th>
            <th class="sorting" rowspan="2" data-sortedname="BetCount" data-colindex="1">@Resources.RoundCount</th>
            <th rowspan="2" class="hidden-stack-mode sorting" data-sortedname="Turnover" data-colindex="2">@Resources.Turnover</th>
            <th rowspan="2" class="hidden-stack-mode col-netturnover-header sorting" data-sortedname="NetTurnover" data-colindex="3">@Resources.NetTurnover</th>
            <th rowspan="2" class="hidden-stack-mode sorting" data-sortedname="GrossComm" data-colindex="4">@Resources.TaxComm</th>
            <th rowspan="2" class="visible-stack-mode col-netturnover-header col-combine sorting" data-sortedname="Turnover" data-colindex="2">
                <span class="prior-sortedcolumn">@Resources.TurnoverAbbr</span>@Resources.NetTurnoverAndTaxComm
            </th>

            <th colspan="4" class="col-level hidden-stack-mode" data-disabledsort="true">@Resources.Member</th>
            <th class="visible-stack-mode col-combine sorting" data-sortedname="MemberWinLoss.WinLoss" rowspan="2" data-colindex="3">
                @Resources.Member
                <br />
                (<span class="prior-sortedcolumn">@Resources.WinLossAbbr</span>/@Resources.Insurance_GemsWinLossAbbr@Resources.CommAndTotal)
            </th>

            <th colspan="3" class="col-level hidden-stack-mode" data-disabledsort="true">@Resources.Agent</th>
            <th class="visible-stack-mode col-combine sorting" data-sortedname="AgentWinLoss.InsuranceGemsWinLoss" rowspan="2" data-colindex="4">
                @Resources.Agent
                <br />
                (<span class="prior-sortedcolumn">@Resources.Insurance_GemsWinLossAbbr</span>@Resources.CommAndTotal)
            </th>

            @if (Model.CustLevel.IsMasterOrSuperLevel())
            {
                <th colspan="3" class="col-level hidden-stack-mode" data-disabledsort="true">@Resources.Master</th>
                <th class="visible-stack-mode col-combine sorting" data-sortedname="MasterWinLoss.InsuranceGemsWinLoss" rowspan="2" data-colindex="5">
                    @Resources.Master
                    <br />
                    (<span class="prior-sortedcolumn">@Resources.Insurance_GemsWinLossAbbr</span>@Resources.CommAndTotal)
                </th>
            }

            @if (Model.CustLevel.IsSuperLevel())
            {
                <th colspan="3" class="col-level hidden-stack-mode" data-disabledsort="true">@Resources.Super</th>
                <th class="visible-stack-mode col-combine sorting" data-sortedname="SuperWinLoss.InsuranceGemsWinLoss" rowspan="2" data-colindex="6">
                    @Resources.Super
                    <br />
                    (<span class="prior-sortedcolumn">@Resources.Insurance_GemsWinLossAbbr</span>@Resources.CommAndTotal)
                </th>
            }

            @if (Model.CustLevel.IsAgentLevel())
            {
                <th class="sorting hidden-stack-mode" rowspan="2" data-sortedname="Company" data-colindex="12">@Resources.Company</th>
                <th class="sorting visible-stack-mode" rowspan="2" data-sortedname="Company" data-colindex="6">@Resources.Company</th>
            }
            else if (Model.CustLevel.IsMasterLevel())
            {
                <th class="sorting hidden-stack-mode" rowspan="2" data-sortedname="Company" data-colindex="15">@Resources.Company</th>
                <th class="sorting visible-stack-mode" rowspan="2" data-sortedname="Company" data-colindex="7">@Resources.Company</th>
            }
            else
            {
                <th class="sorting hidden-stack-mode" rowspan="2" data-sortedname="Company" data-colindex="18">@Resources.Company</th>
                <th class="sorting visible-stack-mode" rowspan="2" data-sortedname="Company" data-colindex="8">@Resources.Company</th>
            }
        </tr>
        <tr class="thead-row2">
            <th class="hidden-stack-mode col-winloss sorting" data-sortedname="MemberWinLoss.WinLoss" data-colindex="5">@Resources.WinLoss</th>
            <th class="hidden-stack-mode col-winloss sorting col-insurance-gems-win-loss" data-sortedname="MemberWinLoss.InsuranceGemsWinLoss" data-colindex="6">@Resources.Insurance_GemsWinLoss</th>
            <th class="hidden-stack-mode sorting" data-sortedname="MemberWinLoss.Comm" data-colindex="7">@Resources.Comm</th>
            <th class="hidden-stack-mode sorting" data-sortedname="MemberWinLoss.Total" data-colindex="8">@Resources.Total</th>

            <th class="hidden-stack-mode col-winloss sorting col-insurance-gems-win-loss" data-sortedname="AgentWinLoss.InsuranceGemsWinLoss" data-colindex="9">@Resources.Insurance_GemsWinLoss</th>
            <th class="hidden-stack-mode sorting" data-sortedname="AgentWinLoss.Comm" data-colindex="10">@Resources.Comm</th>
            <th class="hidden-stack-mode sorting" data-sortedname="AgentWinLoss.Total" data-colindex="11">@Resources.Total</th>
            @if (Model.CustLevel.IsMasterOrSuperLevel())
            {
                <th class="hidden-stack-mode col-winloss sorting col-insurance-gems-win-loss" data-sortedname="MasterWinLoss.InsuranceGemsWinLoss" data-colindex="12">@Resources.Insurance_GemsWinLoss</th>
                <th class="hidden-stack-mode sorting" data-sortedname="MasterWinLoss.Comm" data-colindex="13">@Resources.Comm</th>
                <th class="hidden-stack-mode sorting" data-sortedname="MasterWinLoss.Total" data-colindex="14">@Resources.Total</th>
            }

            @if (Model.CustLevel.IsSuperLevel())
            {
                <th class="hidden-stack-mode col-winloss sorting col-insurance-gems-win-loss" data-sortedname="SuperWinLoss.InsuranceGemsWinLoss" data-colindex="15">@Resources.Insurance_GemsWinLoss</th>
                <th class="hidden-stack-mode sorting" data-sortedname="SuperWinLoss.Comm" data-colindex="16">@Resources.Comm</th>
                <th class="hidden-stack-mode sorting" data-sortedname="SuperWinLoss.Total" data-colindex="17">@Resources.Total</th>
            }
        </tr>
    </thead>
    @if (Model.ReportData.Any())
    {
        var isEvenRow = false;

        <tbody>
            @foreach (var data in Model.ReportData.DataSource.OrderBy(Model.SortPropertyName, Model.IsDescendingSort))
            {
                @RenderRow(data, false, ViewBag.BetListPath, isEvenRow)
                isEvenRow = !isEvenRow;
            }
        </tbody>
        <tfoot>
            @RenderRow(Model.ReportData.TotalData, true, ViewBag.BetListPath, false)
        </tfoot>
    }
    else
    {
        @NoInformation.Render(colspan:
            Model.CustLevel.IsSuperLevel()
            ? 19
            : (Model.CustLevel.IsMasterLevel() ? 16 : 17))
    }
</table>

<form class="form-inline hide" role="form" id="export-excel-form"
      action="@Url.Action(ViewData["ExportExcelAction"].ToString(), ViewData["ExportExcelController"].ToString())">
    @Html.Hidden("CustId", Model.CustId)
    @Html.Hidden("CustName", Model.CustName)
    @Html.Hidden("FromDate", Model.FromDate)
    @Html.Hidden("ToDate", Model.ToDate)
    @Html.Hidden("CustLevelId", Model.CustLevel.Value)
    @Html.Hidden("IsHistoricReport", Model.IsHistoricReport)
</form>

@Pager.Render(Model.PagerViewModel)

@helper RenderRow(PokerGamesWinLossDetailModel data, bool isTotalRow, string betListPath, bool isEvenRow)
{
    <tr class="@(isTotalRow ? "tbl-footer" : string.Empty)@(isEvenRow? "even-row":string.Empty)">
        <td data-islink="true" class="text-left col-username">
            @if (isTotalRow)
            {
                @Resources.Total
            }
            else
            {
                <a href="@Model.BuildDrillDownLink(data, Request.Url.Query)"
                   class="@(Model.CustLevel.IsAgentLevel() ? string.Empty : "downline-link")"
                   data-custname="@data.CustName">
                    @data.CustName
                </a>
            }
        </td>

        <td class="col-number-of-tickets">@HtmlHelpers.FormatNumber(data.RoundCount)</td>
        @if (Model.IsStackMode)
        {
            @HtmlHelpers.RenderStackCell("col-turnover-combined", 1, data.Turnover, data.NetTurnover, data.TaxComm);

            @HtmlHelpers.RenderStackCell(
               $"col-{UserLevel.Member.DisplayName.ToLower()}-winloss-combined",
               1,
               data.MemberWinLoss.WinLoss.Value,
               data.MemberWinLoss.InsuranceGemsWinLoss.Value,
               data.MemberWinLoss.Comm.Value,
               data.MemberWinLoss.Total);

            @RenderStackNetWinLoss(UserLevel.Agent, data.AgentWinLoss, isHighlight: true);
            @RenderStackNetWinLoss(UserLevel.Master, data.MasterWinLoss);
            @RenderStackNetWinLoss(UserLevel.Super, data.SuperWinLoss, isHighlight: true);
        }
        else
        {
            @HtmlHelpers.RenderNumberCell(data.Turnover, "col-turnover")
            @HtmlHelpers.RenderNumberCell(data.NetTurnover, "col-net-turnover")
            @HtmlHelpers.RenderNumberCell(data.TaxComm, "col-gross-com")

            @HtmlHelpers.RenderNumberCell(data.MemberWinLoss.WinLoss.Value, $"col-{UserLevel.Member.DisplayName.ToLower()}-winloss")
            @HtmlHelpers.RenderNumberCell(data.MemberWinLoss.InsuranceGemsWinLoss.Value)
            @HtmlHelpers.RenderNumberCell(data.MemberWinLoss.Comm.Value)
            @HtmlHelpers.RenderNumberCell(data.MemberWinLoss.Total, $"bold")

            @RenderNetWinLoss(UserLevel.Agent, data.AgentWinLoss, isHighlight: true)
            @RenderNetWinLoss(UserLevel.Master, data.MasterWinLoss)
            @RenderNetWinLoss(UserLevel.Super, data.SuperWinLoss, isHighlight: true)
        }
        <td class="col-company">@HtmlHelpers.FormatNumber(data.Company)</td>
    </tr>
}

@helper RenderStackNetWinLoss(UserLevel level, PokerGamesWinLoss winLoss, bool isHighlight = false)
{
if (winLoss == null)
{
    return;
}

var highlightCellClass = isHighlight ? "altercol" : string.Empty;

    @HtmlHelpers.RenderStackCell(
        $"col-{level.DisplayName.ToLower()}-winloss-combined {highlightCellClass}",
        1,
        winLoss.InsuranceGemsWinLoss.Value,
        winLoss.Comm.Value,
        winLoss.Total);
}

@helper RenderNetWinLoss(UserLevel level, PokerGamesWinLoss winLoss, bool isHighlight = false)
{
if (winLoss == null)
{
    return;
}

var highlightCellClass = isHighlight ? "altercol" : string.Empty;

    @HtmlHelpers.RenderNumberCell(winLoss.InsuranceGemsWinLoss.Value, $"col-{level.DisplayName.ToLower()}-winloss {highlightCellClass}")
    @HtmlHelpers.RenderNumberCell(winLoss.Comm.Value, highlightCellClass)
    @HtmlHelpers.RenderNumberCell(winLoss.Total, $"bold {highlightCellClass}")
}