@using Alpha.Reports.Site.ViewModels.BetChoiceMatching
@model BetChoiceMatchingViewModel
@{
    ViewBag.Title = "BET CHOICE MATCHING";
}

@section Styles {
    @StaticResources.RenderStylesWithDarkMode($"~/{Alpha.Reports.Configurations.SiteSettings.ReportRouting}/assets/bundles/betchoicematching/betchoicematching")
}

@ReportTitle.Render(new PageHeaderViewModel(Resources.BetChoiceMatching, false, true, false, false, Enumerable.Empty<CustInfo>(), null), Request.Url.Query)

@Html.Hidden("Today", Model.WinlostDate)
@Html.Hidden("MinDate", Model.MinDate)
<form class="form-inline filter" role="form" id="report-form" action="@Url.Action($"{Alpha.Reports.Configurations.SiteSettings.ReportRouting}/Query")">
    @Html.AntiForgeryToken()
    <div class="form-group">
        <label class="txt">@Resources.eventdate</label>
        <div class="control date">
            <div class="input-group date" id="dpkContainer">
                @Html.EditorFor(model => model.WinlostDate, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                <span class="input-group-addon">
                    <span class="icon-calendar"></span>
                </span>
            </div>
        </div>
    </div>
    <div class="form-group">
        <label for="BetCount">@Resources.MatchingBets</label>
        <select id="BetCount" name="BetCount">
            @foreach (var betCount in Model.BetCounts)
            {
                <option value="@betCount" @(betCount == Model.BetCount ? "selected=\"selected\"" : string.Empty)> >= @betCount</option>
            }
        </select>
    </div>
    <div class="form-group">
        <input type="submit" value="@Resources.Submit" class="btn-submit" />
    </div>
    <div class="form-group">
        <span id="icon-excel" class="icon-excel" title="@Resources.ExportToExcel"></span>
    </div>
</form>
<form class="form-inline hide" role="form" id="export-excel-form" action="@Url.Action($"{Alpha.Reports.Configurations.SiteSettings.ReportRouting}/Excel")">
    <input type="hidden" name="WinlostDate" id="ExcelWinlostDate" />
    <input type="hidden" name="BetCount" id="ExcelBetCount" />
    <input type="hidden" name="Username" id="ExcelUsername" />
    <input type="hidden" name="Stake" id="ExcelStake" />
    <input type="hidden" name="MemberWinLossOperator" id="ExcelMemberWinLossOperator" />
    <input type="hidden" name="MemberWinLossValue" id="ExcelMemberWinLossValue" />
</form>
<form role="form" id="uplines-form" action="@Url.Action($"{Alpha.Reports.Configurations.SiteSettings.ReportRouting}/Uplines")">
    @Html.AntiForgeryToken()
    @Html.Hidden("SearchAccountId")
</form>
<table class="tblRpt tblRpt-bordered tblRpt-hover width-100per hide" id="tbl-report">
    <thead class="tableFloatingHeaderOriginal">
        <tr>
            <th class="col-username">@Resources.Username <span class="icon-table-filter"></span></th>
            <th class="col-transtime">@Resources.transtime</th>
            <th class="col-refno">@Resources.refno</th>
            <th class="col-odds">@Resources.odds</th>
            <th class="col-ip">@Resources.IP</th>
            <th class="col-stake">@Resources.Stake <span class="icon-table-filter"></span></th>
            <th class="col-memberwinloss">@Resources.MemberWinLoss <span class="icon-table-filter"></span></th>
            <th class="col-superwinloss">@Resources.SuperWinLoss</th>
            <th class="col-company">@Resources.Company</th>
        </tr>
    </thead>
    <tbody>
        <tr id="noinfo-row">
            <td colspan="9" align="center">@Resources.NoInformationIsAvailable</td>
        </tr>
    </tbody>
    <tfoot>
    </tfoot>
</table>
@section Scripts {
    <script type="text/javascript">
        var betMatchingResources = {
            Total: '@Resources.Total',
            FT: '@Resources.BetType1X2_FT',
            HT: '@Resources.HT',
            Versus: '@Resources.vs',
            Over: '@Resources.over',
            Under: '@Resources.under',
            Upline: '@Resources.Upline',
            IP_used_by: '@Resources.IP_used_by',
            BetMatching_Username_Title: '@Resources.BetMatching_Username_Title',
            BetMatching_IP_Title: '@Resources.BetMatching_IP_Title',
            FilterByUsername: '@Resources.FilterByUsername',
            FilterByStake: '@Resources.FilterByStake',
            FilterByMemberWinLoss: '@Resources.FilterByMemberWinLoss',
            Filter: '@Resources.Filter',
            TotalStake: '@Resources.TotalStake',
            TotalMemberWL: '@Resources.TotalMemberWL',
            FilterByUsername_Placeholder: '@Resources.FilterByUsername_Placeholder'
        }
    </script>
    @StaticResources.AssetScripts.Render("/bundles/common/cleave-jquery")
    @StaticResources.RenderScripts($"~/{Alpha.Reports.Configurations.SiteSettings.ReportRouting}/assets/bundles/betchoicematching/betchoicematching")
}
