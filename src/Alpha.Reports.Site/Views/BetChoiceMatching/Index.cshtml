@using Alpha.Reports.Site.ViewModels.BetChoiceMatching
@model BetChoiceMatchingViewModel
@{
    ViewBag.Title = "BET CHOICE MATCHING";
}

@ReportTitle.Render(new PageHeaderViewModel(Resources.BetChoiceMatching, false, true, false, false, Enumerable.Empty<CustInfo>(), null), Request.Url.Query)

<form class="form-inline filter" role="form" id="report-form" action="@Url.Action("Query")">
    <div class="form-group">
        <label class="txt">@Resources.Date</label>
        <div class="control date">
            <div class="input-group date" id="dpkContainer">
                @Html.EditorFor(model => model.WinlostDate, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                <span class="input-group-addon">
                    <span class="icon-calendar"></span>
                </span>
            </div>
        </div>
    </div>
    <div class="form-group">
        <label for="betCount">@Resources.MatchingBets</label>
        <select id="betCount">
            @foreach (var betCount in Model.BetCounts)
            {
                <option value="@betCount" @(betCount == Model.BetCount ? "selected=\"selected\"" : string.Empty)> >= @betCount</option>
            }
        </select>
    </div>
    <div class="form-group">
        <input type="submit" value="@Resources.Submit" class="btn-submit" />
    </div>
    <div class="form-group">
        <span id="icon-excel" class="icon-excel" title="@Resources.ExportToExcel"></span>
    </div>
    @Html.Hidden("Today", Model.WinlostDate)
    @Html.Hidden("MinDate", Model.WinlostDate.AddDays(-14))
</form>
<table class="tblRpt tblRpt-bordered tblRpt-striped tblRpt-hover hide" id="tbl-report">
    <thead class="tableFloatingHeaderOriginal">
        <tr>
            <th>@Resources.Username</th>
            <th>@Resources.transtime</th>
            <th>@Resources.refno</th>
            <th>@Resources.odds</th>
            <th>@Resources.IP</th>
            <th>@Resources.stake</th>
            <th>@Resources.MemberWinLoss</th>
            <th>@Resources.superwinloss</th>
            <th>@Resources.Company</th>
        </tr>
    </thead>
    <tbody>
        <tr id="noinfo-row">
            <td colspan="9" align="center">@Resources.NoInformationIsAvailable</td>
        </tr>
    </tbody>
    <tfoot>
        <tr class="tbl-footer">
            <td colspan="5">@Resources.Total</td>
            <td class="col-stake"></td>
            <td class="col-memberwinloss"></td>
            <td class="col-superwinloss"></td>
            <td class="col-company"></td>
        </tr>
    </tfoot>
</table>
@section Scripts {
    @StaticResources.AssetScripts.Render("/js/libs/numeral/numeral")
    @StaticResources.RenderScripts("~/assets/bundles/betchoicematching/betchoicematching")
}
