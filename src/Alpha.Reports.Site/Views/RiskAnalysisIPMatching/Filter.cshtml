@model WinLossFilterViewModel

<form class="form-inline filter @(Model.Visible ? string.Empty : "hide")" role="form" id="report-form">
    @RenderHiddenFields()

    <div class="control date">
        <div id="from-date-container"
             class="input-group date fromdate">
            <input type="text"
                   id="winloss-date"
                   name="winloss-date"
                   readonly="readonly"
                   autocomplete="off"
                   class="ui_nexdatepicker_datetextbox ui_nexdatepicker_fromdate form-control"
                   value="@Model.WinlostDate" />
            <span class="input-group-addon">
                <span class="icon-calendar" id="fdate_trigger"></span>
            </span>
        </div>
    </div>

    <div class="form-group">
        <input type="submit" value="@Resources.Submit" class="btn-submit" />
    </div>

    <div id="icon-information-container" class="form-group hide">
        <span id="icon-information" class="icon-information-outline"></span>
    </div>
    <div class="form-group">
        <span id="icon-excel" class="icon-excel" title="@Resources.ExportToExcel"></span>
    </div>

    <div class="note">
        <span class="star">*</span>@Model.ViewDataInstructionMessage <a id="historic-report" data-is-historic-report="@Model.IsHistoricReport.ToString().ToLower()" href="#">@Model.ViewActionMessage</a>
    </div>

    @helper RenderHiddenFields()
    {
        @*@Html.Hidden("IsFilterVisible", Model.Visible)
            @Html.Hidden("IsHistoricReport", Model.IsHistoricReport)

            @Html.Hidden("IsStackMode", ViewData["IsStackMode"] as bool?)
            @Html.Hidden("IsAgentLevel", Model.CustLevel.IsAgentLevel())

            @Html.Hidden("IsDescendingSort", ViewData["IsDescendingSort"] as bool?)
            @Html.Hidden("SortPropertyName", ViewData["SortPropertyName"] as string)

            @Html.Hidden("CustId", Model.CustId)
            @Html.Hidden("CustName", Model.CustName)
            @Html.Hidden("BreadcrumbLevelJson", Model.BreadcrumbLevelJson)
            @Html.Hidden("CustLevelId", Model.CustLevel.Value)*@
    }
</form>