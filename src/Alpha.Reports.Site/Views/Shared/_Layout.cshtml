﻿@{ var darkModeName = ViewData["DarkModeName"]; }
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@(ViewBag.Title ?? "Alpha - Reports")</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" type="image/x-icon" href="~/favico.ico" />

    @StaticResources.AssetStyles.RenderCommon($"/bundles/common/common{darkModeName}")
    @StaticResources.AssetStyles.Render($"/bundles/site-reports/default{darkModeName}")
    @StaticResources.RenderStyles($"~/assets/bundles/{ViewData["TitleLevel"]}{darkModeName}")
    @RenderSection("Styles", required: false)
</head>
<body>
    @RenderBody()

    @Html.Hidden("NoInformationIsAvailable", @Resources.NoInformationIsAvailable)

    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/ajaxSetup")
    @StaticResources.AssetScripts.Render("/bundles/site-reports/default")

    @RenderSection("Scripts", required: false)

    @Alpha.Web.Helpers.GoogleAnalyticHepler.Render()
    @Html.Raw(Fanex.Logging.LogManager.RenderJavascriptLogger())
</body>
</html>