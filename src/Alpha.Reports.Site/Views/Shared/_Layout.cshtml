<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@(ViewBag.Title ?? "Alpha - Reports")</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" type="image/x-icon" href="~/favico.ico" />

    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/common/common")
    @StaticResources.AssetStyles.RenderWithDarkMode("/bundles/site-reports/default")
    @StaticResources.RenderStylesWithRoleAndDarkMode($"~/assets/bundles/")
    @RenderSection("Styles", required: false)
    @Alpha.Web.Helpers.GoogleAnalyticHepler.GtagScript()
</head>
<body>
    @Alpha.Web.Helpers.GoogleAnalyticHepler.GtagNoScript()
    @RenderBody()

    @Html.Hidden("NoInformationIsAvailable", @Resources.NoInformationIsAvailable)

    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/ajaxSetup")
    @StaticResources.AssetScripts.Render("/bundles/site-reports/default")

    @RenderSection("Scripts", required: false)

    @Html.Raw(Fanex.Logging.LogManager.RenderJavascriptLogger())
</body>
</html>