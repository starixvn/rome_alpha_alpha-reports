@{ var darkModeName = AlphaPlus.User.Models.UserSession.Current.DarkModeName; }
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@(ViewBag.Title ?? "Alpha - Reports")</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" type="image/x-icon" href="~/favico.ico" />
    @StaticResources.AssetStyles.Render("/bundles-v2/common/common")
    @RenderSection("Styles", required: false)
    @Alpha.Web.Helpers.GoogleAnalyticHepler.GtagScript()
</head>
<body data-theme="@(string.IsNullOrWhiteSpace(darkModeName) ? "light" : "dark")">
    @Alpha.Web.Helpers.GoogleAnalyticHepler.GtagNoScript()
    @RenderBody()

    @Html.Hidden("NoInformationIsAvailable", @Resources.NoInformationIsAvailable)

    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/ajaxSetup")
    @StaticResources.AssetScripts.Render("/bundles/site-reports/default")

    @RenderSection("Scripts", required: false)
    @if (Session.IsCookieless && Alpha.Reports.Configurations.SiteSettings.IsStandaloneReport)
    {
        var mainDomain = $"//{Request.Headers["Host"]}";
        var mainSessionId = Session.SessionID;
        @Html.Hidden("CookielessSiteMainUrl", $"{mainDomain}/site-main/(S({mainSessionId}))/");
    }
</body>
</html>