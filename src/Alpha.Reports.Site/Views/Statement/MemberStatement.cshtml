@model MemberStatementViewModel
@{
    ViewBag.Title = "Statement Report";
    Layout = "~/Views/Shared/_Layout2.cshtml";
}
@section Styles {
    @StaticResources.AssetStyles.Render("/bundles-v2/site-reports/statement")
    @StaticResources.RenderStyles($"~/{Alpha.Reports.Configurations.SiteSettings.ReportRouting}/assets/bundles-v2/statement")
}
@ReportTitle.Render(new PageHeaderViewModel(Resources.DailyStatement + " - " + Model.CustName, false, true, false, Model.IsFilterVisible, null, null))
<form class="form-inline filter @(Model.IsFilterVisible ? string.Empty : "hide")" role="form" id="report-form">
    <div class="form-group">
        <select id="dropdown-report-type">
            <option value="1" selected="selected">@Resources.DailyStatement</option>
            <option value="2" data-url="@Model.BuildBetListLink()">@Resources.BetList</option>
            <option value="3" data-url="@Model.BuildBetListRunningLink()">@Resources.BetList_Running</option>
        </select>
    </div>
    @DateRangePicker.Render(Model.DateRangePickerViewModel)
    <div class="form-group form-group-short">
        <span id="icon-information" class="ic-information"></span>
    </div>
    <div class="form-group">
        <span id="icon-excel" class="ic-excel" title="@Resources.ExportToExcel"></span>
    </div>
    <div class="note">
        <span class="star">*</span>@Model.ViewDataInstructionMessage
    </div>
    @Html.Hidden("IsFilterVisible", Model.IsFilterVisible ? "true" : "false")
    @Html.Hidden("CustId", Model.CustId)
    @Html.Hidden("CustName", Model.CustName)
    @Html.Hidden("CustLevelId", Model.CustLevel.Value)
    @Html.Hidden("ReportType", "1")
    @Html.Hidden("ProductIds", Model.ProductIds)
</form>
<table class="tb tb-bordered w-full tablesorter tb-hover text-right" id="tbl-report">
    <thead>
        <tr>
            <th>@Resources.Date</th>
            <th class="full-title">@Resources.OpeningBalance</th>
            <th class="short-title">@Resources.OpeningBal</th>
            <th>@Resources.Turnover</th>
            <th>@Resources.Void/@Resources.Rejected</th>
            <th>@Resources.Outstanding</th>
            <th>@Resources.WinLoss</th>
            <th class="full-title">@Resources.Commission</th>
            <th class="short-title">@Resources.Comm</th>
            <th>@Resources.GrandPrize</th>
            <th class="full-title">@Resources.TransferAmt</th>
            <th class="short-title">@Resources.Transfer</th>
            <th class="full-title">@Resources.AccumulatedTotal</th>
            <th class="short-title">@Resources.AccumTotal</th>
        </tr>
    </thead>
    @if (Model.Statements.Any())
    {
        var isEvenRow = false;
        StatementModel previousStatement = null;

        <tbody>
            @foreach (var data in Model.Statements)
            {
                <tr class="@(isEvenRow? "even-row":string.Empty) hide">
                    <td class="text-center">@data.WinLossDateString</td>
                    <td class="@(data.IsNotedBalance(previousStatement)?"note-opening-balance":string.Empty)">
                        @RenderNegativeNumberCell(data.OpeningBalance)
                    </td>
                    <td>@RenderNumberCell(data.Turnover)</td>
                    <td>
                        <span class="@(Model.IsNegative(data.VoidAmount) ? "format-negative" : string.Empty)
                              @(data.VoidAmount.HasValue ? " col-void-amount" : string.Empty)"
                              data-transfer-date="@data.WinLossDateString">
                            @RenderNullableNumber(data.VoidAmount)
                        </span>
                    </td>
                    <td>
                        <span class="@(Model.IsNegative(data.Outstanding) ? "format-negative" : string.Empty)
                              @(data.Outstanding.HasValue ? " col-outstanding" : string.Empty)"
                              data-transfer-date="@data.WinLossDateString">
                            @RenderNullableNumber(data.Outstanding)
                        </span>
                    </td>
                    <td>
                        <span class="@(Model.IsNegative(data.WinLoss) ? "format-negative" : string.Empty)
                              @(data.WinLoss.HasValue ? " col-win-loss" : string.Empty)"
                              data-transfer-date="@data.WinLossDateString">
                            @RenderNullableNumber(data.WinLoss)
                        </span>
                    </td>
                    <td>@RenderNegativeNumberCell(data.Commission)</td>
                    <td>
                        <span class="@(Model.IsNegative(data.GrandPrize) ? "format-negative" : string.Empty)
                              @(data.GrandPrize.HasValue ? " col-grand-prize" : string.Empty)"
                              data-transfer-date="@data.WinLossDateString">
                            @RenderNullableNumber(data.GrandPrize)
                        </span>
                    </td>
                    <td>
                        <span class=" @(data.TransferAmount.HasValue ? "column-transfer-amount" : string.Empty)
                              @(Model.IsNegative(data.TransferAmount) ? "format-negative" : string.Empty) "
                              data-transfer-date="@data.WinLossDateString">
                            @RenderNullableNumber(data.TransferAmount)
                        </span>
                    </td>
                    <td>@RenderNegativeNumberCell(data.ClosingBalance)</td>
                </tr>
                isEvenRow = !isEvenRow;
                previousStatement = data;
            }
        </tbody>
    }
    else
    {
        @NoInformation.Render(colspan: 10)
    }
</table>
<form class="form-inline hide" role="form" id="export-excel-form"
      action="@Url.Action("MemberStatementExcel", $"{Alpha.Reports.Configurations.SiteSettings.ReportRouting}Statement")">
    @Html.Hidden("CustId", Model.CustId)
    @Html.Hidden("CustName", Model.CustName)
    @Html.Hidden("FromDate", Model.FromDate)
    @Html.Hidden("ToDate", Model.ToDate)
</form>
@Html.Hidden("LoadLegendURL", Url.Action("MemberReportLegend", $"{Alpha.Reports.Configurations.SiteSettings.ReportRouting}Statement", Model.IsDirectMember ? new { IsDirectMember = Model.IsDirectMember } : null))
@Html.Hidden("StatementDetailsURL", Url.Action("StatementDetails", $"{Alpha.Reports.Configurations.SiteSettings.ReportRouting}Statement"))
@Html.Hidden("BetListUrl", Model.BetListLink)
@Html.Hidden("BetListTitle", Resources.BetList)
@Html.Hidden("TransferDetails", Resources.TransferDetails)
@Html.Hidden("MainDomain", Model.MainDomain)
@Pager.Render(Model.PagerViewModel)
@section Scripts {
    @StaticResources.RenderScripts($"~/{Alpha.Reports.Configurations.SiteSettings.ReportRouting}assets/bundles/statement/member-statement")
}

@helper RenderNegativeNumberCell(decimal? cellValue, string cssClass = "")
{
    <span class="@(Model.IsNegative( cellValue) ? "format-negative" : string.Empty) @cssClass">
        @(cellValue.HasValue ? cellValue.Value.FormatNumber() : Resources.Symbol_NoDataNumber)
    </span>
}

@helper RenderNumberCell(decimal? cellValue)
{
    <span>
        @(cellValue.HasValue ? cellValue.Value.FormatNumber() : Resources.Symbol_NoDataNumber)
    </span>
}

@helper RenderNullableNumber(decimal? cellValue)
{
    @(cellValue.HasValue ? cellValue.Value.FormatNumber() : Resources.Symbol_NoDataNumber)
}