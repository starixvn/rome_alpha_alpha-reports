@using Alpha.Reports.Site

@model OutstandingViewModel

@{
    var betlistPath = $"../../{AppPathHelper.GetAppPath(SiteSettings.OldMainAppPath, "~/")}_Reports/BetList/OutstandingDetail.aspx";
}

<div class="page-title">
    <span class="pull-left">@Model.Title</span>
    @Breadcrumb.Render(Model.BreadcrumbLevels, Request.RawUrl)
    @Html.Hidden("BreadcrumbLevelsJson", Model.BreadcrumbLevelsJson)
</div>

<table class="tblRpt tblRpt-bordered tblRpt-striped tblRpt-hover width-100per tablesorter" id="tbl-report"
       data-totalrecords="@Model.OutstandingDatasource.Count()"
       data-sortedcolumn="Outstanding.Username"
       data-descendingsort="false">
    <thead class="tableFloatingHeaderOriginal">
        <tr>
            <th rowspan="2" class="header sorting" data-colindex="0" data-sortedname="Outstanding.Username">
                @HtmlHelpers.DisplayUserLevelText(Model.ReportLevel)
            </th>
            <th colspan="@Model.NumberOfOutstandingColumn" class="header">
                @Resources.Outstanding
            </th>
        </tr>
        <tr class="thead-row2">
            @Model.DisplayOutstandingLevels.List(
        @<th class="sorting" data-colindex="@item.Value" data-sortedname>
            @HtmlHelpers.DisplayUserLevelText(@item)
        </th>)
        </tr>
    </thead>
    @if (Model.OutstandingDatasource.Any())
    {
        <tbody>
            @Model.OutstandingDatasource.List(
        @<tr>
            <td class="text-left" data-islink="true">
                <a href="@Model.GetUserActionLink(@item, Model.BetListPath)">@item.CustName</a>
            </td>
            @RenderOutstandingCells(@item)
        </tr>)
        </tbody>
        <tfoot>
            <tr class="tbl-footer">
                <td class="text-left">@Resources.Total</td>
                @RenderOutstandingCells(Model.Total)
            </tr>
        </tfoot>
    }
    else
    {
        @NoInformation.Render(Model.NumberOfOutstandingColumn + 1)
    }

</table>

@section Scripts {
    @StaticResources.RenderScripts("~/assets/bundles/outstanding/outstanding")
}

@helper RenderOutstandingCells(OutstandingData data)
{
foreach (var level in Model.DisplayOutstandingLevels)
{
        <td>
            @HtmlHelpers.FormatNumber(data.GetValueByLevel(level))
        </td>
}
}
