@model OutstandingViewModel

<div class="page-title">
    <span class="pull-left">@Model.Title</span>
</div>

<table class="tblRpt tblRpt-bordered tblRpt-striped tblRpt-hover width-100per" id="tbl-report">
    <thead class="tableFloatingHeaderOriginal">
        <tr>
            <th rowspan="2" class="header">Username</th>
            <th colspan="@(UserLevel.Super.Value - Model.CustLevel.Value + 1)" class="header">Outstanding</th>
        </tr>
        <tr class="thead-row2">
            <th>Member</th>
            @for (int i = Model.CustLevel.Value; i <= UserLevel.Super.Value; i++)
            {
                if (UserLevel.Member.Value == i)
                {
                    <th>Agent</th>
                }
                if (UserLevel.Agent.Value == i)
                {
                    <th>Master</th>
                }
                if (UserLevel.Master.Value == i)
                {
                    <th>Super</th>
                }
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var outstanding in Model.Outstandings)
        {
            <tr>
                @if (Model.CustLevel.IsMemberLevel())
                {
                    <td class="text-left">@outstanding.CustName</td>
                }
                else
                {
                    <td class="text-left">
                        @Html.ActionLink(outstanding.CustName, "Index", new { custLevelId = Model.CustLevel.Value, custId = outstanding.CustId })
                    </td>

                }
                @if (Model.CustLevel.IsMemberLevel())
                {
                    <td>
                        TODO: Link to Betlist!
                        @*<span class="downline_link" onclick="viewSBBetList('14123341','???','RunByDate_Mem')">1,800.00</span>*@
                    </td>
                }
                else
                {
                    <td>@outstanding.MemberOutstanding</td>
                }
                @for (int i = Model.CustLevel.Value; i <= UserLevel.Super.Value; i++)
                {
                    if (UserLevel.Member.Value == i)
                    {
                        <td>@outstanding.AgentOutstanding</td>
                    }
                    if (UserLevel.Agent.Value == i)
                    {
                        <td>@outstanding.MasterOutstanding</td>
                    }
                    if (UserLevel.Master.Value == i)
                    {
                        <td>@outstanding.SuperOutstanding</td>
                    }
                }
            </tr>
        }
    </tbody>
</table>