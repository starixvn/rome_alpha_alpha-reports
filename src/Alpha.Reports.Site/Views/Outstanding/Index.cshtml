@using Alpha.Reports.Site.App_GlobalResources;

@model OutstandingViewModel

@ReportTitle.Render(new PageHeaderViewModel(Model.Title, false, false, false, false, Model.BreadcrumbLevel, Model.BreadcrumbLevelJson), Request.Url.Query)

<form class="form-inline filter" role="form" id="report-form">
    @ProductMultiSelection.Render(Model.ProductMultiSelectionViewModel)

    @Html.Hidden("CustId", Model.Query.CustId)
    @Html.Hidden("CustName", Model.Query.CustName)
    @Html.Hidden("CustLevelId", Model.CustLevel.Value)
    @Html.Hidden("BreadcrumbLevelJson", Model.BreadcrumbLevelJson)
    <div class="form-group">
        <input type="submit" value="@Resources.Submit" class="btn-submit" />
    </div>
</form>

<table class="tblRpt tblRpt-bordered tblRpt-striped tblRpt-hover width-60per tablesorter" id="tbl-report"
       data-totalrecords="@Model.OutstandingDatasource.Count()"
       data-sortedcolumn="Outstanding.Username"
       data-descendingsort="false">
    <thead class="tableFloatingHeaderOriginal">
        <tr>
            <th rowspan="2" class="header sorting" data-colindex="0" data-sortedname="Outstanding.Username">
                @HtmlHelpers.DisplayUserLevelText(Model.ReportLevel)
            </th>
            <th colspan="@Model.NumberOfOutstandingColumn" class="header" data-disabledsort="true">
                @Resources.Outstanding
            </th>
        </tr>
        <tr class="thead-row2">
            @foreach (var userLevel in Model.DisplayOutstandingLevels)
            {
                <th class="sorting" data-colindex="@userLevel.Value" data-sortedname>
                    @HtmlHelpers.DisplayUserLevelText(userLevel)
                </th>
            }
        </tr>
    </thead>
    @if (Model.OutstandingDatasource.Any())
    {
        <tbody>
            @foreach (var outstanding in Model.OutstandingDatasource)
            {
                <tr>
                    <td class="text-left" data-islink="true">
                        <a href="@Model.BuildDrillDownLink(outstanding, Request.Url.Query)" data-custname="@outstanding.CustName">@outstanding.CustName</a>
                    </td>
                    @RenderOutstandingCells(outstanding)
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="tbl-footer">
                <td class="text-left">@Resources.Total</td>
                @RenderOutstandingCells(Model.Total)
            </tr>
        </tfoot>
    }
    else
    {
        @NoInformation.Render(Model.NumberOfOutstandingColumn + 1)
    }

</table>

@section Scripts {
    @StaticResources.RenderScripts("~/assets/bundles/outstanding/outstanding")
}

@helper RenderOutstandingCells(OutstandingModel data)
{
foreach (var level in Model.DisplayOutstandingLevels)
{
        <td>
            @HtmlHelpers.FormatNumber(data.GetValueByLevel(level))
        </td>
}
}
