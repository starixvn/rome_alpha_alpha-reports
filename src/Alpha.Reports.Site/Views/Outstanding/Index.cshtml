@using Alpha.Reports.Site.App_GlobalResources;
@{
    ViewBag.Title = "Outstanding Report";
}

@section Styles {
    @StaticResources.RenderStylesWithMedia(767, "~/assets/bundles/outstanding/outstanding-mobile-calculate-07")
}

@model OutstandingViewModel

@ReportTitle.Render(new PageHeaderViewModel(Model.Title, false, true, false, Model.IsFilterVisible, Model.BreadcrumbLevel, Model.BreadcrumbLevelJson), Request.Url.Query)

<form class="form-inline filter form-outstanding @(Model.IsFilterVisible ? string.Empty : "hide")" role="form" id="report-form">
    @ProductMultiSelection.Render(Model.ProductMultiSelectionViewModel)

    @Html.Hidden("CustId", Model.Query.CustId)
    @Html.Hidden("CustName", Model.Query.CustName)
    @Html.Hidden("CustLevelId", Model.CustLevel.Value)
    @Html.Hidden("BreadcrumbLevelJson", Model.BreadcrumbLevelJson)
    @Html.Hidden("SortPropertyName", Model.SortPropertyName)
    @Html.Hidden("IsDescendingSort", Model.IsDescendingSort)
    @Html.Hidden("IsFilterVisible", Model.IsFilterVisible)
    <div class="form-group last-group">
        <input type="submit" value="@Resources.Submit" class="btn-submit" />
    </div>
</form>
<div class="level-@Model.CustLevel.Value">
    @if ((Model.IsMobileView) && (Model.CustLevel.Value == 4))
    {
        @Html.Partial("TableContentMobileSuper");
    }
    else
    {
        @Html.Partial("TableContent" + (Model.IsMobileView ? "Mobile" : ""), Model)
    }

    @Html.Hidden("LoadLegendURL", Url.Action("ReportLegend", "Outstanding"))
</div>


@section Scripts {
    @StaticResources.RenderScripts("~/assets/bundles/outstanding/outstanding")
}

