@model OutstandingViewModel

@{
    var betlistPath = $"../../{AppPathHelper.GetAppPath(SiteSettings.OldMainAppPath, "~/")}_Reports/BetList/OutstandingDetail.aspx";
}

@helper RenderOutstandingCells(OutstandingData data)
{
foreach (var reportLevel in Model.OutstandingLevels)
{
        <td>@HtmlHelpers.FormatNumber(Model.GetOutstandingValue(data, reportLevel))</td>
}
}

@Html.Partial("_PageTitle", new PageHeaderViewModel(Model.Title, false, false, false, false, Model.BreadcrumbLevels))

<table class="tblRpt tblRpt-bordered tblRpt-striped tblRpt-hover width-100per tablesorter" id="tbl-report"
       data-totalrecords="@Model.OutstandingDatasource.Count()"
       data-sortedcolumn="Outstanding.Username"
       data-descendingsort="false">
    <thead class="tableFloatingHeaderOriginal">
        <tr>
            <th rowspan="2" class="header sorting" data-colindex="0" data-sortedname="Outstanding.Username">@Model.Level</th>
            <th colspan="@(Model.OutstandingLevels.Count + 1)" class="header">@Resources.Outstanding</th>
        </tr>
        <tr class="thead-row2">
            <th class="sorting" data-colindex="1" data-sortedname>@Resources.Member</th>
            @foreach (var reportLevel in Model.OutstandingLevels)
            {
                if (reportLevel.IsMemberLevel())
                {
                    <th class="sorting" data-colindex="2" data-sortedname>@Resources.Agent</th>
                }
                if (reportLevel.IsAgentLevel())
                {
                    <th class="sorting" data-colindex="3" data-sortedname>@Resources.Master</th>
                }
                if (reportLevel.IsMasterLevel())
                {
                    <th class="sorting" data-colindex="4" data-sortedname>@Resources.Super</th>
                }
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var outstanding in Model.OutstandingDatasource)
        {
            <tr>
                @if (Model.ReportLevel.IsMemberLevel())
                {
                    <td class="text-left" data-islink="true">
                        <a href="@($"{betlistPath}?custId={outstanding.CustId}&username={outstanding.CustName}&chkgetall={"on"}")">@outstanding.CustName</a>
                    </td>
                }
                else
                {
                    <td class="text-left" data-islink="true">
                        @Html.ActionLink(outstanding.CustName, "Index",
                        new
                        {
                            custLevelId = Model.ReportLevel.Value,
                            custId = outstanding.CustId,
                            custName = outstanding.CustName,
                            DrillDownInfoJson = Model.DrillDownInfoJson
                        })
                    </td>
                }
                <td>@HtmlHelpers.FormatNumber(outstanding.MemberOutstanding)</td>
                @RenderOutstandingCells(outstanding)
            </tr>
        }
    </tbody>
    <tfoot>
        <tr class="tbl-footer">
            <td class="text-left">@Resources.Total</td>
            <td>@HtmlHelpers.FormatNumber(@Model.Total.MemberOutstanding)</td>
            @RenderOutstandingCells(Model.Total)
        </tr>
    </tfoot>
</table>

@section Scripts {
    @StaticResources.RenderScripts("~/assets/bundles/outstanding/outstanding")
}