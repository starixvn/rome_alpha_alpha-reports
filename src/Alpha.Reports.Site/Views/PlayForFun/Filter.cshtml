@model PlayForFunFilterViewModel
<form class="form-inline filter  @(Model.Visible ? string.Empty:"hide")" role="form" id="report-form">
    @ProductSingleSelection.Render(Model.ProductMultiSelectionViewModel)
    @StatusSelection.Render(Model.StatusSelectionViewModel)
    @DateRangePicker.Render(Model.DateRangePickerViewModel)

    <div class="form-group">
        <span id="icon-excel" class="icon-excel" title="@Resources.ExportToExcel"></span>
    </div>

    <div class="note">
        <span class="star">*</span>@Model.ViewDataInstructionMessage
    </div>

    <input id="IsFilterVisible" type="hidden" name="IsFilterVisible" value="@Model.Visible.ToString()" />
    <input id="IsDescendingSort" type="hidden" name="IsDescendingSort" value="@((ViewData["IsDescendingSort"] as bool?).ToString())" />
    <input id="SortPropertyName" type="hidden" name="SortPropertyName" value="@(ViewData["SortPropertyName"] as string)" />
    <input id="CustId" type="hidden" name="CustId" value="@Model.CustId" />
    <input id="CustName" type="hidden" name="CustName" value="@Model.CustName" />
    <input id="BreadcrumbLevelJson" type="hidden" name="BreadcrumbLevelJson" value="@Model.BreadcrumbLevelJson" />
    <input id="CustLevelId" type="hidden" name="CustLevelId" value="@Model.CustLevel.Value" />
</form>