@using Alpha.Reports.Models.PlayForFun
@model MasterOrAgentPlayForFunReportViewModel
@{
    ViewBag.Title = "Play For Fun Report";
    var total = (MasterAgentPlayForFunModel)Model.ReportData.TotalData;
}

@ReportTitle.Render(new PageHeaderViewModel(
    Model.CustLevel.IsSuperLevel() ? Resources.MasterPlayForFunDetail : Resources.AgentPlayForFunDetail,
    false,
    true,
    false,
    Model.FilterViewModel.Visible,
    Model.BreadcrumbLevel,
    Model.BreadcrumbLevelJson), Request.Url.Query, Model.BreadcrumbActions)
@Html.Partial("Filter", Model.FilterViewModel,
    new ViewDataDictionary
    {
        ["IsDescendingSort"] = Model.IsDescendingSort,
        ["SortPropertyName"] = Model.SortPropertyName
    })

<table class="tblRpt tblRpt-bordered alternative-row-table width-100per tablesorter tblRpt-hover" id="tbl-report"
       data-totalrecords="@Model.ReportData.DataSource.Count()"
       data-custid="@Model.CustId"
       data-sortedcolumn="@Model.SortPropertyName"
       data-descendingsort="@Model.IsDescendingSort">
    <thead>
        <tr>
            <th class="sorting" data-sortedname="@PlayForFunReportViewModel.SortByCustName" data-colindex="0">
                @(Model.CustLevel.IsSuperLevel() ? Resources.Master : Resources.Agent)
            </th>
            <th class="sorting" data-sortedname="@MasterOrAgentPlayForFunReportViewModel.SortByNumberOfPlayers" data-colindex="1">@Resources.NoPlayers</th>
            <th class="sorting" data-sortedname="@PlayForFunReportViewModel.SortByTurnover" data-colindex="2">@Resources.Turnover</th>
            <th class="sorting" data-sortedname="@PlayForFunReportViewModel.SortByMemberWinLoss" data-colindex="3">@Resources.MemberWinLoss</th>
            <th class="sorting" data-sortedname="@PlayForFunReportViewModel.SortByPlayCount" data-colindex="4">@Resources.PlayCount</th>
        </tr>
    </thead>
    @if (Model.ReportData.Any())
    {
        var isEvenRow = false;
        <tbody>
            @foreach (MasterAgentPlayForFunModel data in Model.ReportData.DataSource.OrderBy(Model.SortPropertyName, Model.IsDescendingSort))
                {
                <tr class="@(isEvenRow? "even-row":string.Empty)">
                    <td data-islink="true" class="text-left">
                        <a href="@Model.BuildDrillDownLink(data, Url.Action(Model.DrilldownAction, "PlayForFun") + Request.Url.Query)"
                           class="downline-link"
                           data-custname="@data.CustName">
                            @data.CustName
                        </a>
                    </td>
                    <td>@HtmlHelpers.FormatNumber(data.NumberOfPlayers)</td>
                    <td>@HtmlHelpers.FormatNumber(data.Turnover)</td>
                    <td>@HtmlHelpers.FormatNumber(data.WinLoss)</td>
                    <td>@HtmlHelpers.FormatNumber(data.BetCount)</td>
                </tr>
                isEvenRow = !isEvenRow;
            }
        </tbody>
        <tfoot>
            <tr class="tbl-footer">
                <td class="text-left">@Resources.Total</td>
                <td>@HtmlHelpers.FormatNumber(total.NumberOfPlayers)</td>
                <td>@HtmlHelpers.FormatNumber(total.Turnover)</td>
                <td>@HtmlHelpers.FormatNumber(total.WinLoss)</td>
                <td>@HtmlHelpers.FormatNumber(total.BetCount)</td>
            </tr>
        </tfoot>
    }
    else
    {
        @NoInformation.Render(colspan: 5)
    }
</table>
@Html.Partial("ExportExcel", Model,
    new ViewDataDictionary
    {
        ["FormAction"] = Url.Action("MasterOrAgentExcel", "PlayForFun")
    })

@section Scripts {
    @StaticResources.RenderScripts("~/assets/bundles/playforfun/playforfun-master-agent")
}
