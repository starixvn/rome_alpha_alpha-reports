@model WinLossByGameTypeViewModel

@ReportTitle.Render(new PageHeaderViewModel(Model.Title, true, true, Model.IsStackMode, Model.IsFilterVisible, Enumerable.Empty<CustInfo>(), string.Empty), Request.Url.Query)

@Html.Partial("Filter", Model.FilterViewModel,
    new ViewDataDictionary
    {
        { "IsStackMode", Model.IsStackMode },
        { "IsDescendingSort", Model.IsDescendingSort },
        { "SortPropertyName", Model.SortPropertyName },
        { "ProductId", Model.ProductId },
        { "Title", Model.Title }
    })
<table class="tblRpt tblRpt-bordered tblRpt-striped width-100per tablesorter tblRpt-hover
       @(Model.IsStackMode ? "stack-mode" : string.Empty)" id="tbl-report"
       data-totalrecords="@Model.ReportData.Count()"
       data-custid="@Model.CustId"
       data-sortedcolumn="@Model.SortPropertyName"
       data-descendingsort="@Model.IsDescendingSort">
    <thead>
        <tr>
            <th rowspan="2" data-disabledsort="true" data-colindex="0">@Resources.GameTypeName</th>
            <th rowspan="2" class="hidden-stack-mode sorting" data-sortedname="Turnover" data-colindex="1">@Resources.Turnover</th>
            <th rowspan="2" class="visible-stack-mode col-combine sorting" data-sortedname="Turnover" data-colindex="1">
                <span class="prior-sortedcolumn">@Resources.TurnoverAbbr</span>
                @(Model.CustLevel.IsAgentLevel() ? Resources.GrossComm :
                  (Model.CustLevel.IsSuperLevel() ? Resources.GrossComAndMasterTotal : Resources.GrossComAndAgentTotal))
            </th>

            @if (Model.CustLevel.IsSuperLevel())
            {
                <th rowspan="2" class="hidden-stack-mode sorting" data-sortedname="MasterNetWinLoss.WinLoss" data-colindex="1">@Resources.MasterTotal</th>
            }

            @if (Model.CustLevel.IsMasterLevel())
            {
                <th rowspan="2" class="hidden-stack-mode sorting" data-sortedname="AgentNetWinLoss.WinLoss" data-colindex="1">@Resources.AgentTotal</th>
            }

            @if (Model.CustLevel.IsAgentLevel())
            {
                <th colspan="3" class="col-level hidden-stack-mode">@Resources.Member</th>
                <th class="visible-stack-mode col-combine sorting" data-sortedname="MemberNetWinLoss.WinLoss" rowspan="2" data-colindex="1">
                    @Resources.Member
                    <br />
                    (<span class="prior-sortedcolumn">@Resources.WinLossAbbr</span>@Resources.CommAndTotal)
                </th>
                <th colspan="3" class="col-level hidden-stack-mode">@Model.CustLevelName</th>
                <th class="visible-stack-mode col-combine sorting" data-sortedname="AgentNetWinLoss.WinLoss" rowspan="2" data-colindex="2">
                    @Model.CustLevelName
                    <br />
                    (<span class="prior-sortedcolumn">@Resources.WinLossAbbr</span>@Resources.CommAndTotal)
                </th>
                <th class="sorting hidden-stack-mode" rowspan="2" data-sortedname="Company" data-colindex="9">@Resources.Company</th>
                <th class="sorting visible-stack-mode" rowspan="2" data-sortedname="Company" data-colindex="4">@Resources.Company</th>
            }
            else
            {
                <th colspan="3" class="col-level hidden-stack-mode">@Model.CustLevelName</th>
                <th class="visible-stack-mode col-combine sorting" data-sortedname="@(Model.CustLevelNetWinLossName + ".WinLoss")" rowspan="2" data-colindex="1">
                    @Model.CustLevelName
                    <br />
                    (<span class="prior-sortedcolumn">@Resources.WinLossAbbr</span>@Resources.CommAndTotal)
                </th>
                <th class="sorting hidden-stack-mode" rowspan="2" data-sortedname="Company" data-colindex="6">@Resources.Company</th>
                <th class="sorting visible-stack-mode" rowspan="2" data-sortedname="Company" data-colindex="2">@Resources.Company</th>
            }
        </tr>
        <tr class="thead-row2">
            @if (Model.CustLevel.IsAgentLevel())
            {
                <th class="hidden-stack-mode col-winloss sorting" data-sortedname="MemberNetWinLoss.WinLoss" data-colindex="2">@Resources.WinLoss</th>
                <th class="hidden-stack-mode sorting" data-sortedname="MemberNetWinLoss.Comm" data-colindex="3">@Resources.Comm</th>
                <th class="hidden-stack-mode sorting" data-sortedname="MemberNetWinLoss.Total" data-colindex="4">@Resources.Total</th>

                <th class="hidden-stack-mode col-winloss sorting" data-sortedname="@(Model.CustLevelNetWinLossName + ".WinLoss")" data-colindex="5">@Resources.WinLoss</th>
                <th class="hidden-stack-mode sorting" data-sortedname="@(Model.CustLevelNetWinLossName + ".Comm")" data-colindex="6">@Resources.Comm</th>
                <th class="hidden-stack-mode sorting" data-sortedname="@(Model.CustLevelNetWinLossName + ".Total")" data-colindex="7">@Resources.Total</th>
            }
            else
            {
                <th class="hidden-stack-mode col-winloss sorting" data-sortedname="@(Model.CustLevelNetWinLossName + ".WinLoss")" data-colindex="3">@Resources.WinLoss</th>
                <th class="hidden-stack-mode sorting" data-sortedname="@(Model.CustLevelNetWinLossName + ".Comm")" data-colindex="4">@Resources.Comm</th>
                <th class="hidden-stack-mode sorting" data-sortedname="@(Model.CustLevelNetWinLossName + ".Total")" data-colindex="5">@Resources.Total</th>
            }
        </tr>
    </thead>
    @if (Model.ReportData.Any())
    {
        <tbody>
            @foreach (var data in Model.ReportData)
            {
                @RenderRow(data, false)
            }
        </tbody>
        <tfoot>
            @RenderRow(Model.GrandTotal, true)
        </tfoot>
    }
    else
    {
        @NoInformation.Render(colspan: Model.CustLevel.IsAgentLevel() ? 10 : 8)
    }
</table>

<form class="form-inline hide" role="form" id="export-excel-form" 
      action="@Url.Action("Excel", "WinLossByGameType")">
    <input type="hidden" name="CustId" value="@Model.CustId" />
    <input type="hidden" name="FromDate" value="@Model.FromDate" />
    <input type="hidden" name="ToDate" value="@Model.ToDate" />
    <input type="hidden" name="CustLevelId" value="@Model.CustLevel.Value" />
    <input type="hidden" name="ProductId" value="@Model.ProductId" />
</form>

@Html.Hidden("IsSetDefaultStackMode", Model.IsSetDefaultStackMode)

@section Scripts {
    @StaticResources.RenderScripts("~/assets/bundles/winlossbygametype/winlossbygametype")
}

@helper RenderRow(WinLossByGameTypeModel data, bool isTotalRow)
{
    <tr @(isTotalRow ? "class=tbl-footer" : string.Empty)>
        <td class="text-left col-username">
            @if (isTotalRow)
            {
                @Resources.Total
            }
            else
            {
                
                @data.GameTypeName
            }
        </td>

        @if (Model.IsStackMode)
        {
            if (Model.CustLevel.IsAgentLevel())
            {
                @HtmlHelpers.RenderStackCell("col-turnover-combined", 1, data.Turnover);

            }
            else
            {
                @HtmlHelpers.RenderStackCell("col-turnover-combined", 1, data.Turnover,
                                            Model.CustLevel.IsSuperLevel() ? data.MasterNetWinLoss.Total : data.AgentNetWinLoss.Total);
            }

            @RenderStackNetWinLoss(UserLevel.Member, data.MemberNetWinLoss);
            @RenderStackNetWinLoss(UserLevel.Agent, data.AgentNetWinLoss, isHighlight: true);
            @RenderStackNetWinLoss(UserLevel.Master, data.MasterNetWinLoss);
            @RenderStackNetWinLoss(UserLevel.Super, data.SuperNetWinLoss, isHighlight: true);
        }
        else
        {
            @HtmlHelpers.RenderNumberCell(data.Turnover, "col-turnover")

            @RenderNetWinLoss(UserLevel.Member, data.MemberNetWinLoss)
            @RenderNetWinLoss(UserLevel.Agent, data.AgentNetWinLoss, Model.CustLevel.IsAgentLevel())
            @RenderNetWinLoss(UserLevel.Master, data.MasterNetWinLoss, Model.CustLevel.IsMasterLevel())
            @RenderNetWinLoss(UserLevel.Super, data.SuperNetWinLoss, isHighlight: true)
        }
        <td class="text-right col-company">@HtmlHelpers.FormatNumber(data.Company)</td>
    </tr>
}

@helper RenderStackNetWinLoss(UserLevel level, NetWinLoss netWinLoss, bool isHighlight = false)
{
if (netWinLoss == null)
{
    return;
}

var highlightCellClass = isHighlight ? "altercol" : string.Empty;

if (netWinLoss.WinLoss != null)
{
        @HtmlHelpers.RenderStackCell(
        $"col-{level.DisplayName.ToLower()}-winloss-combined {highlightCellClass}",
        1,
        netWinLoss.WinLoss.Value,
        netWinLoss.Comm.Value,
        netWinLoss.Total);
}
}

@helper RenderNetWinLoss(UserLevel level, NetWinLoss netWinLoss, bool isHighlight = false)
{
if (netWinLoss == null)
{
    return;
}

var highlightCellClass = isHighlight ? "altercol" : string.Empty;
if (netWinLoss.WinLoss != null)
{
        @HtmlHelpers.RenderNumberCell(netWinLoss.WinLoss.Value, $"col-{level.DisplayName.ToLower()}-winloss {highlightCellClass}")
        @HtmlHelpers.RenderNumberCell(netWinLoss.Comm.Value, highlightCellClass)
}

    @HtmlHelpers.RenderNumberCell(netWinLoss.Total, $"bold {highlightCellClass} col-cust-total")
}