@using Alpha.Reports.Models.RacingCommission;
@using Alpha.Reports.Site.ViewModels.RacingCommission
@{
    ViewBag.Title = "Racing Commission Report";
}

@model RacingCommissionViewModel

@ReportTitle.Render(new PageHeaderViewModel(Model.Title, false, true, false, Model.RacingCommissionFilter.Visible, Model.BreadcrumbLevel, Model.BreadcrumbLevelJson), Request.Url.Query)

@Html.Partial("_RacingCommissionFilter", Model.RacingCommissionFilter,
    new ViewDataDictionary
    {
        { "IsDescendingSort", Model.IsDescendingSort },
        { "SortPropertyName", Model.SortPropertyName }
    })

<table class="tblRpt tblRpt-bordered tblRpt-striped tblRpt-hover width-100per tablesorter tbl-small-width" id="tbl-report"
       data-totalrecords="@Model.RacingCommissions.Count()"
       data-sortedcolumn="@Model.SortPropertyName"
       data-descendingsort="@Model.IsDescendingSort">
    <thead class="tableFloatingHeaderOriginal">
        <tr>
            <th rowspan="2" class="header sorting" data-colindex="0" data-sortedname="@RacingCommissionViewModel.SortByCustName">
                @Resources.Username
            </th>
            <th colspan="4" class="header">
                Tote
            </th>
        </tr>
        <tr class="thead-row2">
            <th class="sorting" data-colindex="1" data-sortedname="@RacingCommissionViewModel.SortByToteWin">@Resources.Win</th>
            <th class="sorting" data-colindex="2" data-sortedname="@RacingCommissionViewModel.SortByTotePlace">@Resources.Place</th>
            <th class="sorting" data-colindex="3" data-sortedname="@RacingCommissionViewModel.SortByToteWinPlace">@Resources.WinPlace</th>
            <th class="sorting" data-colindex="4" data-sortedname="@RacingCommissionViewModel.SortByTotal">@Resources.Total</th>
        </tr>
    </thead>
    @if (Model.RacingCommissions.Any())
    {
        <tbody>
            @foreach (var commission in Model.RacingCommissions)
            {
                <tr>
                    <td data-islink="true" class="text-left">
                        <a href="@Model.BuildDrillDownLink(commission, Request.Url.Query)" class="downline-link">@commission.CustName</a>
                    </td>
                    @RenderCellValue(commission)
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="tbl-footer">
                <td class="text-left">@Resources.Total</td>
                @RenderCellValue(Model.Total)
            </tr>
        </tfoot>
    }
    else
    {
        @NoInformation.Render(5)
    }
</table>

<form class="form-inline hide" role="form" id="export-excel-form" action="@Url.Action("Excel", "RacingCommission")">
    <input type="hidden" name="CustId" value="@Model.Query.CustId" />
    <input type="hidden" name="CustLevelId" value="@Model.Query.CustLevel.Value" />
    <input type="hidden" name="FromDate" value="@Model.Query.FromDate" />
    <input type="hidden" name="ToDate" value="@Model.Query.ToDate" />
</form>

@helper RenderCellValue(RacingCommissionModel commission)
{
    <td>@HtmlHelpers.FormatNumber(commission.ToteWin)</td>
    <td>@HtmlHelpers.FormatNumber(commission.TotePlace)</td>
    <td>@HtmlHelpers.FormatNumber(commission.ToteWinPlace)</td>
    <td>@HtmlHelpers.FormatNumber(commission.Total)</td>
}

@section Scripts {
    @StaticResources.RenderScripts("~/assets/bundles/racingcommission/racingcommission")
}
