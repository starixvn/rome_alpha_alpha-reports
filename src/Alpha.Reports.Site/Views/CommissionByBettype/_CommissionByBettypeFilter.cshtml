@using Alpha.Reports.Site.ViewModels.CommissionByBettype
@model CommissionByBettypeFilterViewModel
@{ 
    var viewLevel = Model.CustLevel.Value;
    var viewCustLevel = viewLevel == 4 ? UserLevel.Master :
        viewLevel == 3 ? UserLevel.Agent : UserLevel.Member;
}
<form class="form-inline filter @(Model.Visible ? string.Empty:"hide")" role="form" id="report-form" action="@Url.Action($"{viewCustLevel.DisplayName}", $"CommissionByBettype")">
    @DateRangePicker.Render(Model.DateRangePicker)

    <div class="form-group">
        <span id="icon-information" class="icon-information-outline"></span>
    </div>
    <div class="form-group">
        <span id="icon-excel" class="icon-excel" title="@Resources.ExportToExcel"></span>
    </div>

    <div class="note">
        <span class="star">*</span>@Model.ViewDataInstructionMessage
    </div>

    @Html.Hidden("IsFilterVisible", Model.Visible ? "true" : "false")

    @Html.Hidden("IsDescendingSort", ViewData["IsDescendingSort"] as bool?)
    @Html.Hidden("SortPropertyName", ViewData["SortPropertyName"] as string)

    @Html.Hidden("CustId", Model.CustId)
    @Html.Hidden("CustName", Model.CustName)
    @Html.Hidden("BreadcrumbLevelJson", Model.BreadcrumbLevelJson)
    @Html.Hidden("CustLevelId", Model.CustLevel.Value)
</form>
