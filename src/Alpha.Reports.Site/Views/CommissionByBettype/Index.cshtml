@using Alpha.Reports.Models.CommissionByBettype
@using Alpha.Reports.Site.ViewModels.CommissionByBettype
@model CommissionByBettypeViewModel
@{
    ViewBag.Title = "Commission By Bet Type Report";
    Layout = "~/Views/Shared/_Layout2.cshtml";
    var colindex = 0;
}
@section Styles {
    @StaticResources.AssetStyles.Render("/bundles-v2/site-report/commissionbybettype")
}
@ReportTitle.Render(new PageHeaderViewModel(Model.Title, false, true, false, Model.CommissionByBettypeFilter.Visible, Model.BreadcrumbLevel, Model.BreadcrumbLevelJson), Request.Url.Query)

@Html.Partial("_CommissionByBettypeFilter", Model.CommissionByBettypeFilter,
    new ViewDataDictionary
    {
        { "IsDescendingSort", Model.IsDescendingSort },
        { "SortPropertyName", Model.SortPropertyName }
    })

<table class="tb tb-bordered tablesorter tb-hover w-60p" id="tbl-report"
       data-totalrecords="@Model.CommissionByBettypes.Count()"
       data-sortedcolumn="@Model.SortPropertyName"
       data-descendingsort="@Model.IsDescendingSort">
    <thead class="tableFloatingHeaderOriginal">
        <tr>
            <th class="sorting" data-colindex="@(colindex++)" data-sortedname="@CommissionByBettypeViewModel.SortByCustName">@Resources.Username</th>
            @if (Model.ShowLevelType)
            {
                <th class="sorting" data-colindex="@(colindex++)" data-sortedname="@CommissionByBettypeViewModel.SortByIsDirectMember">@Resources.Level</th>
            }
            <th class="sorting" data-colindex="@(colindex++)" data-sortedname="@CommissionByBettypeViewModel.SortByComm1">@Resources.Commission1</th>
            <th class="sorting" data-colindex="@(colindex++)" data-sortedname="@CommissionByBettypeViewModel.SortByComm2">@Resources.Commission2</th>
            <th class="sorting" data-colindex="@(colindex++)" data-sortedname="@CommissionByBettypeViewModel.SortByComm3">@Resources.Commission3</th>
            <th class="sorting" data-colindex="@(colindex++)" data-sortedname="@CommissionByBettypeViewModel.SortByCasinoComm">@Resources.Gaming</th>
        </tr>
    </thead>
    @if (Model.CommissionByBettypes.Any())
    {
        <tbody>
            @foreach (var commission in Model.CommissionByBettypes.OrderBy(Model.SortPropertyName, Model.IsDescendingSort))
            {
                <tr>
                    @if (commission.IsDirectMember || Model.CustLevel.IsAgentLevel())
                    {
                        <td class="text-left">
                            @commission.CustName
                        </td>
                    }
                    else
                    {
                        <td data-islink="true" class="text-left">
                            <a class="downline-link" href="@Model.BuildDrillDownLink(commission, Request.Url.Query)">@commission.CustName</a>
                        </td>
                    }
                    @if (Model.ShowLevelType)
                    {
                        <td class="text-center">@(commission.IsDirectMember ? Resources.DirectMember : Model.LevelTypeValue)</td>
                    }
                    @RenderCellValue(commission)
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="tbl-footer">
                <td class="text-left">@Resources.Total</td>
                @if (Model.ShowLevelType)
                {
                    <td></td>
                }
                @RenderCellValue(Model.Total)
            </tr>
        </tfoot>
    }
    else
    {
        @NoInformation.Render(Model.GetNumCols())
    }
</table>

<form class="form-inline hide" role="form" id="export-excel-form" action="@Url.Action("Excel", $"{Alpha.Reports.Configurations.SiteSettings.ReportRouting}CommissionByBettype")">
    <input type="hidden" name="CustId" value="@Model.Query.CustId" />
    <input type="hidden" name="CustName" value="@Model.Query.CustName" />
    <input type="hidden" name="CustLevelId" value="@Model.Query.CustLevel.Value" />
    <input type="hidden" name="FromDate" value="@Model.Query.FromDate" />
    <input type="hidden" name="ToDate" value="@Model.Query.ToDate" />
</form>
@Html.Hidden("LoadLegendURL", Url.Action("Guidelines", $"{Alpha.Reports.Configurations.SiteSettings.ReportRouting}CommissionByBettype", new { MinDate = Model.Query.MinDate }))

@helper RenderCellValue(CommissionByBettypeModel commission)
{
    <td class="text-right">@HtmlHelpers.FormatNumber(commission.Comm1)</td>
    <td class="text-right">@HtmlHelpers.FormatNumber(commission.Comm2)</td>
    <td class="text-right">@HtmlHelpers.FormatNumber(commission.Comm3)</td>
    <td class="text-right">@HtmlHelpers.FormatNumber(commission.CasinoComm)</td>
}

@section Scripts {
    @StaticResources.RenderScripts($"~/{Alpha.Reports.Configurations.SiteSettings.ReportRouting}assets/bundles/commissionbybettype/commissionbybettype")
}