@model MatchWinLossDetailReportViewModel
@section Styles {
    @StaticResources.RenderStyles("~/assets/bundles/matchwinlossdetail/matchwinlossdetail")
}

@ReportTitle.Render(new PageHeaderViewModel(Model.Title, true, true, Model.IsStackMode, Model.IsFilterVisible, null, null), Request.Url.Query)
<form class="form-inline filter  @(Model.FilterViewModel.Visible ? string.Empty : "hide")" role="form" id="report-form">
    @Html.Hidden("IsFilterVisible", Model.FilterViewModel.Visible ? "true" : "false")
    @Html.Hidden("CustId", Model.CustId)
    @Html.Hidden("CustLevelId", Model.CustLevel.Value)
    @Html.Hidden("IsStackMode", Model.IsStackMode)

    @ProductMultiSelection.Render(Model.FilterViewModel.ProductMultiSelectionViewModel)
    @DateRangePicker.Render(Model.FilterViewModel.DateRangePickerViewModel)

    <div id="dropdown-league-container" class="form-group">
        @LeagueMultiSelection.Render(Model.FilterViewModel.LeagueMultiSelectionViewModel)
    </div>

    <div class="form-group">
        <span id="icon-excel" class="icon-excel" title="@Resources.ExportToExcel"></span>
    </div>

    <div class="note">
        <span class="star">*</span>@Model.FilterViewModel.ViewDataInstructionMessage
    </div>
</form>
<table id="tbl-report" class="tblRpt tblRpt-bordered alternative-row-table width-100per tablesorter tblRpt-hover
       @(Model.IsStackMode ? "stack-mode" : string.Empty)">
    <thead>
        <tr>
            <th colspan="3"></th>
            <th class="hidden-stack-mode" colspan="3">@Resources.Member</th>
            <th rowspan="2" class="visible-stack-mode col-combine">
                @Resources.Member
                <br />
                (<span class="prior-sortedcolumn">@Resources.WinLossAbbr</span>@Resources.CommAndTotal)
            </th>

            <th class="hidden-stack-mode" colspan="3">@Resources.Agent</th>
            <th rowspan="2" class="visible-stack-mode col-combine">
                @Resources.Agent
                <br />
                (<span class="prior-sortedcolumn">@Resources.WinLossAbbr</span>@Resources.CommAndTotal)
            </th>

            @if (Model.CustLevel.IsMasterOrSuperLevel())
            {
                <th class="hidden-stack-mode" colspan="3">@Resources.Master</th>
                <th rowspan="2" class="visible-stack-mode col-combine">
                    @Resources.Master
                    <br />
                    (<span class="prior-sortedcolumn">@Resources.WinLossAbbr</span>@Resources.CommAndTotal)
                </th>
            }

            @if (Model.CustLevel.IsSuperLevel())
            {
                <th class="hidden-stack-mode" colspan="3">@Resources.Super</th>
                <th rowspan="2" class="visible-stack-mode col-combine">
                    @Resources.Super
                    <br />
                    (<span class="prior-sortedcolumn">@Resources.WinLossAbbr</span>@Resources.CommAndTotal)
                </th>
            }

            <th colspan="2">@Resources.Company</th>
        </tr>
        <tr>
            <th>@Resources.BetType</th>
            <th>@Resources.Turnover</th>
            <th>@Resources.GrossComm</th>
            <th class="hidden-stack-mode">@Resources.WinLoss</th>
            <th class="hidden-stack-mode">@Resources.Comm</th>
            <th class="hidden-stack-mode">@Resources.Total</th>
            <th class="hidden-stack-mode">@Resources.WinLoss</th>
            <th class="hidden-stack-mode">@Resources.Comm</th>
            <th class="hidden-stack-mode">@Resources.Total</th>
            @if (Model.CustLevel.IsMasterOrSuperLevel())
            {
                <th class="hidden-stack-mode">@Resources.WinLoss</th>
                <th class="hidden-stack-mode">@Resources.Comm</th>
                <th class="hidden-stack-mode">@Resources.Total</th>
            }
            @if (Model.CustLevel.IsSuperLevel())
            {
                <th class="hidden-stack-mode">@Resources.WinLoss</th>
                <th class="hidden-stack-mode">@Resources.Comm</th>
                <th class="hidden-stack-mode">@Resources.Total</th>
            }
            <th>@Resources.Comm</th>
            <th>@Resources.Total</th>
        </tr>
    </thead>

    @if (Model.HasData)
    {
        <tbody>
            @foreach (var data in Model.NoParlayMatchWinLossDetail)
            {
                <tr class="match-title-row">
                    <td class="text-left col-username" colspan="@Model.ReportColumnsCount">
                        <span class="league-title">@data.LeagueName</span>
                        <span class="match-title">@data.MatchName</span>
                    </td>
                </tr>

                var isEvenRow = false;
                foreach (var betType in data.BetTypeWinLoss)
                {
                    <tr class="@(isEvenRow? "even-row":string.Empty)">
                        @RenderBetTypeRow(
                            betType,
                            "<a href=\"" + Model.GetBetListLink(Model.GetBetListLinkRouteValues(data, betType, Model.FromDate, Model.ToDate)) + "\">" + betType.Name + "</a>",
                            null,
                            isEvenRow)
                    </tr>
                    isEvenRow = !isEvenRow;
                }

                <tr class="sub-total-row">
                    @RenderBetTypeRow(data.Total, Resources.SubTotal)
                </tr>
            }
            @if (Model.NoParlayWinLossTotal != null
                    && (Model.MixParlay != null || Model.SystemParlay != null))
            {
                <tr class="sub-total-row">
                    @RenderBetTypeRow(Model.NoParlayWinLossTotal, Resources.Total)
                </tr>
            }
            @if (Model.MixParlay != null)
            {
                <tr>
                    @RenderBetTypeRow(
                        Model.MixParlay,
                        "<a href=\"" + Model.GetBetListLink(Model.GetParlayBetListLinkRouteValues(Model.MixParlay.Id, Model.FromDate, Model.ToDate)) + "\">" + Model.MixParlay.Name + "</a>")
                </tr>
            }
            @if (Model.SystemParlay != null)
            {
                <tr>
                    @RenderBetTypeRow(
                        Model.SystemParlay,
                        "<a href=\"" + Model.GetBetListLink(Model.GetParlayBetListLinkRouteValues(Model.SystemParlay.Id, Model.FromDate, Model.ToDate)) + "\">" + Model.SystemParlay.Name + "</a>")
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="tbl-footer">
                @RenderBetTypeRow(Model.GrandTotal, Resources.Total)
            </tr>
        </tfoot>
    }
    else
    {
        @NoInformation.Render(colspan: Model.ReportColumnsCount)
    }
</table>
@Html.Hidden("IsSetDefaultStackMode", Model.IsSetDefaultStackMode)
@Html.Hidden("LoadLeagueURL", Url.Action("LeaguesByCustomer", "League"))
<form class="form-inline hide" role="form" id="export-excel-form" action="@Url.Action("Excel", "MatchWinLossDetail")">
    @Html.Hidden("CustId", Model.CustId)
    @Html.Hidden("FromDate", Model.FromDate)
    @Html.Hidden("ToDate", Model.ToDate)
    @Html.Hidden("CustLevelId", Model.CustLevel.Value)
    @Html.Hidden("UserSelectedProductIds", Model.UserSelectedProductIds)
    @Html.Hidden("UserSelectedLeagueIds", Model.UserSelectedLeagueIds)
</form>
@section Scripts {
    @StaticResources.RenderScripts("~/assets/bundles/matchwinlossdetail/matchwinlossdetail")
}
@helper RenderBetTypeRow(BetTypeWinLossViewModel data, string betType, string betListPath = "", bool isEvenRow = false)
{
    <td class="text-left">@Html.Raw(betType)</td>
    <td>@HtmlHelpers.FormatNumber(data.Turnover)</td>
    <td>@HtmlHelpers.FormatNumber(data.GrossComm)</td>
if (Model.IsStackMode)
{
        @RenderStackNetWinLoss(UserLevel.Member, data.MemberNetWinLoss)
        @RenderStackNetWinLoss(UserLevel.Agent, data.AgentNetWinLoss)
        @RenderStackNetWinLoss(UserLevel.Master, data.MasterNetWinLoss)
        @RenderStackNetWinLoss(UserLevel.Super, data.SuperNetWinLoss)
}
else
{
        @RenderNetWinLoss(UserLevel.Member, data.MemberNetWinLoss)
        @RenderNetWinLoss(UserLevel.Agent, data.AgentNetWinLoss, true)

    if (Model.CustLevel.IsMasterOrSuperLevel())
    {
            @RenderNetWinLoss(UserLevel.Master, data.MasterNetWinLoss)
    }

    if (Model.CustLevel.IsSuperLevel())
    {
            @RenderNetWinLoss(UserLevel.Super, data.SuperNetWinLoss, true)
    }

}
    <td>@HtmlHelpers.FormatNumber(data.CompanyNetWinLoss.Comm.Value)</td>
    <td>@HtmlHelpers.FormatNumber(data.CompanyNetWinLoss.Total)</td>
}

@helper RenderNetWinLoss(UserLevel level, NetWinLoss netWinLoss, bool isHighlight = false)
{
if (netWinLoss == null)
{
    return;
}

var highlightCellClass = isHighlight ? "altercol" : string.Empty;

    @HtmlHelpers.RenderNumberCell(netWinLoss.WinLoss.Value, $"col-{level.DisplayName.ToLower()}-winloss {highlightCellClass}")
    @HtmlHelpers.RenderNumberCell(netWinLoss.Comm.Value, highlightCellClass)
    @HtmlHelpers.RenderNumberCell(netWinLoss.Total, $"bold {highlightCellClass}")
}
@helper RenderStackNetWinLoss(UserLevel level, NetWinLoss netWinLoss, bool isHighlight = false)
{
if (netWinLoss == null)
{
    return;
}

var highlightCellClass = isHighlight ? "altercol" : string.Empty;

    @HtmlHelpers.RenderStackCell(
        $"col-{level.DisplayName.ToLower()}-winloss-combined {highlightCellClass}",
        1,
        netWinLoss.WinLoss.Value,
        netWinLoss.Comm.Value,
        netWinLoss.Total);
}
