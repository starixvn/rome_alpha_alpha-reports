@model WinLossViewModel
@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewBag.Title = "Win Loss Report";
}
@section Styles {
    @StaticResources.AssetStyles.Render("/bundles-v2/site-reports/winloss")
    @StaticResources.RenderStyles("~/assets/bundles-v2/winlossdetailnew")

}
@ReportTitle.Render(new PageHeaderViewModel(
    Model.Title,
    true,
    true,
    Model.IsStackMode,
    Model.IsFilterVisible,
    Model.BreadcrumbLevel, Model.BreadcrumbLevelJson),
    Request.Url.Query,
    enteredSportResult: Model.TotalEnteredSport,
    hasEnterOrNonEnterNote: true,
    isHistoricReport: Model.IsHistoricReport)

@Html.Partial("~/Features/WinLoss/Views/Filter.cshtml", Model.FilterViewModel,
    new ViewDataDictionary
    {
        { "IsStackMode", Model.IsStackMode },
        { "IsDescendingSort", Model.IsDescendingSort },
        { "SortPropertyName", Model.SortPropertyName }
    })
<table class="tb tb-bordered tblRpt-hover tablesorter w-full text-right
       @(Model.IsStackMode ? "stack-mode" : string.Empty)" id="tbl-report"
       data-totalrecords="@Model.ReportData.Count()"
       data-custid="@Model.CustId"
       data-sortedcolumn="@Model.SortPropertyName"
       data-descendingsort="@Model.IsDescendingSort">
    <thead>
        @if (Model.CustLevel.IsMasterOrSuperLevel())
        {
            @RenderTableHeaderForSuperMaster()
        }
        else
        {
            @RenderTableHeaderForAgent()
        }
    </thead>
    @if (Model.ReportData.Any())
    {
        <tbody>
            @foreach (var data in Model.ReportData)
            {
                @RenderRow(data, false, ViewBag.BetListPath)
            }
        </tbody>
        <tfoot>
            @RenderRow(Model.GrandTotal, true, ViewBag.BetListPath)
        </tfoot>
    }
    else
    {
        @NoInformation.Render(colspan: Model.CustLevel.IsAgentLevel() ? 10 : 9)
    }
</table>

<form class="form-inline hide" role="form" id="export-excel-form"
      action="@Url.Action("Excel", $"{Alpha.Reports.Configurations.SiteSettings.ReportRouting}WinLoss")">
    @Html.Hidden("CustId", Model.CustId)
    @Html.Hidden("CustName", Model.CustName)
    @Html.Hidden("FromDate", Model.FromDate)
    @Html.Hidden("ToDate", Model.ToDate)
    @Html.Hidden("UserSelectedProductIds", Model.UserSelectedProductIds)
    @Html.Hidden("UserSelectedResourceIds", Model.UserSelectedResourceIds)
    @Html.Hidden("CustLevelId", Model.CustLevel.Value)
    @Html.Hidden("IsHistoricReport", Model.IsHistoricReport)
    @Html.Hidden("IsPostBack", "true")
</form>

@Html.Hidden("IsSetDefaultStackMode", Model.IsSetDefaultStackMode)
@Html.Hidden("LoadLegendURL", Url.Action("IndexGrossComm", $"{Alpha.Reports.Configurations.SiteSettings.ReportRouting}ReportLegend", new { IsSupportHistoricReport = true, IsHistoricReport = Model.IsHistoricReport, MinDate = Model.MinDate, ShowDormantAccountsNote = true }))

@section Scripts {
    @StaticResources.RenderScripts($"~/{Alpha.Reports.Configurations.SiteSettings.ReportRouting}Features/WinLoss/Bundles/winloss")
}

@helper RenderTableHeaderForSuperMaster()
{
    <tr>
        <th class="sorting" rowspan="2" data-sortedname="CustName" data-colindex="0">@Resources.Username</th>
        <th class="sorting" rowspan="2" data-sortedname="IsDirectMember" data-colindex="1">@Resources.Level</th>
        <th rowspan="2" class="hidden-stack-mode sorting" data-sortedname="Turnover" data-colindex="2">@Resources.Turnover</th>
        <th rowspan="2" class="hidden-stack-mode sorting" data-sortedname="GrossComm" data-colindex="3">@Resources.GrossComm</th>
        <th rowspan="2" class="visible-stack-mode col-combine sorting" data-sortedname="Turnover" data-colindex="2">
            <span class="prior-sortedcolumn">@Resources.TurnoverAbbr</span>
            @(Model.CustLevel.IsSuperLevel() ? Resources.GrossComAndMasterTotal : Resources.GrossComAndAgentTotal))
        </th>
        @if (Model.CustLevel.IsSuperLevel())
        {
            <th rowspan="2" class="hidden-stack-mode sorting" data-sortedname="MasterNetWinLoss.WinLoss" data-colindex="4">@Resources.DownlineTotal</th>
        }
        @if (Model.CustLevel.IsMasterLevel())
        {
            <th rowspan="2" class="hidden-stack-mode sorting" data-sortedname="AgentNetWinLoss.WinLoss" data-colindex="4">@Resources.DownlineTotal</th>
        }
        <th colspan="3" class="col-level hidden-stack-mode">@Model.CustLevelName</th>
        <th class="visible-stack-mode col-combine sorting" data-sortedname="@(Model.CustLevel.DisplayName + WinLossViewModel.NetWinLossWinLoss)" rowspan="2" data-colindex="3">
            @Model.CustLevelName
            <br />
            (<span class="prior-sortedcolumn">@Resources.WinLossAbbr</span>@Resources.CommAndTotal)
        </th>
        <th class="sorting hidden-stack-mode" rowspan="2" data-sortedname="Company" data-colindex="8">@Resources.Company</th>
        <th class="sorting visible-stack-mode" rowspan="2" data-sortedname="Company" data-colindex="4">@Resources.Company</th>
    </tr>
    <tr class="thead-row2">
        <th class="hidden-stack-mode col-winloss sorting" data-sortedname="@(Model.CustLevel.DisplayName + WinLossViewModel.NetWinLossWinLoss)" data-colindex="5">@Resources.WinLoss</th>
        <th class="hidden-stack-mode sorting" data-sortedname="@(Model.CustLevel.DisplayName + WinLossViewModel.NetWinLossComm)" data-colindex="6">@Resources.Comm</th>
        <th class="hidden-stack-mode sorting" data-sortedname="@(Model.CustLevel.DisplayName + WinLossViewModel.NetWinLossTotal)" data-colindex="7">@Resources.Total</th>
    </tr>
}

@helper RenderTableHeaderForAgent()
{
    <tr>
        <th class="sorting" rowspan="2" data-sortedname="CustName" data-colindex="0">@Resources.Username</th>
        <th rowspan="2" class="hidden-stack-mode sorting" data-sortedname="Turnover" data-colindex="1">@Resources.Turnover</th>
        <th rowspan="2" class="hidden-stack-mode sorting" data-sortedname="GrossComm" data-colindex="2">@Resources.GrossComm</th>
        <th rowspan="2" class="visible-stack-mode col-combine sorting" data-sortedname="Turnover" data-colindex="1">
            <span class="prior-sortedcolumn">@Resources.TurnoverAbbr</span>/ @Resources.GrossComm
        </th>
        <th colspan="3" class="col-level hidden-stack-mode">@Resources.Member</th>
        <th class="visible-stack-mode col-combine sorting" data-sortedname="MemberNetWinLoss.WinLoss" rowspan="2" data-colindex="2">
            @Resources.Member
            <br />
            (<span class="prior-sortedcolumn">@Resources.WinLossAbbr</span>@Resources.CommAndTotal)
        </th>
        <th colspan="3" class="col-level hidden-stack-mode">@Model.CustLevelName</th>
        <th class="visible-stack-mode col-combine sorting" data-sortedname="AgentNetWinLoss.WinLoss" rowspan="2" data-colindex="3">
            @Model.CustLevelName
            <br />
            (<span class="prior-sortedcolumn">@Resources.WinLossAbbr</span>@Resources.CommAndTotal)
        </th>
        <th class="sorting hidden-stack-mode" rowspan="2" data-sortedname="Company" data-colindex="9">@Resources.Company</th>
        <th class="sorting visible-stack-mode" rowspan="2" data-sortedname="Company" data-colindex="4">@Resources.Company</th>
    </tr>
    <tr class="thead-row2">
        <th class="hidden-stack-mode col-winloss sorting" data-sortedname="MemberNetWinLoss.WinLoss" data-colindex="3">@Resources.WinLoss</th>
        <th class="hidden-stack-mode sorting" data-sortedname="MemberNetWinLoss.Comm" data-colindex="4">@Resources.Comm</th>
        <th class="hidden-stack-mode sorting" data-sortedname="MemberNetWinLoss.Total" data-colindex="5">@Resources.Total</th>

        <th class="hidden-stack-mode col-winloss sorting" data-sortedname="@(Model.CustLevel.DisplayName + WinLossViewModel.NetWinLossWinLoss)" data-colindex="6">@Resources.WinLoss</th>
        <th class="hidden-stack-mode sorting" data-sortedname="@(Model.CustLevel.DisplayName + WinLossViewModel.NetWinLossComm)" data-colindex="7">@Resources.Comm</th>
        <th class="hidden-stack-mode sorting" data-sortedname="@(Model.CustLevel.DisplayName + WinLossViewModel.NetWinLossTotal)" data-colindex="8">@Resources.Total</th>
    </tr>
}

@helper RenderRow(WinLossModel data, bool isTotalRow, string betListPath)
{
    var isDormantAccounts = data.CustId == 0;
    <tr class="@(isTotalRow ? "tbl-footer" : (isDormantAccounts ? "dormant-accounts-mark" : string.Empty))">
        <td @(isDormantAccounts ? string.Empty : "data-islink=true") class="text-left col-username">
            @if (isTotalRow)
            {
                @Resources.Total
            }
            else if (isDormantAccounts)
            {
                <span class="pull-left">@Resources.DormantAccounts</span>
                <span class="icon icon-information-outline icon-dormant-accounts" title="@Resources.SummaryOfDormantAccounts"></span>
            }
            else
            {
                <a href="@Model.BuildDrillDownLink(data, Request.Url.Query)"
                   class="@(Model.CustLevel.IsAgentLevel() ? string.Empty : "downline-link")"
                   data-custname="@data.CustName">
                    @data.CustName
                </a>
            }
        </td>
        @if (Model.CustLevel.IsNotAgentLevel())
        {
            if (isTotalRow)
            {
                <td></td>
            }
            else
            {
                <td class="text-center">@(data.IsDirectMember ? Resources.DirectMember : Model.LevelTypeValue)</td>
            }
        }
        @if (Model.IsStackMode)
        {
            if (Model.CustLevel.IsAgentLevel())
            {
                @HtmlHelpers.RenderStackCell("col-turnover-combined", 1, data.Turnover, data.GrossComm);

            }
            else
            {
                @HtmlHelpers.RenderStackCell("col-turnover-combined", 1, data.Turnover, data.GrossComm,
                                            Model.CustLevel.IsSuperLevel() ? data.MasterNetWinLoss.Total : data.AgentNetWinLoss.Total);
            }

            @RenderStackNetWinLoss(UserLevel.Member, data.MemberNetWinLoss);
            @RenderStackNetWinLoss(UserLevel.Agent, data.AgentNetWinLoss, Model.CustLevel.IsAgentLevel());
            @RenderStackNetWinLoss(UserLevel.Master, data.MasterNetWinLoss, Model.CustLevel.IsMasterLevel());
            @RenderStackNetWinLoss(UserLevel.Super, data.SuperNetWinLoss, isHighlight: true);
        }
        else
        {
            @HtmlHelpers.RenderNumberCell(data.Turnover, "col-turnover")
            @HtmlHelpers.RenderNumberCell(data.GrossComm, "col-gross-com")

            @RenderNetWinLoss(UserLevel.Member, data.MemberNetWinLoss)
            @RenderNetWinLoss(UserLevel.Agent, data.AgentNetWinLoss, Model.CustLevel.IsAgentLevel())
            @RenderNetWinLoss(UserLevel.Master, data.MasterNetWinLoss, Model.CustLevel.IsMasterLevel())
            @RenderNetWinLoss(UserLevel.Super, data.SuperNetWinLoss, isHighlight: true)
        }
        <td class="text-right col-company">@HtmlHelpers.FormatNumber(data.Company)</td>
    </tr>
}

@helper RenderStackNetWinLoss(UserLevel level, NetWinLoss netWinLoss, bool isHighlight = false)
{
    if (netWinLoss == null)
    {
        return;
    }

    var highlightCellClass = isHighlight ? "altercol" : string.Empty;

    if (netWinLoss.WinLoss != null)
    {
        @HtmlHelpers.RenderStackCell(
        $"col-{level.DisplayName.ToLower()}-winloss-combined {highlightCellClass}",
        1,
        netWinLoss.WinLoss.Value,
        netWinLoss.Comm.Value,
        netWinLoss.Total);
    }
}

@helper RenderNetWinLoss(UserLevel level, NetWinLoss netWinLoss, bool isHighlight = false)
{
    if (netWinLoss == null)
    {
        return;
    }

    var highlightCellClass = isHighlight ? "altercol" : string.Empty;
    if (netWinLoss.WinLoss != null)
    {
        @HtmlHelpers.RenderNumberCell(netWinLoss.WinLoss.Value, $"col-{level.DisplayName.ToLower()}-winloss {highlightCellClass}")
        @HtmlHelpers.RenderNumberCell(netWinLoss.Comm.Value, highlightCellClass)
    }

    @HtmlHelpers.RenderNumberCell(netWinLoss.Total, $"bold {highlightCellClass} col-cust-total")
}