@model EnteredResultFilterViewModel

<form class="form-inline filter" role="form" id="report-form"
      action="@Url.Action("Index", "WinLoss")">
    @RenderHiddenFields()
    @DateRangePicker.Render(Model.DateRangePickerViewModel)

    <div class="form-group">
        <span id="icon-excel" class="icon-excel" title="@Resources.ExportToExcel"></span>
    </div>

    <div class="note">
        <span class="star">*</span>@Model.ViewDataInstructionMessage <a id="historic-report" href="#">@Model.ViewActionMessage</a>
    </div>

    @helper RenderHiddenFields()
    {
        @Html.Hidden("IsHistoricReport", false)
        @Html.Hidden("IsFilterVisible", Model.Visible)
        @Html.Hidden("IsStackMode", false)
        @Html.Hidden("SortPropertyName", "CustName")
        @Html.Hidden("IsDescendingSort", false)
    }
</form>