@model SuperWinLossDetailByPTViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Super Win Loss Detail By PT";
}

@ReportTitle.Render(
    new PageHeaderViewModel(Model.Title, true, true, Model.IsStackMode, Model.IsFilterVisible, Enumerable.Empty<CustInfo>(), string.Empty),
    Request.Url.Query)

@Html.Partial("~/Features/SuperWinLossDetailByPT/Views/Filter.cshtml", Model.FilterViewModel,
    new ViewDataDictionary
    {
        { "IsStackMode", Model.IsStackMode },
        { "IsDescendingSort", Model.IsDescendingSort },
        { "SortPropertyName", Model.SortPropertyName }
    })

@Html.Partial("~/Features/SuperWinLossDetailByPT/Views/ReportData.cshtml", Model)

@Html.Partial("~/Features/SuperWinLossDetailByPT/Views/ViewProductPTList.cshtml", Model)

<form class="form-inline hide" role="form" id="export-excel-form"
      action="@Url.Action("Excel", $"{Alpha.Reports.Configurations.SiteSettings.ReportRouting}SuperWinLossDetailByPT")">
    @Html.Hidden("CustId", Model.CustId)
    @Html.Hidden("FromDate", Model.FromDate)
    @Html.Hidden("ToDate", Model.ToDate)
    @Html.Hidden("UserSelectedProductIds", Model.UserSelectedProductIds)
    @Html.Hidden("UserSelectedResourceIds", Model.UserSelectedResourceIds)
    @Html.Hidden("IsPostBack", "true")
</form>

@Html.Hidden("IsSetDefaultStackMode", Model.IsSetDefaultStackMode)
@Html.Hidden("LoadLegendURL", Url.Action("ReportLegend", $"{Alpha.Reports.Configurations.SiteSettings.ReportRouting}WinLossDetail", new { MinDate = Model.MinDate }))

@section Scripts {
    @StaticResources.RenderScripts($"~/{Alpha.Reports.Configurations.SiteSettings.ReportRouting}Features/SuperWinLossDetailByPT/Bundles/superwinlossdetailbypt")
}