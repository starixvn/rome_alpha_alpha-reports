@using Alpha.Reports.Features.BetCreditTracking.MoveStatementHistory.Models
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Resources.MoveStatementHistory;
}
@model MoveStatementHistoryViewModel
@section Styles {
    @StaticResources.AssetStyles.RenderCommonWithDarkMode($"/bundles/site-reports/tab-{Model.CustLevel.ToLowerInvariant()}")
    @StaticResources.RenderStyles("~/Features/BetCreditTracking/Bundles/movestatementhistory")
}
@section Scripts {
    @StaticResources.RenderScripts("~/Features/BetCreditTracking/Bundles/movestatementhistory")
}
<div class="page-title @(Model.IsFilterVisible ? string.Empty : "hide-filter")">
    <ul class="nav nav-tabs" role="tablist">
        <li role="presentation">
            @Html.ActionLink(@Resources.BetCreditHistory, "Index", "BetCreditHistory")
        </li>
        <li role="presentation" class="active">
            <a href="#moveStatementHistory" aria-controls="home" role="tab" data-toggle="tab">@Resources.MoveStatementHistory</a>
        </li>
    </ul>

    <div class="list-icon">
        <ul>
             <li class="showfilter-element"><span class="icon-arrow-up-drop-circle icon-filter" title="@Resources.HideFilter"></span></li>
             <li class="hidefilter-element"><span class="icon-arrow-down-drop-circle icon-filter" title="@Resources.ShowFilter"></span></li>
        </ul>
    </div>
</div>
<div class="tab-content">
    <div role="tabpanel" class="tab-pane active" id="moveStatementHistory">
        @{
            Html.RenderPartial("~/Features/BetCreditTracking/Views/MoveStatementHistory/_Filter.cshtml", Model);
        }
        <table id="tbl-report" class="tblRpt tblRpt-bordered alternative-row-table width-100per tablesorter tblRpt-hover tbl-small-width">
            <thead>
                <tr>
                    <th>@Resources.MemberRefNo</th>
                    <th>@Resources.OldEventDate</th>
                    <th>@Resources.NewEventDate</th>
                    <th>@Resources.MemberWinLossNew</th>
                    <th>@Resources.MemberComm</th>
                    <th>@Resources.MemberTotal</th>
                </tr>
            </thead>
            @if (Model.ReportData.Any())
            {
                <tbody>
                    @BuildReport(Model.ReportData.DataSource)
                </tbody>
                <tfoot>
                    <tr class="tbl-footer">
                        <td class="text-left">@Resources.Total</td>
                        <td></td>
                        <td></td>
                        <td>@HtmlHelpers.FormatNumber(Model.ReportData.TotalData.MemberWinLoss)</td>
                        <td>@HtmlHelpers.FormatNumber(Model.ReportData.TotalData.MemberComm)</td>
                        <td>@HtmlHelpers.FormatNumber(Model.ReportData.TotalData.MemberTotal)</td>
                    </tr>
                </tfoot>
            }
            else
            {
                @NoInformation.Render(6)
            }
        </table>
    </div>
</div>

<form class="form-inline hide" role="form" id="export-excel-form"
      action="@Url.Action("Excel", "MoveStatementHistory")">
    @Html.Hidden("MemberUsername", Model.MemberUsername)
    @Html.Hidden("FromDate", Model.FromDate)
    @Html.Hidden("ToDate", Model.ToDate)
</form>

@helper BuildReport(IEnumerable<MoveStatementHistoryModel> dataSource)
{
    @*<tr class="member-row">
        <td class="text-left">
            
        </td>
        <td></td>
        <td></td>
        <td>200</td>
        <td>300</td>
        <td class="total">400</td>
    </tr>*@
    foreach (var record in dataSource)
    {
        <tr>
            <td>
                <a href="@Model.GetBetListLinkRouteValues(record)">
                    Member1
                </a>
                @*<span class="refno">
                    @record.MemberRefNo
                </span>*@
            </td>
            <td>@record.OldEventDate.ToShortDateWithSlash()</td>
            <td>@record.NewEventDate.ToShortDateWithSlash()</td>
            <td>@HtmlHelpers.FormatNumber(record.MemberWinLoss)</td>
            <td>@HtmlHelpers.FormatNumber(record.MemberComm)</td>
            <td class="total">@HtmlHelpers.FormatNumber(record.MemberTotal)</td>
        </tr>
    }
}    