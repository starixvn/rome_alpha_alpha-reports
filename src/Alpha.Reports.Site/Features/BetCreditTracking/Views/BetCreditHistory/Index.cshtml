@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Resources.BetCreditHistory;
    var userguideLink = Model.GetUserGuideLink(Session.IsCookieless, Request.Headers["Host"], Session.SessionID);
    var level = Model.CustLevel.ToLowerInvariant();
}
@model BetCreditHistoryViewModel
@section Styles {
    @StaticResources.AssetStyles.Render("/bundles-v2/site-reports/betcredittracking")
    @StaticResources.RenderStyles($"~/{Alpha.Reports.Configurations.SiteSettings.ReportRouting}Features/BetCreditTracking/Bundles/betcredithistory")
}
@section Scripts {
    @StaticResources.AssetScripts.Render("/bundles-v2/site-reports/betcredittracking")
    @StaticResources.RenderScripts($"~/{Alpha.Reports.Configurations.SiteSettings.ReportRouting}/Features/BetCreditTracking/Bundles/betcredithistory")
}
<div class="page-title tabs @level @(Model.IsFilterVisible ? string.Empty : "hide-filter")">
    <ul class="nav nav-tabs" role="tablist">
        <li role="presentation" class="active">
            <a href="#betCreditHistory" aria-controls="home" role="tab" data-toggle="tab">@Resources.BetCreditHistory</a>
        </li>
        <li role="presentation">
            @Html.ActionLink(Resources.MoveStatementHistory, "Index", $"{Alpha.Reports.Configurations.SiteSettings.ReportRouting}MoveStatementHistory")
        </li>
        <li class="tab-icon">
            <a href="@userguideLink" target="_blank"><span class="ic-information"></span></a>
        </li>
    </ul>
    <div class="list-icon">
        <ul>
            <li class="showfilter-element"><span class="icon-arrow-up-drop-circle icon-filter" title="@Resources.HideFilter"></span></li>
            <li class="hidefilter-element"><span class="icon-arrow-down-drop-circle icon-filter" title="@Resources.ShowFilter"></span></li>
        </ul>
    </div>
</div>
<div class="tab-content">
    <div role="tabpanel" class="tab-pane active" id="betCreditHistory">
        @{
            Html.RenderPartial("~/Features/BetCreditTracking/Views/BetCreditHistory/_Filter.cshtml", Model);
        }
        @if (Model.Data != null && Model.ErrMsg == string.Empty)
        {
            <table id="tbl-report" class="tb tb-bordered tb-hover w-full tablesorter text-right">
                <thead>
                    <tr>
                        <th class="action-datetime-col">@Resources.ActionDateTime</th>
                        <th>@Resources.WinLossDate</th>
                        <th>@Resources.refno</th>
                        <th>@Resources.ActualStake</th>
                        <th>@Resources.WinLoss</th>
                        <th>@Resources.PlayerComm</th>
                        <th>@Resources.BalanceChange</th>
                        <th>@Resources.NewBalance</th>
                        <th>@Resources.GivenCredit</th>
                        <th>@Resources.BetCredit</th>
                        <th class="action-col">@Resources.Action</th>
                    </tr>
                </thead>
                @if (Model.Data.Any())
                {
                    <tbody>
                        @BuildReport(Model.Data)
                    </tbody>
                }
                else
                {
                    @NoInformation.Render(11)
                }
            </table>
        }
    </div>
</div>
@Pager.Render(Model.PagerViewModel)
<form class="form-inline hide" role="form" id="export-excel-form"
      action="@Url.Action("Excel", $"{Alpha.Reports.Configurations.SiteSettings.ReportRouting}BetCreditHistory")">
    @Html.Hidden("Member", Model.Member)
    @Html.Hidden("RefNo", Model.RefNo)
    @Html.Hidden("FromDate", Model.FromDate)
    @Html.Hidden("ToDate", Model.ToDate)
</form>

@helper BuildReport(IEnumerable<BetCreditHistoryModel> data)
{
    var isEvenRow = false;
    foreach (var record in data)
    {
        <tr class="@(record.BetCredit == null ? "highlight-row" : (isEvenRow ? "even-row" : string.Empty))">
            <td>@record.ActionDateString</td>
            <td class="text-center">@record.WinLostDateString</td>
            <td class="text-left">@record.RefNo</td>
            <td>@HtmlHelpers.FormatNullableNumber(record.ActualStake)</td>
            <td>@HtmlHelpers.FormatNullableNumber(record.WinLoss) </td>
            <td>@HtmlHelpers.FormatNullableNumber(record.PlayerComm)</td>
            <td>@HtmlHelpers.FormatNullableNumber(record.BalanceChanged)</td>
            <td>@HtmlHelpers.FormatNullableNumber(record.NewBalance)</td>
            <td>@HtmlHelpers.FormatNumber(record.GivenCredit)</td>
            <td class="@(record.BetCredit < (decimal)0 ? "red-cell" : "")">@HtmlHelpers.FormatNullableNumber(record.BetCredit)</td>
            <td class="text-left">@record.Action</td>
        </tr>
        isEvenRow = !isEvenRow;
    }
}

@Html.Hidden("UsernameIsRequired", Resources.UsernameIsRequired)
@Html.Hidden("InvalidRefNo", Resources.InvalidRefNo)
@if (Model.ErrMsg != string.Empty)
{
    @Html.Hidden("ErrMsg", Model.ErrMsg)
}