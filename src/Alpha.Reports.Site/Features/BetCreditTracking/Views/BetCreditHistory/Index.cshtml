@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Resources.BetCreditHistory;
}
@model BetCreditHistoryViewModel
@section Styles {
    @StaticResources.AssetStyles.RenderCommon($"/bundles/site-reports/tab-{Model.CustLevel.ToLowerInvariant()}")
}
@section Scripts {
    @*@StaticResources.RenderScripts("")*@
}
<ul class="nav nav-tabs" role="tablist">
    <li role="presentation" class="active">
        <a href="#betCreditHistory" aria-controls="home" role="tab" data-toggle="tab">@Resources.BetCreditHistory</a>
    </li>
    <li role="presentation">
        @Html.ActionLink(Resources.StatementMovement, "Index", "StatementMovement")
    </li>
</ul>
<div class="tab-content">
    <div role="tabpanel" class="tab-pane active" id="betCreditHistory">
        Bet Credit History
    </div>
</div>