@{
    Layout = null;
}

@model BetCreditHistoryViewModel

@using (Html.BeginForm("Index", "BetCreditHistory", FormMethod.Get, new { @class = "form-inline filter" + (Model.IsFilterVisible ? string.Empty : " hide"), role = "form", id = "report-form" }))
{
    <input type="hidden" value="@Model.IsFilterVisible.ToString().ToLowerInvariant()" name="IsFilterVisible" id="IsFilterVisible" />

    <div class="form-group">
        <label>@Resources.Member</label>
        <input type="text" maxlength="50" autocomplete="off" name="Member" value="@Model.Member" placeholder="@Resources.Username" />
    </div>

    <div class="form-group">
        <label>@Resources.refno</label>
        <input type="text" maxlength="50" autocomplete="off" name="RefNo" value="@Model.RefNo" />
    </div>

    @DateRangePicker.Render(Model.DateRangePickerViewModel);

    <div class="form-group">
        <span id="icon-excel" class="icon-excel" title="@Resources.ExportToExcel"></span>
    </div>
}