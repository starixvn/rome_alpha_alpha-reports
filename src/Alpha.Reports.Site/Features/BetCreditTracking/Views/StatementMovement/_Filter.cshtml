@{
    Layout = null;
}

@model StatementMovementViewModel

@using (Html.BeginForm("Index", "StatementMovement", FormMethod.Get, new { @class = "form-inline filter" + (Model.IsFilterVisible ? string.Empty : " hide"), role = "form", id = "report-form" }))
{
    <input type="hidden" value="@Model.IsFilterVisible.ToString().ToLowerInvariant()" name="IsFilterVisible" id="IsFilterVisible" />

    <div class="form-group">
        <input type="text" style="width: 150px;" maxlength="50" autocomplete="off" name="MemberUsername" value="@Model.MemberUsername" placeholder="@Resources.MemberUsername" />
    </div>

    @DateRangePicker.Render(Model.DateRangePickerViewModel, null, Resources.OddEventDateFrom);

    <div class="form-group">
        <span id="icon-excel" class="icon-excel" title="@Resources.ExportToExcel"></span>
    </div>

    <div class="note">
        <span class="star">*</span>@Model.ViewDataInstructionMessage
    </div>

    <div class="note" style="margin-left: 14px;">
        @Resources.StatementMovementNote
    </div>
}