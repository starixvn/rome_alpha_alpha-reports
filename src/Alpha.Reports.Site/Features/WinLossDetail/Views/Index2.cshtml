@model WinLossDetailNewViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Win Loss Detail Report";
    var jsonSettings = new JsonSerializerSettings { Formatting = Formatting.None, NullValueHandling = NullValueHandling.Ignore };
}
@section Styles {
    @StaticResources.AssetStyles.Render("/bundles-v2/site-reports/winlossdetailnew")
    @StaticResources.RenderStyles("~/assets/bundles-v2/winlossdetailnew")
}
@section Scripts {
    <script type="text/javascript">
        var productList = $.parseJSON('@Html.Raw(JsonConvert.SerializeObject(Model.Products, jsonSettings))');
        var productDetailList = $.parseJSON('@Html.Raw(JsonConvert.SerializeObject(Model.ProductDetails, jsonSettings))');
        var columnList = [
            { value: "fullname", text: '@Resources.FirstLastName', checked: false },
            { value: "betcount", text: '@Resources.BetCount' },
            { value: "turnover", text: '@Resources.Turnover' },
            { value: "netturnover", text: '@Resources.NetTurnover' },
            { value: "grosscomm", text: '@Resources.GrossComm' },
            { value: "pwinloss", text: '@Resources.MemberWinLossNew' },
            { value: "pcomm", text: '@Resources.MemberCommNew' },
            { value: "ptotal", text: '@Resources.MemberTotalNew' },
            { value: "awinloss", text: '@Resources.AgentWinLossNew' },
            { value: "acomm", text: '@Resources.AgentCommNew' },
            { value: "atotal", text: '@Resources.AgentTotalNew' },
            @if (Model.ViewerLevel.IsMasterOrSuperLevel())
            {
                @:{ value: "mwinloss", text: '@Resources.MasterWinLossNew' },
                @:{ value: "mcomm", text: '@Resources.MasterCommNew' },
                @:{ value: "mtotal", text: '@Resources.MasterTotalNew' },
            }
            @if (Model.ViewerLevel.IsSuperLevel())
            {
                @:{ value: "swinloss", text: '@Resources.SuperWinLossNew' },
                @:{ value: "scomm", text: '@Resources.SuperCommNew' },
                @:{ value: "stotal", text: '@Resources.SuperTotalNew' },
            }
            { value: "company", text: '@Resources.Company' },
            { value: "reward", text: '@Resources.Reward' }
        ];
        var reportTitle = {
            2: '@Resources.MemberWinLossDetail',
            @if (Model.ViewerLevel.IsMasterOrSuperLevel())
            {
                @:3: '@Resources.AgentWinLossDetail',
            }
            @if (Model.ViewerLevel.IsSuperLevel())
            {
                @:4: '@Resources.MasterWinLossDetail'
            }
        };
        var levelTypeText = {
            @if (Model.ViewerLevel.IsMasterOrSuperLevel())
            {
                @:3: '@Resources.Agent',
            }
            @if (Model.ViewerLevel.IsSuperLevel())
            {
                @:4: '@Resources.MasterAgent'
            }
        };
    </script>
    @StaticResources.AssetScripts.RenderCommon("/bundles/site-reports/winlossdetail-new")
    @StaticResources.RenderScripts($"~/{SiteSettings.ReportRouting}Features/WinLossDetail/Bundles/winlossdetail-new")
}
<div class="flex">
    <div class="top-filter">
        @ReportTitleNew.Render(string.Empty, showIconInfo: true, enteredSportResult: Model.TotalEnteredSport)
        <div class="form-inline filter" id="report-form">
            @DateRangePickerJQuery.Render(Model.DateRangePickerViewModel)
            @ProductAndProductDetailDropdown.Render()
            @LevelTypeDropdown.Render(Model.ViewerLevel, Model.CustLevel, Model.LevelType)
            @UsernameAutoSuggestion.Render(Model.Username)
            @VisibleColumnsDropdown.Render()
        </div>
    </div>
    <div class="label-week-box" id="week-selection">
        @{ Html.RenderPartial("~/Features/WinLossDetail/Views/Weeks.cshtml", Model.Weeks); }
    </div>
    <div id="report-week-selection" class="cover-week-selection" style="visibility:hidden">
        @Html.Partial("~/Features/WinLossDetail/Views/ReportData2.cshtml", Model)
    </div>
</div>
<input type="hidden" id="hiddenViewerId" value="@Model.ViewerId" />
<input type="hidden" id="hiddenViewerName" value="@Model.ViewerName" />
<input type="hidden" id="hiddenViewerLevel" value="@Model.ViewerLevel.Value" />
<input type="hidden" id="hiddenSubAccId" value="@Model.SubAccId" />
<input type="hidden" id="hiddenCustId" value="@Model.CustId" />
<input type="hidden" id="hiddenCustName" value="@Model.CustName" />
<input type="hidden" id="hiddenCustLevel" value="@Model.CustLevel.Value" />
<input type="hidden" id="hiddenLegendUrl" value="@Url.Action("ReportLegend", $"{SiteSettings.ReportRouting}WinLossDetail", new { IsNew = true, IsSupportHistoricReport = true, MinDate = Model.DateRangePickerViewModel.MinDate, ShowDormantAccountsNote = true })" />
<input type="hidden" id="hiddenGetDataUrl" value="@Url.Action("GetData2", $"{SiteSettings.ReportRouting}WinLossDetail")" />
<input type="hidden" id="hiddenGetWeeksUrl" value="@Url.Action("GetWeeks2", $"{SiteSettings.ReportRouting}WinLossDetail")" />
<input type="hidden" id="hiddenGetDataWeekUrl" value="@Url.Action("GetDataWeek2", $"{SiteSettings.ReportRouting}WinLossDetail")" />
<input type="hidden" id="hiddenBetListsUrl" value="@Alpha.Reports.Site.Helpers.UrlHelper.MapBetListPath("~/WinLoss/Index2")" />
<input type="hidden" id="hiddenUsernameAutoSuggestionUrl" value="@Url.Action("Get", $"{SiteSettings.ReportRouting}UsernameSuggestion")" />
@if (!string.IsNullOrWhiteSpace(Model.WeekFromDate) && !string.IsNullOrWhiteSpace(Model.WeekToDate))
{
    <input type="hidden" id="hiddenWeekFromDate" value="@Model.WeekFromDate" />
    <input type="hidden" id="hiddenWeekToDate" value="@Model.WeekToDate" />
}
<input type="hidden" id="hiddenCopyText" value="@Resources.Copy" />
<input type="hidden" id="hiddenCopiedText" value="@Resources.Copied" />
<input type="hidden" id="hiddenMainDomain" value="@Model.MainDomain" />
<input type="hidden" id="hiddenShowColumns" value="@Model.ShowColumns" />
<input type="hidden" id="hiddenMemberInfoUrl" value="@MicroSites.MemberInfoUrl()" />
