@model WinLossDetailNewViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Win Loss Detail Report";
    var jsonSettings = new JsonSerializerSettings { Formatting = Formatting.None, NullValueHandling = NullValueHandling.Ignore };
}
@section Styles {
    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/site-asset/daterangepicker")
}
@section Scripts {
    <script type="text/javascript">
        var productList = $.parseJSON('@Html.Raw(JsonConvert.SerializeObject(Model.Products, jsonSettings))');
        var productDetailList = $.parseJSON('@Html.Raw(JsonConvert.SerializeObject(Model.ProductDetails, jsonSettings))');
    </script>
    @StaticResources.AssetScripts.RenderCommon("/bundles/site-asset/daterangepicker")
    @StaticResources.RenderScripts($"~/{SiteSettings.ReportRouting}Features/WinLossDetail/Bundles/winlossdetail-new")
}
@ReportTitleNew.Render(Model.ViewerLevel.IsSuperLevel()
    ? Resources.MasterWinLossDetail
    : Model.ViewerLevel.IsMasterLevel() ? Resources.AgentWinLossDetail : Resources.MemberWinLossDetail, Model.TotalEnteredSport)
<div class="form-inline filter">
    <div class="switch-version">
        <a href="@Url.Action("Index", $"{SiteSettings.ReportRouting}WinLossDetail")" class="btn-switch-version" target="main">
            <span class="icon-swap-horizontal"></span>
            <span class="text">@Resources.ClassicView</span>
        </a>
    </div>
    @DateRangePickerJQuery.Render(Model.DateRangePickerViewModel)
    @ProductAndProductDetailDropdown.Render()
    @VisibleColumnsDropdown.Render(Model.Columns)
    <div class="label-week-box" id="labelWeekRange"></div>
</div>
<div class="breadcrumb-table">
    <div class="breadcrumb-container">
        <ul class="breadcrumb" id="breadcrumb"></ul>
    </div>
    <div class="list-icon">
        <ul>
            <li>
                <a href="javacript:;"
                   id="icon-excel"
                   class="icon icon-excel"
                   title="@Resources.ExportToExcel"
                   data-url="@Url.Action("ExcelNew", $"{SiteSettings.ReportRouting}WinLossDetail")"></a>
            </li>
        </ul>
    </div>
</div>
<div style="visibility:hidden" id="tbl-report-container" class="scrollable">
    @Html.Partial("~/Features/WinLossDetail/Views/ReportDataNew.cshtml", Model)
</div>
<input type="hidden" id="hiddenViewerId" value="@Model.ViewerId" />
<input type="hidden" id="hiddenViewerName" value="@Model.ViewerName" />
<input type="hidden" id="hiddenViewerLevel" value="@Model.ViewerLevel.Value" />
<input type="hidden" id="hiddenSubAccId" value="@Model.SubAccId" />
<input type="hidden" id="hiddenCustId" value="@Model.CustId" />
<input type="hidden" id="hiddenCustName" value="@Model.CustName" />
<input type="hidden" id="hiddenCustLevel" value="@Model.CustLevel.Value" />
<input type="hidden" id="hiddenLegendUrl" value="@Url.Action("ReportLegendNew", $"{SiteSettings.ReportRouting}WinLossDetail", new { IsSupportHistoricReport = true, MinDate = Model.DateRangePickerViewModel.MinDate })" />
<input type="hidden" id="hiddenWinLossDetailUrl" value="@Url.Action("GetData", $"{SiteSettings.ReportRouting}WinLossDetail")" />
<input type="hidden" id="hiddenBetListsUrl" value="@Model.BetListsUrl" />
<input type="hidden" id="hiddenBreadcrumbLevelJson" value="@Model.BreadcrumbLevelJson" />
