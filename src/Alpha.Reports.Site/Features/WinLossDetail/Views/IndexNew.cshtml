@model WinLossDetailNewViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Win Loss Detail Report";
    var jsonSettings = new JsonSerializerSettings { Formatting = Formatting.None, NullValueHandling = NullValueHandling.Ignore };
    var canViewHistory = Model.DateRangePickerViewModel.MinDate < Model.DateRangePickerViewModel.HistoricPivotDate;
}
@section Styles {
    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/site-reports/winlossdetail-new")
}
@section Scripts {
    <script type="text/javascript">
        var productList = $.parseJSON('@Html.Raw(JsonConvert.SerializeObject(Model.Products, jsonSettings))');
        var productDetailList = $.parseJSON('@Html.Raw(JsonConvert.SerializeObject(Model.ProductDetails, jsonSettings))');
        var columnList = [
            { value: "fullname", text: '@Resources.FirstLastName', checked: false },
            { value: "betcount", text: '@Resources.BetCount' },
            { value: "turnover", text: '@Resources.Turnover' },
            { value: "netturnover", text: '@Resources.NetTurnover' },
            { value: "grosscomm", text: '@Resources.GrossComm' },
            { value: "pwinloss", text: '@string.Format("{0} {1}", Resources.Member, Resources.WinLoss)' },
            { value: "pcomm", text: '@string.Format("{0} {1}", Resources.Member, Resources.Comm)' },
            { value: "ptotal", text: '@string.Format("{0} {1}", Resources.Member, Resources.Total)' },
            { value: "awinloss", text: '@string.Format("{0} {1}", Resources.Agent, Resources.WinLoss)' },
            { value: "acomm", text: '@string.Format("{0} {1}", Resources.Agent, Resources.Comm)' },
            { value: "atotal", text: '@string.Format("{0} {1}", Resources.Agent, Resources.Total)' },
            @if (Model.ViewerLevel.IsMasterOrSuperLevel())
            {
                @:{ value: "mwinloss", text: '@string.Format("{0} {1}", Resources.Master, Resources.WinLoss)' },
                @:{ value: "mcomm", text: '@string.Format("{0} {1}", Resources.Master, Resources.Comm)' },
                @:{ value: "mtotal", text: '@string.Format("{0} {1}", Resources.Master, Resources.Total)' },
            }
            @if (Model.ViewerLevel.IsSuperLevel())
            {
                @:{ value: "swinloss", text: '@string.Format("{0} {1}", Resources.Super, Resources.WinLoss)' },
                @:{ value: "scomm", text: '@string.Format("{0} {1}", Resources.Super, Resources.Comm)' },
                @:{ value: "stotal", text: '@string.Format("{0} {1}", Resources.Super, Resources.Total)' },
            }
            { value: "company", text: '@Resources.Company' }
        ];
        var reportTitle = {
            2: '@Resources.MemberWinLossDetail',
            @if (Model.ViewerLevel.IsMasterOrSuperLevel())
            {
                @:3: '@Resources.AgentWinLossDetail',
            }
            @if (Model.ViewerLevel.IsSuperLevel())
            {
                @:4: '@Resources.MasterWinLossDetail'
            }
        };
    </script>
    @StaticResources.AssetScripts.RenderCommon("/bundles/site-reports/winlossdetail-new")
    @StaticResources.RenderScripts($"~/{SiteSettings.ReportRouting}Features/WinLossDetail/Bundles/winlossdetail-new")
}
<div class="flex">
    <div class="top-filter">
        @ReportTitleNew.Render(Model.TotalEnteredSport)
        <div class="form-inline filter" id="form-filter">
            @HtmlHelpers.RenderSwitchVersionButton(Resources.ClassicView, Url.Action(Model.ViewerLevel.GetDirectDownLineLevel().DisplayName, $"{SiteSettings.ReportRouting}WinLossDetail"))
            @DateRangePickerJQuery.Render(Model.DateRangePickerViewModel)
            @ProductAndProductDetailDropdown.Render()
            @UsernameAutoSuggestion.Render()
            @VisibleColumnsDropdown.Render()
        </div>
        <div class="label-week-box" id="week-selection"></div>
        <div class="breadcrumb-table">
            <div class="breadcrumb-container">
                <ul class="breadcrumb" id="breadcrumb"></ul>
            </div>
            <div class="list-icon">
                <ul>
                    <li><span id="icon-copy" class="icon icon-content-copy" data-toggle="tooltip" data-placement="top" title="@Resources.Copy"></span></li>
                    <li>
                        <a href="javacript:;"
                           id="icon-excel"
                           class="icon icon-excel icon-excel-new"
                           data-toggle="tooltip"
                           data-placement="top"
                           title="@Resources.ExportToExcel"
                           data-url="@Url.Action("ExcelNew", $"{SiteSettings.ReportRouting}WinLossDetail")"></a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
    <div class="wrapper-table-scrollable">
        <div style="visibility:hidden" id="tbl-report-container" class="scrollable">
            @Html.Partial("~/Features/WinLossDetail/Views/ReportDataNew.cshtml", Model)
        </div>
    </div>
</div>
<input type="hidden" id="hiddenViewerId" value="@Model.ViewerId" />
<input type="hidden" id="hiddenViewerName" value="@Model.ViewerName" />
<input type="hidden" id="hiddenViewerLevel" value="@Model.ViewerLevel.Value" />
<input type="hidden" id="hiddenSubAccId" value="@Model.SubAccId" />
<input type="hidden" id="hiddenCustId" value="@Model.CustId" />
<input type="hidden" id="hiddenCustName" value="@Model.CustName" />
<input type="hidden" id="hiddenCustLevel" value="@Model.CustLevel.Value" />
<input type="hidden" id="hiddenLegendUrl" value="@Url.Action("ReportLegend", $"{SiteSettings.ReportRouting}WinLossDetail", new { IsNew = canViewHistory, IsSupportHistoricReport = true, MinDate = canViewHistory ? Model.DateRangePickerViewModel.HistoricPivotDate : Model.DateRangePickerViewModel.MinDate })" />
<input type="hidden" id="hiddenWinLossDetailUrl" value="@Url.Action("GetData", $"{SiteSettings.ReportRouting}WinLossDetail")" />
<input type="hidden" id="hiddenBetListsUrl" value="@Model.BetListsUrl" />
<input type="hidden" id="hiddenUsernameAutoSuggestionUrl" value="@Url.Action("Get", $"{SiteSettings.ReportRouting}UsernameSuggestion")" />
<input type="hidden" id="hiddenUsername" value="@Model.Username" />
@if (!string.IsNullOrWhiteSpace(Model.WeekFromDate) && !string.IsNullOrWhiteSpace(Model.WeekToDate))
{
    <input type="hidden" id="hiddenWeekFromDate" value="@Model.WeekFromDate" />
    <input type="hidden" id="hiddenWeekToDate" value="@Model.WeekToDate" />
}
<input type="hidden" id="language" data-currentlanguage="@Model.Language" />
<input type="hidden" id="hiddenCopyText" value="@Resources.Copy" />
<input type="hidden" id="hiddenCopiedText" value="@Resources.Copied" />
<input type="hidden" id="hiddenHideFilterText" value="@Resources.HideFilter" />
<input type="hidden" id="hiddenShowFilterText" value="@Resources.ShowFilter" />
<input type="hidden" id="hiddenMainDomain" value="@Model.MainDomain" />
<input type="hidden" id="hiddenShowColumns" value="@Model.ShowColumns" />
