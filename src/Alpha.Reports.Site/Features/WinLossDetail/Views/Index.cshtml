@model WinLossDetailViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Win Loss Detail Report";
}

@ReportTitle.Render(new PageHeaderViewModel(
    Model.Title,
    true,
    true,
    Model.IsStackMode,
    Model.IsFilterVisible,
    Model.BreadcrumbLevel,
    Model.BreadcrumbLevelJson),
    Request.Url.Query,
    hasEnterOrNonEnterNote: true,
    enteredSportResult: Model.TotalEnteredSport,
    isHistoricReport: Model.IsHistoricReport,
    showNewFeatureNote: false)

@Html.Partial("~/Features/WinLossDetail/Views/Filter.cshtml", Model.FilterViewModel,
    new ViewDataDictionary
    {
        { "IsStackMode", Model.IsStackMode },
        { "IsDescendingSort", Model.IsDescendingSort },
        { "SortPropertyName", Model.SortPropertyName },
        { "SSGUID", Model.SSGUID },
        { "DirectDownLineLevelName", Model.ViewerLevel.GetDirectDownLineLevel().DisplayName },
        { "IsOfferNewWinLossDetailReport", Model.IsOfferNewWinLossDetailReport }
    })

@Html.Partial(
    "~/Features/WinLossDetail/Views/ReportData.cshtml",
    Model,
    new ViewDataDictionary
    {
        ["ExportExcelController"] = "WinLossDetail",
        ["ExportExcelAction"] = "Excel"
    })
<form class="form-inline hide" role="form" id="export-excel-form"
      action="@Url.Action("Excel", $"{Alpha.Reports.Configurations.SiteSettings.ReportRouting}WinLossDetail")">
    @Html.Hidden("CustId", Model.CustId)
    @Html.Hidden("CustName", Model.CustName)
    @Html.Hidden("FromDate", Model.FromDate)
    @Html.Hidden("ToDate", Model.ToDate)
    @Html.Hidden("UserSelectedProductIds", Model.UserSelectedProductIds)
    @Html.Hidden("UserSelectedResourceIds", Model.UserSelectedResourceIds)
    @Html.Hidden("CustLevelId", Model.CustLevel.Value)
    @Html.Hidden("IsHistoricReport", Model.IsHistoricReport)
    @Html.Hidden("IsPostBack", "true")
</form>

@Html.Hidden("IsSetDefaultStackMode", Model.IsSetDefaultStackMode)
@Html.Hidden("LoadLegendURL", Url.Action("ReportLegend", $"{Alpha.Reports.Configurations.SiteSettings.ReportRouting}WinLossDetail", new { IsSupportHistoricReport = true, IsHistoricReport = Model.IsHistoricReport, MinDate = Model.MinDate, ShowDormantAccountsNote = true }))
@Html.Hidden("SubAccId", Model.SubAccId)
@Html.Hidden("CurrentCustSubId", $"{AlphaPlus.User.Models.UserSession.Current.CustId}_{AlphaPlus.User.Models.UserSession.Current.SubAccId}")

<div style="width: 474px; display: none" class="modal fade message-modal" id="ShutdownOldWinLossDetailReportMessage" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-sm" role="document" style="margin: 0; min-width: 474px">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="icon icon-close close" data-dismiss="modal" aria-label="@Resources.Close"><span aria-hidden="true"></span></button>
                <h4 class="modal-title"><span class="icon-information-outline" style="color: #0000ff; font-size: 20px">&nbsp;</span>@Resources.SwitchToNewView</h4>
            </div>
            <div class="modal-body">
                <div id="msg-content">
					<ul class="list-msg">
                        <li>
                            @string.Format(Resources.ShutdownOldWinLossDetailReportMessage, SiteSettings.GetConfigValue("ShutdownOldWinLossDetailReportDate"))
                        </li>
                        <li>
                            <label style="margin-top: 15px; cursor: pointer" for="close-ShutdownOldWinLossDetailReportMessage"><input id="close-ShutdownOldWinLossDetailReportMessage" type="checkbox" /> @Resources.DoNotShowAgain</label>
                        </li>
                    </ul>
                    
                </div>
            </div>
        </div>
    </div>
</div>

@Pager.Render(Model.PagerViewModel)

@section Scripts {
    @StaticResources.RenderScripts($"~/{Alpha.Reports.Configurations.SiteSettings.ReportRouting}Features/WinLossDetail/Bundles/winlossdetail")
}