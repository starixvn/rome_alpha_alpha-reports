@using Alpha.Reports.Site.App_GlobalResources;

@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewBag.Title = "Outstanding Report";

    var length = Model.DisplayOutstandingLevels.Count;
    var existedData = Model.OutstandingDatasource.Any();
    var levelTypeValue = Model.CustLevel.IsSuperLevel() ? Resources.MasterAgent : Resources.Agent;
}

@section Styles {
    @StaticResources.AssetStyles.Render("/bundles-v2/site-reports/outstanding")
    @StaticResources.RenderStyles($"~/{Alpha.Reports.Configurations.SiteSettings.ReportRouting}/Features/Outstanding/bundles-v2/outstanding")
}

@model OutstandingViewModel

@ReportTitle.Render(new PageHeaderViewModel(Model.Title, false, true, false, Model.IsFilterVisible, Model.BreadcrumbLevel, Model.BreadcrumbLevelJson), Request.Url.Query)

<form class="form-inline filter form-report @(Model.IsFilterVisible ? string.Empty:"hide")" role="form" id="report-form" style="display: none">
    @ProductMultiSelection.Render(Model.ProductMultiSelectionViewModel)
    @LevelTypeDropdown.Render(Model.CustLevel, Model.Query.LevelType)
    @Html.Hidden("SortPropertyName", Model.SortPropertyName)
    @Html.Hidden("IsDescendingSort", Model.IsDescendingSort)
    @Html.Hidden("IsFilterVisible", Model.IsFilterVisible)
    @Html.Hidden("CustId", Model.Query.CustId)
    @Html.Hidden("CustName", Model.Query.CustName)
    @Html.Hidden("CustLevelId", Model.CustLevel.Value)
    @Html.Hidden("BreadcrumbLevelJson", Model.BreadcrumbLevelJson)
    @Html.Hidden("CanSort", Model.CanSort)
    <div class="form-group last-group">
        <input type="submit" value="@Resources.Submit" class="btn-submit" />
    </div>
</form>
<div id="report-container" class="level-@Model.CustLevel.Value" style="width: @(Model.IsMobileView ? "100%" : "65%");">
    <table id="tbl-report"
           data-totalrecords="@Model.OutstandingDatasource.Count()"
           data-sortedcolumn="@Model.SortPropertyName"
           data-descendingsort="@Model.IsDescendingSort"
           class="@(existedData ? "hidden" : string.Empty) tb tb-bordered tb-hover tb-freeze-header w-full" style="width:100%">
        <thead>
            <tr class="hide">
                <th data-priority="0"></th>
                @if (Model.ShowLevelType)
                {
                    <th data-priority="@length"></th>
                }
                @for (var i = 1; i <= length; i++)
                {
                    <th data-priority="@(length - i)"></th>
                }
                <th></th>
            </tr>
            <tr>
                <th rowspan="2" class="header" data-name="CustName">@Resources.Username</th>
                @if (Model.ShowLevelType)
                {
                    <th rowspan="2" class="header" data-name="IsDirectMember">@Resources.Level</th>
                }
                <th colspan="@length" class="header">@Resources.Outstanding</th>
                <th rowspan="2" class="header"></th>
            </tr>
            <tr class="thead-row2">
                @for (var i = 0; i < length; i++)
                {
                    var userLevel = Model.DisplayOutstandingLevels[i];
                    <th data-priority="@(length - i)">
                        @HtmlHelpers.DisplayUserLevelText(userLevel)
                    </th>
                }
            </tr>
        </thead>
        @if (existedData)
        {
            <tbody>
                @foreach (var outstanding in Model.OutstandingDatasource.OrderBy(Model.SortPropertyName, Model.IsDescendingSort))
                {
                    <tr>
                        <td class="text-left" data-islink="true">
                            <a href="@Model.BuildDrillDownLink(outstanding, Request.Url.Query)"
                               class="downline-link">@outstanding.CustName</a>
                        </td>
                        @if (Model.ShowLevelType)
                        {
                            <td class="text-center">@(outstanding.IsDirectMember ? Resources.DirectMember : levelTypeValue)</td>
                        }
                        @RenderOutstandingCells(outstanding)
                        <td></td>
                    </tr>
                }
                <tr class="tbl-footer">
                    <td class="text-left">@Resources.Total</td>
                    @if (Model.ShowLevelType)
                    {
                        <td></td>
                    }
                    @for (var i = 0; i < length; i++)
                    {
                        <td>
                            @HtmlHelpers.FormatNumber(Model.Total.GetValueByLevel(Model.DisplayOutstandingLevels[i]))
                        </td>
                    }
                    <td class="control"></td>
                </tr>
            </tbody>
        }
    </table>

    @Html.Hidden("NoInformationIsAvailable", @Resources.NoInformationIsAvailable)
</div>

@section Scripts {
    <script>
		var displayOutstandingLevels = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.DisplayOutstandingLevels, Newtonsoft.Json.Formatting.Indented));
    </script>

    @StaticResources.AssetScripts.RenderCommon("/bundles/site-asset/data-table")
    @StaticResources.RenderScripts($"~/{Alpha.Reports.Configurations.SiteSettings.ReportRouting}Features/Outstanding/Bundles/outstanding-new")
}

@helper RenderOutstandingCells(OutstandingModel data)
{
    foreach (var level in Model.DisplayOutstandingLevels)
    {
        <td>
            @HtmlHelpers.FormatNumber(data.GetValueByLevel(level))
        </td>
    }
}