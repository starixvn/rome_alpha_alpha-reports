.control {
	display: table-cell;
	width: 15px;
	vertical-align: middle;
	margin: 0 8px 0 5px;
}

table.dataTable.dtr-column > thead > tr.parent th.control:before,
table.dataTable.dtr-column > tfoot > tr.parent td.control:before {
	content: '-';
