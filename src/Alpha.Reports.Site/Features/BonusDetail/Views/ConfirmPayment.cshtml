@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Resources.ConfirmPayment;
}
@model ConfirmPaymentViewModel
@section Styles {
    @StaticResources.RenderStyles("~/Features/BonusDetail/Bundles/confirmpayment")
}
@section Scripts {
    @StaticResources.RenderScripts("~/Features/BonusDetail/Bundles/confirmpayment")
}
@Alert.Render()
<p>@Resources.ConfirmPaymentNote</p>
@using (Html.BeginForm("ConfirmPayment", "BonusDetail", FormMethod.Post, new { @class = "form-horizontal", id = "form-confirmPayment" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" name="custId" value="@Model.CustId" />
    <input type="hidden" name="transId" value="@Model.TransId" />
    <div class="form-group">
        <label class="col-xs-3 control-label">@Resources.PaymentDate</label>
        <div class="col-xs-9">
            <div class="control date">
                <div id="payment-date-container" class="input-group date paymentdate">
                    <input type="text"
                            id="payment-date"
                            name="paymentDate"
                            readonly="readonly"
                            autocomplete="off"
                            class="ui_nexdatepicker_datetextbox ui_nexdatepicker_fromdate form-control"
                            value="@Model.PaymentDate.ToShortDateWithSlash()" />
                    <span class="input-group-addon">
                        <label class="icon-calendar" for="payment-date"></label>
                    </span>
                </div>
            </div>
        </div>
    </div>
    <div class="form-group">
        <label class="col-xs-3 control-label">@Resources.ToMember</label>
        <label class="col-xs-9 control-label">@Model.CustName</label>
    </div>
    <div class="form-group">
        <label class="col-xs-3 control-label">@Resources.Amount</label>
        <label class="col-xs-9 control-label">@HtmlHelpers.FormatNumber(Model.Amount)</label>
    </div>
    <div class="form-group">
        <label class="col-xs-3 control-label">@Resources.BonusDetailRefNo</label>
        <label class="col-xs-9 control-label">@Model.TransId</label>
    </div>
    <div class="form-group list-button">
        <button type="submit" class="btn-submit">@Resources.Submit</button>
    </div>
}
<input type="hidden" value="@SystemTime.Today.ToShortDateWithSlash()" id="hidden-maxPaymentDate" />
