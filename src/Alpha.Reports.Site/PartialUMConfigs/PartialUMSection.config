    <Add SettingKey="Age_Rpt_ProgressiveGamesContribution_Agent" />
    <Add SettingKey="Age_Rpt_ProgressiveGamesContribution_Member" />
  </Function>

  <Function Name="Statement">
    <!--Reports » Statement-->
    <Add SettingKey="Statement_Report_GetList" SpName="Acc_StatementSel" />
    <Add SettingKey="Statement_Report_GetList_14" SpName="Acc_StatementSel_14" />
    <Add SettingKey="Statement_Report_GetList_WH " SpName="Acc_StatementSel_Old" />
  </Function>

  <Function Name="Risk Analysis">
    <!--Risk Analysis » IP Matching-->
    <Add SettingKey="Age_BetStatistics_IPMatching_Master" />
    <!--Risk Analysis » Bet Choice Matching-->
    <Add SettingKey="Age_BetStatistics_BetMatching_Master" />
    <Add SettingKey="Age_Customer_Upline_Sel" />
  </Function>

  <Function Name="Group Bets &amp; Forecast OST">
    <!--Bets & Forecast » Soccer-->
    <Add SettingKey="Ost_NewTotalBetsForeCast_Main" />
    <Add SettingKey="Age_NewTotalBetsForeCast_LeagueSel" />
    <Add SettingKey="Age_NewTotalBetsForeCast_EventSel" />
    <!--Bets & Forecast » Handicap/Over Under/Live-->
    <!--Bets & Forecast » 1X2-->
    <Add SettingKey="Age_TotalBets_Sel1378_Master" SpName="Age_TotalBets_1378_Master" />
    <Add SettingKey="Age_TotalBets_Sel1378_Agent" SpName="Age_TotalBets_1378_Agent" />
    <Add SettingKey="Age_TotalBets_Sel1378_Member" SpName="Age_TotalBets_1378_Member" />
    <Add SettingKey="Age_LeagueSelRunning_SAg" />
    <Add SettingKey="Age_LeagueSelRunning_MAg" />
    <Add SettingKey="Age_LeagueSelRunning_Ag" />
  </Function>

  <Function Name="Group Bets &amp; Forecast BOF">
    <!--Bets & Forecast » Money Line-->
    <Add SettingKey="Age_TotalBets_Sel2021_SAg" />
    <Add SettingKey="Age_TotalBets_Sel2021_Mag" />
    <Add SettingKey="Age_TotalBets_Sel2021_Ag" />
    <!--Bets & Forecast » Odd/Even + 1X2 + DND-->
    <Add SettingKey="Age_TotalBets_Sel25_SAg" />
    <Add SettingKey="Age_TotalBets_Sel25_Mag" />
    <Add SettingKey="Age_TotalBets_Sel25_Ag" />
    <!--Bets & Forecast » FT & HT Total Goal-->
    <Add SettingKey="Age_TotalBets_Sel6_SAg" />
    <Add SettingKey="Age_TotalBets_Sel6_Mag" />
    <Add SettingKey="Age_TotalBets_Sel6_Ag" />
    <!--Bets & Forecast » Outright-->
    <Add SettingKey="Age_TotalBets_Sel10_SAg" />
    <Add SettingKey="Age_TotalBets_Sel10_Mag" />
    <Add SettingKey="Age_TotalBets_Sel10_Ag" />
    <!--Bets & Forecast » HT/FT-->
    <Add SettingKey="Age_TotalBets_Sel16_SAg" />
    <Add SettingKey="Age_TotalBets_Sel16_Mag" />
    <Add SettingKey="Age_TotalBets_Sel16_Ag" />
    <!--Bets & Forecast » FT & HT FG/LG-->
    <Add SettingKey="Age_TotalBets_Sel14_Sag" />
    <Add SettingKey="Age_TotalBets_Sel14_Mag" />
    <Add SettingKey="Age_TotalBets_Sel14_Ag" />
    <!--Bets & Forecast » Home/Draw/Away No Bet-->
    <Add SettingKey="Age_TotalBets_Sel121_SAg" />
    <Add SettingKey="Age_TotalBets_Sel121_Mag" />
    <Add SettingKey="Age_TotalBets_Sel121_Ag" />
    <!--Bets & Forecast » Number Game-->
