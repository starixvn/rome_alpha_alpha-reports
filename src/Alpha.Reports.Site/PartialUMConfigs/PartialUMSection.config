  <Function Name="Group Bet List Drilldown">
    <!--Report » Win Loss » Drilldown to bet list-->
    <!--Report » Win Loss Detail » Drilldown to bet list-->
    <!--Report » Consolidation » Drilldown to bet list-->
    <Add SettingKey="Age_BetList_SelWinLossByDate_Mem" />
    <Add SettingKey="Age_BetList_SelWinLossByDate_Mem_Old" />
    <!--Report » OutStanding » Drilldown to bet list-->
    <!--Account Info » Search Member » Bet List » Bet List (Running)-->
    <!--Account Info » Search Member » OutStanding » Bet List (Running)-->
    <!--Member Information » Credit/Balance » Outstanding (Member Only)-->
    <Add SettingKey="Age_BetList_SelRunningByDate_Mem" SpName="Age_BetList_SelRunning_Mem" />
    <!--Report » OutStanding » Drilldown To Bet List » Bet List (Running)-->
    <Add SettingKey="Age_BetList_SelWinlossParlay_SAg" />
    <Add SettingKey="Age_BetList_SelWinlossParlay_Mag" />
    <Add SettingKey="Age_BetList_SelWinlossParlay_Ag" />
    <Add SettingKey="Age_BetList_SelWinlossByBettypeMatch" />
    <Add SettingKey="Age_BetList_SelWinLossByBetType" />
    <Add SettingKey="Age_BetList_SelWinlossHR_Sag" />
    <Add SettingKey="Age_BetList_SelWinlossHR_Mag" />
    <Add SettingKey="Age_BetList_SelWinlossHR_Ag" />
    <Add SettingKey="Age_BetList_SelWinlossOutright_Ag" />
    <Add SettingKey="Age_BetList_SelWinlossOutright_MAg" />
    <Add SettingKey="Age_BetList_SelWinlossOutright_SAg" />
    <!--Account Info » Search Member » Bet List » Bet List-->
    <Add SettingKey="Age_BetList_SelAllByDate_Mem" />
    <!--Account Info » Search Member » Statement » Daily Statement » Win/Loss-->
    <!--Account Info » Search Member » Statement » Daily Statement » Outstanding-->
    <!--Account Info » Search Member » Statement » Daily Statement » Void/Rejected-->
    <Add SettingKey="Age_BetList_SelByDayAll_Mem" />
    <Add SettingKey="Age_BetList_SelByDayAll_Mem_WH" SpName="Age_BetList_SelByDayAll_Mem_Old" />
    <!--Risk Analysis » IP Matching » Drilldown Bet List-->
    <Add SettingKey="Age_BetList_IPMatching" />
    <!--Reports » Bet Credit Tracking » Move Statement History » Drilldown to bet list-->
    <Add SettingKey="Age_BetList_SelMovingEventByTransId" />
  </Function>

  <Function Name="Group Bet List">
    <!--Bet List » Cancelled Bets-->
    <Add SettingKey="Age_BetList_SelDeleted" />
    <!--Bet List » Correct Score-->
    <Add SettingKey="Age_TotalBets_Sel430_SAg" />
    <Add SettingKey="Age_TotalBets_Sel430_Mag" />
    <Add SettingKey="Age_TotalBets_Sel430_Ag" />
    <!--Bet List » Parlay-->
    <!--Bet List » Clean Sheet-->
    <!--Bet List » Double Chance-->
    <!--Bet List » Both/One/Neither Team To Score-->
    <!--Bet List » To Win To Nil-->
    <!--Bet List » 3-Way Handicap-->
    <Add SettingKey="Age_BetList_SelRunningByBettype_SAg" />
    <Add SettingKey="Age_BetList_SelRunningByBettype_Mag" />
    <Add SettingKey="Age_BetList_SelRunningByBettype_Ag" />
  </Function>

  <Function Name="Bet Credit Tracking">
    <!--Reports » Bet Credit Tracking-->
    <Add SettingKey="Age_Rpt_BetCreditHistory" />
    <Add SettingKey="Age_Rpt_StatementMovement" />
  </Function>
</PartialUMSection>