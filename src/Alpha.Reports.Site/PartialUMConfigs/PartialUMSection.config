    <Add SettingKey="Age_Rpt_WinLoss_Master" />
    <Add SettingKey="Age_Rpt_WinLoss_Agent" />
    <Add SettingKey="Age_Rpt_WinLoss_Member" />
    <!--Reports » Win Loss Detail-->
