<?xml version="1.0"?>
<PartialUMSection>
  <Function Name="Group Win Loss Reports">
    <!--Reports » Win Loss-->
    <!--Home page » Balance » Win Loss » Today Win Loss-->
    <!--Home page » Balance » Win Loss » Yesterday-->
