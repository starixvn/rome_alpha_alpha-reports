  <Function Name="Last Bets">
    <!--Bet List » Last Bets-->
    <Add SettingKey="Ost_LastBets_All" />
    <Add SettingKey="Ost_LastBets_HDP" />
    <Add SettingKey="Ost_LastBets_OU" />
    <Add SettingKey="Ost_LastBets_Other" />
